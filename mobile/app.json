{
  "expo": {
    "name": "Sanjeevani Triage",
    "slug": "sanjeevani-triage",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sanjeevani",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d9488"
    },
    "android": {
      "package": "com.sanjeevani.triage",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d9488"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.INTERNET",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_RESTING_HEART_RATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Sanjeevani Triage requires camera access to scan and decode doctor prescriptions safely."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sanjeevani Triage requires your location to route you to the nearest hospital and dispatch emergency SOS."
        }
      ],
      [
        "react-native-health-connect",
        {
          "rationaleActivity": ".MainActivity"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "64526434-5d03-41db-83a3-68cd3bc651b7"
      }
    },
    "owner": "mohandaskosanam"
  }
}
