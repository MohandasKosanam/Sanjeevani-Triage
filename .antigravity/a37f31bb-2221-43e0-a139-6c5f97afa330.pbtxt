    content: "{\n  \"name\": \"react-example\",\n  \"private\": true,\n  \"version\": \"0.0.0\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"vite --port=3000 --host=0.0.0.0\",\n    \"build\": \"vite build\",\n    \"preview\": \"vite preview\",\n    \"clean\": \"rm -rf dist server.js\",\n    \"lint\": \"tsc --noEmit\"\n  },\n  \"dependencies\": {\n    \"@google/genai\": \"^2.4.0\",\n    \"@tailwindcss/vite\": \"^4.3.3\",\n    \"@vitejs/plugin-react\": \"^6.1.1\",\n    \"lucide-react\": \"^0.546.0\",\n    \"react\": \"^19.0.1\",\n    \"react-dom\": \"^19.0.1\",\n    \"vite\": \"^8.3.0\",\n    \"express\": \"^4.21.2\",\n    \"dotenv\": \"^17.2.3\",\n    \"motion\": \"^12.23.24\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^22.14.0\",\n    \"@types/react\": \"^19.3.0\",\n    \"@types/react-dom\": \"^19.3.0\",\n    \"autoprefixer\": \"^10.4.21\",\n    \"esbuild\": \"^0.25.0\",\n    \"tailwindcss\": \"^4.3.3\",\n    \"tsx\": \"^4.21.0\",\n    \"typescript\": \"^7.0.2\",\n    \"@types/express\": \"^4.17.21\"\n  }\n}\n"
