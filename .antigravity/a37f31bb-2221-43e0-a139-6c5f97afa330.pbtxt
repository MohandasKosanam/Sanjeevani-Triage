  planner_response {
    thinking: "**Analyzing Button Strings**\n\nI\'m currently reviewing `src/components/mobile/SOSEmergencyButton.tsx` to identify hardcoded strings. I found \"Hold SOS\" and \"PRIORITY 0 EMERGENCY ACTIVATED\". They seem to be using translation keys now, specifically `t.holdSosBtn` and `t.priority`, which is a good sign.\n\n\n"
    tool_calls {
      id: "call_2606306583387177226"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false,\"Description\":\"Connect SOSEmergencyButton to useLanguage for translations\",\"EndLine\":320,\"Instruction\":\"Update SOSEmergencyButton with translations from useLanguage\",\"ReplacementContent\":\"import React, { useState, useRef, useEffect } from \'react\';\\nimport {\\n  AlertOctagon,\\n  Volume2,\\n  Mic,\\n  CheckCircle,\\n  Radio,\\n  PhoneCall,\\n  MapPin,\\n  X,\\n  ShieldAlert\\n} from \'lucide-react\';\\nimport { alertManager } from \'../../utils/audioAlert\';\\nimport { api } from \'../../services/api\';\\nimport { SOSEvent } from \'../../types\';\\nimport { useLanguage } from \'../../context/LanguageContext\';\\n\\ninterface Props {\\n  onSOSCreated?: (event: SOSEvent) => void;\\n}\\n\\ntype SOSState =\\n  | \'IDLE\'\\n  | \'HOLDING\'\\n  | \'SIREN\'\\n  | \'RECORDING\'\\n  | \'UPLOADING\'\\n  | \'DISPATCHED\'\\n  | \'FAILED\';\\n\\nexport const SOSEmergencyButton: React.FC<Props> = ({ onSOSCreated }) => {\\n  const { t } = useLanguage();\\n  const [state, setState] = useState<SOSState>(\'IDLE\');\\n  const [holdProgress, setHoldProgress] = useState(0); // 0 to 100\\n  const [sirenSecondsLeft, setSirenSecondsLeft] = useState(10);\\n  const [recordSecondsLeft, setRecordSecondsLeft] = useState(20);\\n  const [sosTicket, setSosTicket] = useState<{ id: string; status: string } | null>(null);\\n  const [activeOverlayOpen, setActiveOverlayOpen] = useState(false);\\n\\n  const holdTimerRef = useRef<any>(null);\\n  const holdStartRef = useRef<number>(0);\\n  const sirenIntervalRef = useRef<any>(null);\\n  const recordIntervalRef = useRef<any>(null);\\n  const stopSirenCallbackRef = useRef<(() => void) | null>(null);\\n  const mediaRecorderRef = useRef<MediaRecorder | null>(null);\\n\\n  const HOLD_DURATION_MS = 2500; // Exact 2.5 seconds hold requirement\\n\\n  const startHold = (e: React.SyntheticEvent) => {\\n    e.preventDefault();\\n    if (state !== \'IDLE\') return;\\n\\n    setState(\'HOLDING\');\\n    setHoldProgress(0);\\n    holdStartRef.current = Date.now();\\n\\n    holdTimerRef.current = setInterval(() => {\\n      const elapsed = Date.now() - holdStartRef.current;\\n      const progress = Math.min(100, (elapsed / HOLD_DURATION_MS) * 100);\\n      setHoldProgress(progress);\\n\\n      if (elapsed >= HOLD_DURATION_MS) {\\n        clearInterval(holdTimerRef.current);\\n        holdTimerRef.current = null;\\n        triggerSOSActivation();\\n      }\\n    }, 40);\\n  };\\n\\n  const cancelHold = () => {\\n    if (state === \'HOLDING\') {\\n      if (holdTimerRef.current) {\\n        clearInterval(holdTimerRef.current);\\n        holdTimerRef.current = null;\\n      }\\n      setState(\'IDLE\');\\n      setHoldProgress(0);\\n    }\\n  };\\n\\n  // SOS Activated at 2.5 seconds\\n  const triggerSOSActivation = async () => {\\n    alertManager.triggerHaptic([200, 100, 200, 100, 400]);\\n    setActiveOverlayOpen(true);\\n    setState(\'SIREN\');\\n    setSirenSecondsLeft(10);\\n\\n    let createdId = \'\';\\n    try {\\n      // 1. Immediately dispatch Priority 0 event to backend\\n      const res = await api.dispatchSOS(17.7124, 83.3156);\\n      createdId = res.sos_id;\\n      setSosTicket({ id: res.sos_id, status: res.status });\\n      if (onSOSCreated) {\\n        onSOSCreated({\\n          id: res.sos_id,\\n          patient_id: \'USR-PAT-001\',\\n          patient_name: \'Ramesh Varma\',\\n          patient_phone: \'+91 98480 22338\',\\n          latitude: 17.7124,\\n          longitude: 83.3156,\\n          priority: 0,\\n          status: \'received\',\\n          created_at: new Date().toISOString(),\\n        });\\n      }\\n    } catch (err) {\\n      console.error(\'Failed to dispatch SOS immediately:\', err);\\n    }\\n\\n    // 2. Play 10-second local siren\\n    stopSirenCallbackRef.current = alertManager.startSiren(10, () => {\\n      startAmbientRecording(createdId);\\n    });\\n\\n    sirenIntervalRef.current = setInterval(() => {\\n      setSirenSecondsLeft((prev) => {\\n        if (prev <= 1) {\\n          clearInterval(sirenIntervalRef.current);\\n          return 0;\\n        }\\n        return prev - 1;\\n      });\\n    }, 1000);\\n  };\\n\\n  // Start 20-second ambient recording after siren\\n  const startAmbientRecording = async (sosId: string) => {\\n    setState(\'RECORDING\');\\n    setRecordSecondsLeft(20);\\n\\n    let audioChunks: Blob[] = [];\\n    try {\\n      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });\\n      const rec = new MediaRecorder(stream);\\n      mediaRecorderRef.current = rec;\\n\\n      rec.ondataavailable = (e) => {\\n        if (e.data.size > 0) audioChunks.push(e.data);\\n      };\\n\\n      rec.onstop = async () => {\\n        stream.getTracks().forEach((t) => t.stop());\\n        const blob = new Blob(audioChunks, { type: \'audio/webm\' });\\n        if (sosId) {\\n          setState(\'UPLOADING\');\\n          try {\\n            await api.uploadSOSAudio(sosId, blob, 20);\\n          } catch (e) {\\n            console.error(\'Ambient audio upload error:\', e);\\n          }\\n        }\\n        setState(\'DISPATCHED\');\\n      };\\n\\n      rec.start();\\n    } catch (e) {\\n      console.warn(\'Microphone unavailable for ambient recording, continuing dispatch:\', e);\\n    }\\n\\n    recordIntervalRef.current = setInterval(() => {\\n      setRecordSecondsLeft((prev) => {\\n        if (prev <= 1) {\\n          clearInterval(recordIntervalRef.current);\\n          if (mediaRecorderRef.current && mediaRecorderRef.current.state === \'recording\') {\\n            mediaRecorderRef.current.stop();\\n          } else {\\n            setState(\'DISPATCHED\');\\n          }\\n          return 0;\\n        }\\n        return prev - 1;\\n      });\\n    }, 1000);\\n  };\\n\\n  const closeOverlay = () => {\\n    if (stopSirenCallbackRef.current) stopSirenCallbackRef.current();\\n    if (mediaRecorderRef.current && mediaRecorderRef.current.state === \'recording\') {\\n      try {\\n        mediaRecorderRef.current.stop();\\n      } catch (e) {}\\n    }\\n    setActiveOverlayOpen(false);\\n    setState(\'IDLE\');\\n    setHoldProgress(0);\\n  };\\n\\n  return (\\n    <>\\n      {/* Central Navigation SOS Button */}\\n      <div className=\\\"relative flex flex-col items-center justify-center\\\">\\n        {/* Hold progress ring SVG */}\\n        <div className=\\\"relative w-16 h-16 flex items-center justify-center\\\">\\n          <svg className=\\\"w-16 h-16 -rotate-90 pointer-events-none absolute inset-0\\\">\\n            <circle\\n              cx=\\\"32\\\"\\n              cy=\\\"32\\\"\\n              r=\\\"28\\\"\\n              stroke=\\\"#fee2e2\\\"\\n              strokeWidth=\\\"4\\\"\\n              fill=\\\"transparent\\\"\\n            />\\n            {holdProgress > 0 && (\\n              <circle\\n                cx=\\\"32\\\"\\n                cy=\\\"32\\\"\\n                r=\\\"28\\\"\\n                stroke=\\\"#dc2626\\\"\\n                strokeWidth=\\\"4\\\"\\n                fill=\\\"transparent\\\"\\n                strokeDasharray=\\\"175.9\\\"\\n                strokeDashoffset={175.9 - (175.9 * holdProgress) / 100}\\n                strokeLinecap=\\\"round\\\"\\n                className=\\\"transition-all duration-75\\\"\\n              />\\n            )}\\n          </svg>\\n\\n          <button\\n            onMouseDown={startHold}\\n            onMouseUp={cancelHold}\\n            onMouseLeave={cancelHold}\\n            onTouchStart={startHold}\\n            onTouchEnd={cancelHold}\\n            className={`w-13 h-13 rounded-full bg-gradient-to-tr from-rose-600 to-red-500 text-white flex items-center justify-center shadow-lg active:scale-95 transition select-none ${\\n              state === \'HOLDING\' ? \'scale-105 shadow-rose-500/50\' : \'hover:shadow-rose-400/40\'\\n            }`}\\n            title=\\\"Press and hold 2.5 seconds for Emergency SOS\\\"\\n          >\\n            <AlertOctagon className=\\\"w-7 h-7\\\" />\\n          </button>\\n        </div>\\n        <span className=\\\"text-[10px] font-bold text-rose-600 mt-0.5 tracking-wider uppercase\\\">\\n          {state === \'HOLDING\' ? `${Math.round(holdProgress)}%` : t.holdSosBtn}\\n        </span>\\n      </div>\\n\\n      {/* Fullscreen SOS Emergency Overlay Modal */}\\n      {activeOverlayOpen && (\\n        <div className=\\\"fixed inset-0 z-50 bg-black/85 backdrop-blur-md flex items-center justify-center p-4\\\">\\n          <div className=\\\"bg-slate-900 border border-rose-500/40 w-full max-w-sm rounded-3xl p-6 text-white text-center shadow-2xl relative overflow-hidden\\\">\\n            {/* Top Close / Dismiss button */}\\n            <button\\n              onClick={closeOverlay}\\n              className=\\\"absolute top-4 right-4 w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-slate-300 flex items-center justify-center transition\\\"\\n            >\\n              <X className=\\\"w-4 h-4\\\" />\\n            </button>\\n\\n            {/* Glowing SOS Header */}\\n            <div className=\\\"w-20 h-20 rounded-full bg-rose-600/20 border-2 border-rose-500 text-rose-500 mx-auto flex items-center justify-center mb-4 sos-active-pulse\\\">\\n              <ShieldAlert className=\\\"w-10 h-10\\\" />\\n            </div>\\n\\n            <div className=\\\"inline-block px-3 py-1 bg-rose-600 text-white font-extrabold text-[11px] rounded-full uppercase tracking-wider mb-2\\\">\\n              {t.priority0Activated}\\n            </div>\\n\\n            <h2 className=\\\"text-xl font-black text-white\\\">{t.emergencyDispatchLive}</h2>\\n            <p className=\\\"text-xs text-rose-200/80 mt-1\\\">\\n              {t.sosTicketLabel}: <span className=\\\"font-mono font-bold text-white\\\">{sosTicket?.id || \'SOS-001\'}</span>\\n            </p>\\n\\n            {/* Status Pipeline */}\\n            <div className=\\\"bg-slate-800/80 border border-slate-700 rounded-2xl p-4 my-5 text-left space-y-3\\\">\\n              {/* Stage 1: Priority 0 Dispatch */}\\n              <div className=\\\"flex items-center justify-between text-xs\\\">\\n                <span className=\\\"flex items-center gap-2 text-rose-400 font-semibold\\\">\\n                  <Radio className=\\\"w-4 h-4 animate-pulse\\\" /> {t.hospitalAlertStage}:\\n                </span>\\n                <span className=\\\"text-emerald-400 font-bold flex items-center gap-1 text-[11px]\\\">\\n                  <CheckCircle className=\\\"w-3.5 h-3.5\\\" /> Dispatched\\n                </span>\\n              </div>\\n\\n              {/* Stage 2: 10-Second Local Siren */}\\n              <div className=\\\"flex items-center justify-between text-xs border-t border-slate-700/60 pt-2\\\">\\n                <span className=\\\"flex items-center gap-2 text-slate-300 font-medium\\\">\\n                  <Volume2 className=\\\"w-4 h-4 text-amber-400\\\" /> {t.localSirenStage}:\\n                </span>\\n                <span className=\\\"font-mono text-xs font-bold text-amber-400\\\">\\n                  {state === \'SIREN\' ? `${sirenSecondsLeft}s Playing` : \'Completed\'}\\n                </span>\\n              </div>\\n\\n              {/* Stage 3: 20-Second Ambient Recording */}\\n              <div className=\\\"flex items-center justify-between text-xs border-t border-slate-700/60 pt-2\\\">\\n                <span className=\\\"flex items-center gap-2 text-slate-300 font-medium\\\">\\n                  <Mic className=\\\"w-4 h-4 text-indigo-400\\\" /> {t.ambientAudioStage}:\\n                </span>\\n                <span className=\\\"font-mono text-xs font-bold text-indigo-300\\\">\\n                  {state === \'RECORDING\'\\n                    ? `${recordSecondsLeft}s Recording`\\n                    : state === \'SIREN\'\\n                    ? \'Pending Siren\'\\n                    : \'Uploaded\'}\\n                </span>\\n              </div>\\n\\n              {/* GPS Coordinates */}\\n              <div className=\\\"flex items-center justify-between text-xs border-t border-slate-700/60 pt-2 text-slate-400\\\">\\n                <span className=\\\"flex items-center gap-1.5\\\">\\n                  <MapPin className=\\\"w-3.5 h-3.5 text-teal-400\\\" /> {t.gpsCoordinates}:\\n                </span>\\n                <span className=\\\"font-mono text-[11px] text-teal-300\\\">17.7124\302\260 N, 83.3156\302\260 E</span>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"text-[11px] text-slate-400 bg-slate-800/40 p-2.5 rounded-xl border border-slate-700/50 mb-4\\\">\\n              Your location and emergency ticket have been elevated to the top of the nearest tertiary emergency dashboard. Stay in a safe area.\\n            </div>\\n\\n            <button\\n              onClick={closeOverlay}\\n              className=\\\"w-full py-3 bg-slate-800 hover:bg-slate-700 text-white font-semibold text-xs rounded-xl transition border border-slate-700\\\"\\n            >\\n              {t.acknowledgeBtn}\\n            </button>\\n          </div>\\n        </div>\\n      )}\\n    </>\\n  );\\n};\\n\",\"StartLine\":1,\"TargetContent\":\"import React, { useState, useRef, useEffect } from \'react\';\\nimport {\\n  AlertOctagon,\\n  Volume2,\\n  Mic,\\n  CheckCircle,\\n  Radio,\\n  PhoneCall,\\n  MapPin,\\n  X,\\n  ShieldAlert\\n} from \'lucide-react\';\\nimport { alertManager } from \'../../utils/audioAlert\';\\nimport { api } from \'../../services/api\';\\nimport { SOSEvent } from \'../../types\';\\n\\ninterface Props {\\n  onSOSCreated?: (event: SOSEvent) => void;\\n}\\n\\ntype SOSState =\\n  | \'IDLE\'\\n  | \'HOLDING\'\\n  | \'SIREN\'\\n  | \'RECORDING\'\\n  | \'UPLOADING\'\\n  | \'DISPATCHED\'\\n  | \'FAILED\';\\n\\nexport const SOSEmergencyButton: React.FC<Props> = ({ onSOSCreated }) => {\\n  const [state, setState] = useState<SOSState>(\'IDLE\');\\n  const [holdProgress, setHoldProgress] = useState(0); // 0 to 100\\n  const [sirenSecondsLeft, setSirenSecondsLeft] = useState(10);\\n  const [recordSecondsLeft, setRecordSecondsLeft] = useState(20);\\n  const [sosTicket, setSosTicket] = useState<{ id: string; status: string } | null>(null);\\n  const [activeOverlayOpen, setActiveOverlayOpen] = useState(false);\\n\\n  const holdTimerRef = useRef<any>(null);\\n  const holdStartRef = useRef<number>(0);\\n  const sirenIntervalRef = useRef<any>(null);\\n  const recordIntervalRef = useRef<any>(null);\\n  const stopSirenCallbackRef = useRef<(() => void) | null>(null);\\n  const mediaRecorderRef = useRef<MediaRecorder | null>(null);\\n\\n  const HOLD_DURATION_MS = 2500; // Exact 2.5 seconds hold requirement\\n\\n  const startHold = (e: React.SyntheticEvent) => {\\n    e.preventDefault();\\n    if (state !== \'IDLE\') return;\\n\\n    setState(\'HOLDING\');\\n    setHoldProgress(0);\\n    holdStartRef.current = Date.now();\\n\\n    holdTimerRef.current = setInterval(() => {\\n      const elapsed = Date.now() - holdStartRef.current;\\n      const progress = Math.min(100, (elapsed / HOLD_DURATION_MS) * 100);\\n      setHoldProgress(progress);\\n\\n      if (elapsed >= HOLD_DURATION_MS) {\\n        clearInterval(holdTimerRef.current);\\n        holdTimerRef.current = null;\\n        triggerSOSActivation();\\n      }\\n    }, 40);\\n  };\\n\\n  const cancelHold = () => {\\n    if (state === \'HOLDING\') {\\n      if (holdTimerRef.current) {\\n        clearInterval(holdTimerRef.current);\\n        holdTimerRef.current = null;\\n      }\\n      setState(\'IDLE\');\\n      setHoldProgress(0);\\n    }\\n  };\\n\\n  // SOS Activated at 2.5 seconds\\n  const triggerSOSActivation = async () => {\\n    alertManager.triggerHaptic([200, 100, 200, 100, 400]);\\n    setActiveOverlayOpen(true);\\n    setState(\'SIREN\');\\n    setSirenSecondsLeft(10);\\n\\n    let createdId = \'\';\\n    try {\\n      // 1. Immediately dispatch Priority 0 event to backend\\n      const res = await api.dispatchSOS(17.7124, 83.3156);\\n      createdId = res.sos_id;\\n      setSosTicket({ id: res.sos_id, status: res.status });\\n      if (onSOSCreated) {\\n        onSOSCreated({\\n          id: res.sos_id,\\n          patient_id: \'USR-PAT-001\',\\n          patient_name: \'Ramesh Varma\',\\n          patient_phone: \'+91 98480 22338\',\\n          latitude: 17.7124,\\n          longitude: 83.3156,\\n          priority: 0,\\n          status: \'received\',\\n          created_at: new Date().toISOString(),\\n        });\\n      }\\n    } catch (err) {\\n      console.error(\'Failed to dispatch SOS immediately:\', err);\\n    }\\n\\n    // 2. Play 10-second local siren\\n    stopSirenCallbackRef.current = alertManager.startSiren(10, () => {\\n      startAmbientRecording(createdId);\\n    });\\n\\n    sirenIntervalRef.current = setInterval(() => {\\n      setSirenSecondsLeft((prev) => {\\n        if (prev <= 1) {\\n          clearInterval(sirenIntervalRef.current);\\n          return 0;\\n        }\\n        return prev - 1;\\n      });\\n    }, 1000);\\n  };\\n\\n  // Start 20-second ambient recording after siren\\n  const startAmbientRecording = async (sosId: string) => {\\n    setState(\'RECORDING\');\\n    setRecordSecondsLeft(20);\\n\\n    let audioChunks: Blob[] = [];\\n    try {\\n      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });\\n      const rec = new MediaRecorder(stream);\\n      mediaRecorderRef.current = rec;\\n\\n      rec.ondataavailable = (e) => {\\n        if (e.data.size > 0) audioChunks.push(e.data);\\n      };\\n\\n      rec.onstop = async () => {\\n        stream.getTracks().forEach((t) => t.stop());\\n        const blob = new Blob(audioChunks, { type: \'audio/webm\' });\\n        if (sosId) {\\n          setState(\'UPLOADING\');\\n          try {\\n            await api.uploadSOSAudio(sosId, blob, 20);\\n          } catch (e) {\\n            console.error(\'Ambient audio upload error:\', e);\\n          }\\n        }\\n        setState(\'DISPATCHED\');\\n      };\\n\\n      rec.start();\\n    } catch (e) {\\n      console.warn(\'Microphone unavailable for ambient recording, continuing dispatch:\', e);\\n    }\\n\\n    recordIntervalRef.current = setInterval(() => {\\n      setRecordSecondsLeft((prev) => {\\n        if (prev <= 1) {\\n          clearInterval(recordIntervalRef.current);\\n          if (mediaRecorderRef.current && mediaRecorderRef.current.state === \'recording\') {\\n            mediaRecorderRef.current.stop();\\n          } else {\\n            setState(\'DISPATCHED\');\\n          }\\n          return 0;\\n        }\\n        return prev - 1;\\n      });\\n    }, 1000);\\n  };\\n\\n  const closeOverlay = () => {\\n    if (stopSirenCallbackRef.current) stopSirenCallbackRef.current();\\n    if (mediaRecorderRef.current && mediaRecorderRef.current.state === \'recording\') {\\n      try {\\n        mediaRecorderRef.current.stop();\\n      } catch (e) {}\\n    }\\n    setActiveOverlayOpen(false);\\n    setState(\'IDLE\');\\n    setHoldProgress(0);\\n  };\\n\\n  return (\\n    <>\\n      {/* Central Navigation SOS Button */}\\n      <div className=\\\"relative flex flex-col items-center justify-center\\\">\\n        {/* Hold progress ring SVG */}\\n        <div className=\\\"relative w-16 h-16 flex items-center justify-center\\\">\\n          <svg className=\\\"w-16 h-16 -rotate-90 pointer-events-none absolute inset-0\\\">\\n            <circle\\n              cx=\\\"32\\\"\\n              cy=\\\"32\\\"\\n              r=\\\"28\\\"\\n              stroke=\\\"#fee2e2\\\"\\n              strokeWidth=\\\"4\\\"\\n              fill=\\\"transparent\\\"\\n            />\\n            {holdProgress > 0 && (\\n              <circle\\n                cx=\\\"32\\\"\\n                cy=\\\"32\\\"\\n                r=\\\"28\\\"\\n                stroke=\\\"#dc2626\\\"\\n                strokeWidth=\\\"4\\\"\\n                fill=\\\"transparent\\\"\\n                strokeDasharray=\\\"175.9\\\"\\n                strokeDashoffset={175.9 - (175.9 * holdProgress) / 100}\\n                strokeLinecap=\\\"round\\\"\\n                className=\\\"transition-all duration-75\\\"\\n              />\\n            )}\\n          </svg>\\n\\n          <button\\n            onMouseDown={startHold}\\n            onMouseUp={cancelHold}\\n            onMouseLeave={cancelHold}\\n            onTouchStart={startHold}\\n            onTouchEnd={cancelHold}\\n            className={`w-13 h-13 rounded-full bg-gradient-to-tr from-rose-600 to-red-500 text-white flex items-center justify-center shadow-lg active:scale-95 transition select-none ${\\n              state === \'HOLDING\' ? \'scale-105 shadow-rose-500/50\' : \'hover:shadow-rose-400/40\'\\n            }`}\\n            title=\\\"Press and hold 2.5 seconds for Emergency SOS\\\"\\n          >\\n            <AlertOctagon className=\\\"w-7 h-7\\\" />\\n          </button>\\n        </div>\\n        <span className=\\\"text-[10px] font-bold text-rose-600 mt-0.5 tracking-wider uppercase\\\">\\n          {state === \'HOLDING\' ? `${Math.round(holdProgress)}%` : \'Hold SOS\'}\\n        </span>\\n      </div>\\n\\n      {/* Fullscreen SOS Emergency Overlay Modal */}\\n      {activeOverlayOpen && (\\n        <div className=\\\"fixed inset-0 z-50 bg-black/85 backdrop-blur-md flex items-center justify-center p-4\\\">\\n          <div className=\\\"bg-slate-900 border border-rose-500/40 w-full max-w-sm rounded-3xl p-6 text-white text-center shadow-2xl relative overflow-hidden\\\">\\n            {/* Top Close / Dismiss button */}\\n            <button\\n              onClick={closeOverlay}\\n              className=\\\"absolute top-4 right-4 w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-slate-300 flex items-center justify-center transition\\\"\\n            >\\n              <X className=\\\"w-4 h-4\\\" />\\n            </button>\\n\\n            {/* Glowing SOS Header */}\\n            <div className=\\\"w-20 h-20 rounded-full bg-rose-600/20 border-2 border-rose-500 text-rose-500 mx-auto flex items-center justify-center mb-4 sos-active-pulse\\\">\\n              <ShieldAlert className=\\\"w-10 h-10\\\" />\\n            </div>\\n\\n            <div className=\\\"inline-block px-3 py-1 bg-rose-600 text-white font-extrabold text-[11px] rounded-full uppercase tracking-wider mb-2\\\">\\n              PRIORITY 0 EMERGENCY ACTIVATED\\n            </div>\\n\\n            <h2 className=\\\"text-xl font-black text-white\\\">Emergency Dispatch Live</h2>\\n            <p className=\\\"text-xs text-rose-200/80 mt-1\\\">\\n              Ticket: <span className=\\\"font-mono font-bold text-white\\\">{sosTicket?.id || \'SOS-001\'}</span>\\n            </p>\\n\\n            {/* Status Pipeline */}\\n            <div className=\\\"bg-slate-800/80 border border-slate-700 rounded-2xl p-4 my-5 text-left space-y-3\\\">\\n              {/* Stage 1: Priority 0 Dispatch */}\\n              <div className=\\\"flex items-center justify-between text-xs\\\">\\n                <span className=\\\"flex items-center gap-2 text-rose-400 font-semibold\\\">\\n                  <Radio className=\\\"w-4 h-4 animate-pulse\\\" /> Hospital Dashboard Alert:\\n                </span>\\n                <span className=\\\"text-emerald-400 font-bold flex items-center gap-1 text-[11px]\\\">\\n                  <CheckCircle className=\\\"w-3.5 h-3.5\\\" /> Dispatched\\n                </span>\\n              </div>\\n\\n              {/* Stage 2: 10-Second Local Siren */}\\n              <div className=\\\"flex items-center justify-between text-xs border-t border-slate-700/60 pt-2\\\">\\n                <span className=\\\"flex items-center gap-2 text-slate-300 font-medium\\\">\\n                  <Volume2 className=\\\"w-4 h-4 text-amber-400\\\" /> Local Audio Siren (10s):\\n                </span>\\n                <span className=\\\"font-mono text-xs font-bold text-amber-400\\\">\\n                  {state === \'SIREN\' ? `${sirenSecondsLeft}s Playing` : \'Completed\'}\\n                </span>\\n              </div>\\n\\n              {/* Stage 3: 20-Second Ambient Recording */}\\n              <div className=\\\"flex items-center justify-between text-xs border-t border-slate-700/60 pt-2\\\">\\n                <span className=\\\"flex items-center gap-2 text-slate-300 font-medium\\\">\\n                  <Mic className=\\\"w-4 h-4 text-indigo-400\\\" /> Ambient Audio (20s):\\n                </span>\\n                <span className=\\\"font-mono text-xs font-bold text-indigo-300\\\">\\n                  {state === \'RECORDING\'\\n                    ? `${recordSecondsLeft}s Recording`\\n                    : state === \'SIREN\'\\n                    ? \'Pending Siren\'\\n                    : \'Uploaded\'}\\n                </span>\\n              </div>\\n\\n              {/* GPS Coordinates */}\\n              <div className=\\\"flex items-center justify-between text-xs border-t border-slate-700/60 pt-2 text-slate-400\\\">\\n                <span className=\\\"flex items-center gap-1.5\\\">\\n                  <MapPin className=\\\"w-3.5 h-3.5 text-teal-400\\\" /> GPS Lat/Lng:\\n                </span>\\n                <span className=\\\"font-mono text-[11px] text-teal-300\\\">17.7124\302\260 N, 83.3156\302\260 E</span>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"text-[11px] text-slate-400 bg-slate-800/40 p-2.5 rounded-xl border border-slate-700/50 mb-4\\\">\\n              Your location and emergency ticket have been elevated to the top of the nearest tertiary emergency dashboard. Stay in a safe area.\\n            </div>\\n\\n            <button\\n              onClick={closeOverlay}\\n              className=\\\"w-full py-3 bg-slate-800 hover:bg-slate-700 text-white font-semibold text-xs rounded-xl transition border border-slate-700\\\"\\n            >\\n              Acknowledge & Keep Monitoring\\n            </button>\\n          </div>\\n        </div>\\n      )}\\n    </>\\n  );\\n};\\n\",\"TargetFile\":\"/src/components/mobile/SOSEmergencyButton.tsx\",\"toolAction\":\"Updating SOSEmergencyButton\",\"toolSummary\":\"Update SOSEmergencyButton with translations\"}"
      thinking_signature: "\022\200\a\n\375\006\001i\024}\023\206A\241\337\350\002\317l_\216[\240\340\341\350\214\343\031\250\211\214\317oS\344k\024/\340\205FV\274\360\262\f\211\362\363d\276\301+\3119\365h\374\177)\035F\017+\353\362\305\341\273\2457\326\355\334V\vI\017\235\240\275,\031)\314\260\034#\372\205\335u\262\272\225\023\221\270?gh\023\300\021!w\341\366^\222\324\302\222\220e8\232|\nHh\267;L9^\001hT\210h\303#\335\350\247\354\0369\276\377\376\"y\375iz\357\353\n%\335ptC\3550]\202\236\357\336\347\276!!\3079\300\344\217\352?\277\006\345\342\2004\257\370\272\325\2530+!\352\335)k\377\374t:\201l\350\035\330im\177_t0FO1\361\326!\276\361y\033Zf\237w.\313;\025N\242o\322S{W}>C\364\336\302\327\t\304\212\326W\260\b\375\2342\331\227\0350\002\023\371,\021\220\177\030\224VIs\257\004\250[\375\206\333\206\207}\026\363\275\016\246\321\"GZ\b\270d\262\206\260]\265\323T\277\024\a~,l\035\212\216\375@\234\373\264\211\0258\257-C\262\315t\371\016\262\216i\347%\005\212\206\232o\235O\025\314\374\346R\373F)Iq\036;\315k,\234\277\331|x\376\262\2016O\223|\vO\312\3651\215\253\346\377s3t=\236?\361+\004\215\3447\211\367_\025\271\271\216\243\aF\240\332\006\003g\303\205\344\304\027\277\350\243.\322\335\231U@\235\036\260I[\320\302I0\341\361\310O\216`Y7\022]\335\376\240\204\025P\203f\023\277\3211\363PP\034 \201?\353 \362b\227}F4&)Z\276+\222\313\314\315}\0207\304\316\262\272\341\311i\311\bR\3176\211\026\\\201\177\201\221\347\356\252\215\366\2262\036\000\354^\025\375\327g\"\3548ThSD\377I\024\037a_\f\0364.\332d\274$\360}|3\356\315\260A0\272\r\251\320Q\312L\303\232t\276\240\372H\351\343\330\321\ak\304[b]\tm\214\217\2100\225\304\357\330\331\321G\211\375\211cp,\b\276U\254\240\031\004\266bd`\\\333S\375m\323\261\264b\311\t5E\221m\215\363\003\303.\233\023f\223_\226\304K\003:%tI\377\376\"\363!\341e-\021\243\265\344\362\331\331\254\265\362\020\323\272\264\246`\224\2122P6\245\333\276\345M#\212\231Z\345\f\330\3606\320\031\357\215\fLK1\335t+\307\270T\365\325\334]q\223B\254a\364F\005\323\364\017\361\275f\2407\271#f\204\b\224\271\333\264\253?_\211>O\301\fB\356E\355\005\246\243\257\3743\017\242#\262\321#}s\035\343\356\246\025\332c-\246\253H%\223(o\030m/\336^%b\255\263\346\266\314\000\201A\374\350\337\302\000?\261\374\035\004\335\035xQ\362\265\375\246\270\322JY\373n\213\201Qk\312_\a=rz[f\324p\234\017\221\247\034\233\346\367\235\243\355\262\vjm9%\305\177a}\260\033S\225K\220\202[K\036(\222\341^\357\264\215\341B\304\306\002\230.W+\273A\201\345w\225H6\312\027\201;\225\326\324\'\202\177\003R_\363\247\177\024\274\334+\243{\b\331(z\233\336\326j\035k\01739\327p2O\v\300V\024G}\031+"
