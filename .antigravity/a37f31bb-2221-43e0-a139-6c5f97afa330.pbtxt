  planner_response {
    thinking: "**Analyzing MobileAppView.tsx**\n\nI\'m currently focusing on `MobileAppView.tsx`. I\'ve started examining how `useLanguage()` is implemented within this component, specifically how it integrates with `profile.preferred_language`. The objective is to ensure language settings are synchronized. I\'m noting the use of `t` for translation as well.\n\n\n**Integrating Chat Feature**\n\nI\'m now thinking about integrating a dedicated \'chat\' tab into the navigation bar for a more native AI Health Chat experience. The idea is to have an embedded chat view within the mobile app, providing full conversation history and instant typing. The goal is to make it feel completely integrated. This \'chat\' tab will sit alongside \'home,\' \'sos,\' \'records,\' \'tokens,\' and \'profile\' tabs.\n\n\n**Refining Component Structure**\n\nI\'m now focused on the component structure, specifically `MobileAppView.tsx`. My current focus is to refine the tab structure. I\'m going to integrate a \'chat\' tab in the navigation bar alongside existing tabs. I plan to use the `t.*` translations everywhere. I\'m replacing all hardcoded strings with calls to translation functions. Also, I\'m integrating the profile navigation through the header avatar.\n\n\n"
    tool_calls {
      id: "call_7337017212512658587"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false,\"Description\":\"Update MobileAppView to use useLanguage and embed Chat as a native mobile tab with session history\",\"EndLine\":425,\"Instruction\":\"Update MobileAppView with useLanguage, translated strings, and dedicated Chat tab and history\",\"ReplacementContent\":\"import React, { useState, useEffect } from \'react\';\\nimport {\\n  Home,\\n  FileText,\\n  Ticket,\\n  User,\\n  Mic,\\n  Camera,\\n  MapPin,\\n  ChevronRight,\\n  Globe,\\n  Phone,\\n  Sparkles,\\n  HeartPulse,\\n  ArrowRight,\\n  Radio,\\n  MessageSquare,\\n  Bot,\\n  Send,\\n  Plus,\\n  History,\\n  Trash2,\\n  Brain,\\n  Zap\\n} from \'lucide-react\';\\nimport { DailyHealthInsightCard } from \'./DailyHealthInsightCard\';\\nimport { VoiceTriageSheet } from \'./VoiceTriageSheet\';\\nimport { PrescriptionScannerSheet } from \'./PrescriptionScannerSheet\';\\nimport { GeminiLiveVoiceModal } from \'../live/GeminiLiveVoiceModal\';\\nimport { GeminiChatbotModal } from \'../chat/GeminiChatbotModal\';\\nimport { SOSEmergencyButton } from \'./SOSEmergencyButton\';\\nimport { OPDTokensList } from \'./OPDTokensList\';\\nimport { HealthRecordsView } from \'./HealthRecordsView\';\\nimport { api } from \'../../services/api\';\\nimport { UserProfile, OPDToken, DailyHealthInsight, Language } from \'../../types\';\\nimport { useLanguage } from \'../../context/LanguageContext\';\\nimport { chatStorage, ChatSession, ChatMessage } from \'../../services/chatStorage\';\\n\\ninterface Props {\\n  onSOSCreated?: () => void;\\n  onTriageCreated?: () => void;\\n}\\n\\nexport const MobileAppView: React.FC<Props> = ({ onSOSCreated, onTriageCreated }) => {\\n  const { language, setLanguage, t } = useLanguage();\\n  const [activeTab, setActiveTab] = useState<\'home\' | \'chat\' | \'records\' | \'tokens\' | \'profile\'>(\'home\');\\n  const [profile, setProfile] = useState<UserProfile | null>(null);\\n  const [healthInsight, setHealthInsight] = useState<DailyHealthInsight | null>(null);\\n  const [tokens, setTokens] = useState<OPDToken[]>([]);\\n  const [voiceSheetOpen, setVoiceSheetOpen] = useState(false);\\n  const [rxSheetOpen, setRxSheetOpen] = useState(false);\\n  const [liveVoiceOpen, setLiveVoiceOpen] = useState(false);\\n  const [chatModalOpen, setChatModalOpen] = useState(false);\\n\\n  // Embedded In-App Chat State for seamless native experience\\n  const [chatSessions, setChatSessions] = useState<ChatSession[]>([]);\\n  const [currentSessionId, setCurrentSessionId] = useState<string>(\'\');\\n  const [chatMessages, setChatMessages] = useState<ChatMessage[]>([]);\\n  const [chatInput, setChatInput] = useState(\'\');\\n  const [isChatLoading, setIsChatLoading] = useState(false);\\n  const [chatModel, setChatModel] = useState<\'gemini-3.1-flash-lite\' | \'gemini-3.8-flash\' | \'gemini-4-argon\'>(\'gemini-3.8-flash\');\\n  const [showHistoryDropdown, setShowHistoryDropdown] = useState(false);\\n\\n  useEffect(() => {\\n    loadInitialData();\\n    loadChatSessions();\\n  }, []);\\n\\n  const loadInitialData = async () => {\\n    try {\\n      const [u, h, tok] = await Promise.all([\\n        api.getProfile(),\\n        api.getHealthInsights(),\\n        api.getTokens(),\\n      ]);\\n      setProfile(u);\\n      setHealthInsight(h);\\n      setTokens(tok);\\n    } catch (e) {\\n      console.error(\'Error loading mobile data:\', e);\\n    }\\n  };\\n\\n  const loadChatSessions = async () => {\\n    const list = await chatStorage.getSessions();\\n    setChatSessions(list);\\n    if (list.length > 0) {\\n      setCurrentSessionId(list[0].id);\\n      setChatMessages(list[0].messages);\\n      setChatModel(list[0].model);\\n    } else {\\n      initNewChatSession();\\n    }\\n  };\\n\\n  const initNewChatSession = () => {\\n    const newId = `session-${Date.now()}`;\\n    const initialWelcome: ChatMessage = {\\n      id: `welcome-${Date.now()}`,\\n      sender: \'assistant\',\\n      content:\\n        language === \'te\'\\n          ? \'\340\260\250\340\260\256\340\260\270\340\261\215\340\260\244\340\261\207! \340\260\250\340\261\207\340\260\250\340\261\201 \340\260\270\340\260\202\340\260\234\340\261\200\340\260\265\340\260\250\340\260\277 AI \340\260\271\340\261\206\340\260\262\340\261\215\340\260\244\340\261\215 \340\260\205\340\260\270\340\260\277\340\260\270\340\261\215\340\260\237\340\261\206\340\260\202\340\260\237\340\261\215\342\200\214\340\260\250\340\260\277. \340\260\256\340\261\200 \340\260\262\340\260\225\340\261\215\340\260\267\340\260\243\340\260\276\340\260\262\340\261\201, \340\260\256\340\260\202\340\260\246\340\261\201\340\260\262\340\261\201 \340\260\262\340\261\207\340\260\246\340\260\276 \340\260\206\340\260\270\340\261\201\340\260\252\340\260\244\340\261\215\340\260\260\340\260\277 \340\260\256\340\260\276\340\260\260\340\261\215\340\260\227\340\260\246\340\260\260\340\261\215\340\260\266\340\260\225\340\260\276\340\260\262 \340\260\227\340\261\201\340\260\260\340\260\277\340\260\202\340\260\232\340\260\277 \340\260\250\340\260\250\340\261\215\340\260\250\340\261\201 \340\260\205\340\260\241\340\260\227\340\260\202\340\260\241\340\260\277.\'\\n          : language === \'hi\'\\n          ? \'\340\244\250\340\244\256\340\244\270\340\245\215\340\244\244\340\245\207! \340\244\256\340\245\210\340\244\202 \340\244\270\340\244\202\340\244\234\340\245\200\340\244\265\340\244\250\340\245\200 AI \340\244\271\340\245\207\340\244\262\340\245\215\340\244\245 \340\244\205\340\244\270\340\244\277\340\244\270\340\245\215\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\271\340\245\202\340\244\201\340\245\244 \340\244\205\340\244\252\340\244\250\340\245\207 \340\244\262\340\244\225\340\245\215\340\244\267\340\244\243, \340\244\246\340\244\265\340\244\276\340\244\207\340\244\257\340\245\213\340\244\202 \340\244\257\340\244\276 \340\244\205\340\244\270\340\245\215\340\244\252\340\244\244\340\244\276\340\244\262 \340\244\270\340\245\207 \340\244\270\340\244\202\340\244\254\340\244\202\340\244\247\340\244\277\340\244\244 \340\244\252\340\245\215\340\244\260\340\244\266\340\245\215\340\244\250 \340\244\252\340\245\202\340\244\233\340\245\207\340\244\202\340\245\244\'\\n          : \'Namaste! I am Sanjeevani AI Healthcare Assistant. Ask me about symptoms, medicines, or hospital OPD triage.\',\\n      modelUsed: chatModel,\\n      timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\\n    };\\n\\n    const newSession: ChatSession = {\\n      id: newId,\\n      title: language === \'te\' ? \'\340\260\225\340\261\212\340\260\244\340\261\215\340\260\244 \340\260\270\340\260\202\340\260\255\340\260\276\340\260\267\340\260\243\' : language === \'hi\' ? \'\340\244\250\340\244\257\340\244\276 \340\244\270\340\244\202\340\244\265\340\244\276\340\244\246\' : \'New Health Chat\',\\n      model: chatModel,\\n      role: \'general\',\\n      messages: [initialWelcome],\\n      createdAt: new Date().toISOString(),\\n      updatedAt: new Date().toISOString(),\\n    };\\n\\n    setCurrentSessionId(newId);\\n    setChatMessages([initialWelcome]);\\n    setChatSessions((prev) => [newSession, ...prev]);\\n    setShowHistoryDropdown(false);\\n    chatStorage.saveSession(newSession);\\n  };\\n\\n  const handleSelectSession = (sess: ChatSession) => {\\n    setCurrentSessionId(sess.id);\\n    setChatMessages(sess.messages);\\n    setChatModel(sess.model);\\n    setShowHistoryDropdown(false);\\n  };\\n\\n  const handleDeleteSession = async (sessId: string, e: React.MouseEvent) => {\\n    e.stopPropagation();\\n    await chatStorage.deleteSession(sessId);\\n    const updated = chatSessions.filter((s) => s.id !== sessId);\\n    setChatSessions(updated);\\n    if (currentSessionId === sessId) {\\n      if (updated.length > 0) {\\n        handleSelectSession(updated[0]);\\n      } else {\\n        initNewChatSession();\\n      }\\n    }\\n  };\\n\\n  const handleSendChatMessage = async (e?: React.FormEvent) => {\\n    if (e) e.preventDefault();\\n    if (!chatInput.trim() || isChatLoading) return;\\n\\n    const userText = chatInput.trim();\\n    setChatInput(\'\');\\n\\n    const userMsg: ChatMessage = {\\n      id: `msg-${Date.now()}`,\\n      sender: \'user\',\\n      content: userText,\\n      timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\\n    };\\n\\n    const updated = [...chatMessages, userMsg];\\n    setChatMessages(updated);\\n    setIsChatLoading(true);\\n\\n    try {\\n      const history = updated.map((m) => ({\\n        role: m.sender === \'user\' ? (\'user\' as const) : (\'model\' as const),\\n        content: m.content,\\n      }));\\n\\n      const res = await fetch(\'/api/v1/chat\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({\\n          messages: history,\\n          model: chatModel,\\n          role: \'general\',\\n        }),\\n      });\\n\\n      const data = await res.json();\\n      const botText = data.success ? data.reply : \'Could not process query.\';\\n      const usedModel = data.modelUsed || chatModel;\\n\\n      const botMsg: ChatMessage = {\\n        id: `msg-${Date.now()}-ai`,\\n        sender: \'assistant\',\\n        content: botText,\\n        modelUsed: usedModel,\\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\\n      };\\n\\n      const finalMessages = [...updated, botMsg];\\n      setChatMessages(finalMessages);\\n\\n      const active = chatSessions.find((s) => s.id === currentSessionId);\\n      const title =\\n        active?.title && !active.title.includes(\'New\') && !active.title.includes(\'\340\260\225\340\261\212\340\260\244\340\261\215\340\260\244\')\\n          ? active.title\\n          : userText.slice(0, 28);\\n\\n      const saved: ChatSession = {\\n        id: currentSessionId,\\n        title,\\n        model: chatModel,\\n        role: \'general\',\\n        messages: finalMessages,\\n        createdAt: active?.createdAt || new Date().toISOString(),\\n        updatedAt: new Date().toISOString(),\\n      };\\n\\n      setChatSessions((prev) =>\\n        prev.map((s) => (s.id === currentSessionId ? saved : s))\\n      );\\n      chatStorage.saveSession(saved);\\n    } catch (err) {\\n      console.error(\'In-app chat error:\', err);\\n    } finally {\\n      setIsChatLoading(false);\\n    }\\n  };\\n\\n  const handleLanguageChange = (lang: Language) => {\\n    setLanguage(lang);\\n  };\\n\\n  const handleTokenGenerated = (newToken: OPDToken) => {\\n    setTokens((prev) => [newToken, ...prev]);\\n    if (onTriageCreated) onTriageCreated();\\n  };\\n\\n  const handleSOSDispatched = () => {\\n    if (onSOSCreated) onSOSCreated();\\n  };\\n\\n  return (\\n    <div className=\\\"w-full flex justify-center py-2 sm:py-6\\\">\\n      {/* Mobile Frame Container */}\\n      <div className=\\\"w-full max-w-[390px] h-[810px] bg-white rounded-[40px] shadow-2xl border-8 border-slate-900 flex flex-col overflow-hidden relative select-none\\\">\\n        {/* Device Top Status Bar */}\\n        <div className=\\\"bg-white pt-2.5 px-6 pb-2 flex items-center justify-between text-[11px] font-semibold text-slate-800 shrink-0 z-20 border-b border-slate-100\\\">\\n          <span>9:41</span>\\n          {/* Dynamic Island / Speaker notch */}\\n          <div className=\\\"w-20 h-4 bg-slate-900 rounded-full\\\" />\\n          <div className=\\\"flex items-center gap-1.5 text-slate-700\\\">\\n            <span className=\\\"text-[10px]\\\">5G</span>\\n            <div className=\\\"w-5 h-2.5 border border-slate-700 rounded-xs p-0.5 flex items-center\\\">\\n              <div className=\\\"w-full h-full bg-slate-800 rounded-xs\\\" />\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* App Top Bar */}\\n        <div className=\\\"bg-white px-4 py-2.5 flex items-center justify-between border-b border-slate-100 shrink-0 z-10\\\">\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <div className=\\\"w-8 h-8 rounded-xl bg-teal-600 text-white flex items-center justify-center font-black text-sm shadow-xs\\\">\\n              \340\244\270\340\244\202\\n            </div>\\n            <div>\\n              <div className=\\\"text-xs font-extrabold text-slate-900 tracking-tight flex items-center gap-1\\\">\\n                {t.appTitle} <span className=\\\"text-[9px] bg-teal-100 text-teal-800 font-bold px-1.5 py-0.2 rounded\\\">OPD</span>\\n              </div>\\n              <div className=\\\"text-[10px] text-slate-400 flex items-center gap-1\\\">\\n                <MapPin className=\\\"w-2.5 h-2.5 text-teal-600\\\" /> {t.medicalHubLocation}\\n              </div>\\n            </div>\\n          </div>\\n\\n          {/* Language Switcher */}\\n          <div className=\\\"flex bg-slate-100 p-0.5 rounded-lg border border-slate-200\\\">\\n            {([\'te\', \'hi\', \'en\'] as Language[]).map((lang) => (\\n              <button\\n                key={lang}\\n                onClick={() => handleLanguageChange(lang)}\\n                className={`px-2 py-0.5 text-[10px] font-bold rounded-md uppercase transition ${\\n                  language === lang\\n                    ? \'bg-teal-600 text-white shadow-xs\'\\n                    : \'text-slate-600 hover:text-slate-900\'\\n                }`}\\n              >\\n                {lang === \'te\' ? \'\340\260\244\340\261\206\340\260\262\340\261\201\340\260\227\340\261\201\' : lang === \'hi\' ? \'\340\244\271\340\244\277\340\244\202\340\244\246\340\245\200\' : \'EN\'}\\n              </button>\\n            ))}\\n          </div>\\n        </div>\\n\\n        {/* Scrollable Main Screen Content */}\\n        <div className=\\\"flex-1 overflow-y-auto px-4 py-3 space-y-3.5\\\">\\n          {/* HOME TAB */}\\n          {activeTab === \'home\' && (\\n            <>\\n              {/* Patient Greeting */}\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <div>\\n                  <h1 className=\\\"text-base font-extrabold text-slate-900\\\">\\n                    {t.greeting(profile?.name || (language === \'te\' ? \'\340\260\260\340\260\256\340\261\207\340\260\267\340\261\215 \340\260\265\340\260\260\340\261\215\340\260\256\' : language === \'hi\' ? \'\340\244\260\340\244\256\340\245\207\340\244\266 \340\244\265\340\244\260\340\245\215\340\244\256\340\244\276\' : \'Ramesh Varma\'))}\\n                  </h1>\\n                  <p className=\\\"text-[11px] text-slate-500\\\">{t.greetingSubtitle}</p>\\n                </div>\\n                <button\\n                  onClick={() => setActiveTab(\'profile\')}\\n                  className=\\\"w-9 h-9 rounded-full bg-teal-100 border border-teal-300 text-teal-800 flex items-center justify-center font-bold text-xs shadow-xs hover:bg-teal-200 transition\\\"\\n                  title=\\\"View Profile\\\"\\n                >\\n                  {profile?.name ? profile.name.charAt(0) : \'R\'}\\n                </button>\\n              </div>\\n\\n              {/* Daily Health Insight Card */}\\n              <DailyHealthInsightCard insight={healthInsight} />\\n\\n              {/* PRIMARY ZERO-UI HERO CTA: Speak Symptoms */}\\n              <div\\n                onClick={() => setVoiceSheetOpen(true)}\\n                className=\\\"relative bg-gradient-to-br from-teal-600 to-teal-800 text-white rounded-3xl p-4 sm:p-5 shadow-lg shadow-teal-700/20 cursor-pointer hover:shadow-teal-700/30 transition group overflow-hidden\\\"\\n              >\\n                <div className=\\\"absolute -right-6 -bottom-6 w-32 h-32 bg-white/10 rounded-full blur-xl group-hover:scale-110 transition duration-500\\\" />\\n\\n                <div className=\\\"flex items-center justify-between mb-2.5\\\">\\n                  <div className=\\\"w-11 h-11 rounded-2xl bg-white/20 backdrop-blur-md flex items-center justify-center text-white shadow-inner\\\">\\n                    <Mic className=\\\"w-5 h-5 animate-pulse\\\" />\\n                  </div>\\n                  <span className=\\\"text-[9px] font-bold uppercase tracking-wider bg-white/20 text-teal-50 px-2 py-0.5 rounded-full backdrop-blur-xs\\\">\\n                    Multimodal AI\\n                  </span>\\n                </div>\\n\\n                <div className=\\\"text-sm font-black tracking-tight\\\">\\n                  {t.speakSymptomsTitle}\\n                </div>\\n                <p className=\\\"text-[11px] text-teal-100 mt-1 leading-relaxed\\\">\\n                  {t.speakSymptomsDesc}\\n                </p>\\n\\n                <div className=\\\"mt-3 pt-2.5 border-t border-teal-500/40 flex items-center justify-between text-xs font-semibold text-teal-100 group-hover:text-white\\\">\\n                  <span>{t.holdToSpeak}</span>\\n                  <ArrowRight className=\\\"w-4 h-4 group-hover:translate-x-1 transition\\\" />\\n                </div>\\n              </div>\\n\\n              {/* SECONDARY ACTION: Smart Rx Decoder */}\\n              <div\\n                onClick={() => setRxSheetOpen(true)}\\n                className=\\\"bg-slate-50 border border-slate-200 hover:border-teal-400 rounded-3xl p-3.5 cursor-pointer transition shadow-xs flex items-center justify-between group\\\"\\n              >\\n                <div className=\\\"flex items-center gap-3\\\">\\n                  <div className=\\\"w-10 h-10 rounded-2xl bg-teal-500/10 text-teal-600 flex items-center justify-center shrink-0\\\">\\n                    <Camera className=\\\"w-5 h-5\\\" />\\n                  </div>\\n                  <div>\\n                    <div className=\\\"text-xs font-bold text-slate-900 group-hover:text-teal-700\\\">\\n                      {t.smartRxTitle}\\n                    </div>\\n                    <div className=\\\"text-[10px] text-slate-500 mt-0.5\\\">\\n                      {t.smartRxDesc}\\n                    </div>\\n                  </div>\\n                </div>\\n                <ChevronRight className=\\\"w-4 h-4 text-slate-400 group-hover:text-teal-600 shrink-0\\\" />\\n              </div>\\n\\n              {/* GEMINI 3.8 LIVE & MULTI-TURN CHAT CARDS */}\\n              <div className=\\\"grid grid-cols-2 gap-2.5\\\">\\n                {/* Live API Voice Call */}\\n                <div\\n                  onClick={() => setLiveVoiceOpen(true)}\\n                  className=\\\"bg-gradient-to-br from-slate-900 to-indigo-950 text-white rounded-3xl p-3.5 cursor-pointer hover:border-teal-400 border border-slate-800 transition shadow-xs flex flex-col justify-between group text-left\\\"\\n                >\\n                  <div>\\n                    <div className=\\\"w-7 h-7 rounded-xl bg-teal-500/20 text-teal-300 flex items-center justify-center mb-1.5\\\">\\n                      <Radio className=\\\"w-3.5 h-3.5 animate-pulse text-teal-400\\\" />\\n                    </div>\\n                    <div className=\\\"text-xs font-bold text-white group-hover:text-teal-300\\\">\\n                      {t.liveVoiceTitle}\\n                    </div>\\n                    <div className=\\\"text-[9px] text-slate-400 mt-0.5 leading-tight\\\">\\n                      {t.liveVoiceDesc}\\n                    </div>\\n                  </div>\\n                  <div className=\\\"mt-2 text-[10px] text-teal-300 font-semibold flex items-center justify-between\\\">\\n                    <span>{t.talkLive}</span>\\n                    <ChevronRight className=\\\"w-3.5 h-3.5\\\" />\\n                  </div>\\n                </div>\\n\\n                {/* Multi-turn Chatbot Quick Launch */}\\n                <div\\n                  onClick={() => setActiveTab(\'chat\')}\\n                  className=\\\"bg-gradient-to-br from-slate-900 to-teal-950 text-white rounded-3xl p-3.5 cursor-pointer hover:border-teal-400 border border-slate-800 transition shadow-xs flex flex-col justify-between group text-left\\\"\\n                >\\n                  <div>\\n                    <div className=\\\"w-7 h-7 rounded-xl bg-indigo-500/20 text-indigo-300 flex items-center justify-center mb-1.5\\\">\\n                      <Bot className=\\\"w-3.5 h-3.5 text-indigo-400\\\" />\\n                    </div>\\n                    <div className=\\\"text-xs font-bold text-white group-hover:text-teal-300\\\">\\n                      {t.aiChatTitle}\\n                    </div>\\n                    <div className=\\\"text-[9px] text-slate-400 mt-0.5 leading-tight\\\">\\n                      {t.aiChatDesc}\\n                    </div>\\n                  </div>\\n                  <div className=\\\"mt-2 text-[10px] text-teal-300 font-semibold flex items-center justify-between\\\">\\n                    <span>{t.openChat}</span>\\n                    <ChevronRight className=\\\"w-3.5 h-3.5\\\" />\\n                  </div>\\n                </div>\\n              </div>\\n\\n              {/* Latest OPD Token Preview */}\\n              {tokens.length > 0 && (\\n                <div className=\\\"space-y-1.5\\\">\\n                  <div className=\\\"flex items-center justify-between\\\">\\n                    <span className=\\\"text-[11px] font-bold text-slate-700 uppercase tracking-wide\\\">\\n                      {t.activeOpdTokensTitle}\\n                    </span>\\n                    <button\\n                      onClick={() => setActiveTab(\'tokens\')}\\n                      className=\\\"text-[10px] text-teal-600 font-semibold hover:underline\\\"\\n                    >\\n                      View All\\n                    </button>\\n                  </div>\\n                  <OPDTokensList tokens={[tokens[0]]} />\\n                </div>\\n              )}\\n\\n              {/* Emergency Assistance Direct Helpline Bar */}\\n              <div className=\\\"bg-rose-50 border border-rose-200 rounded-2xl p-2.5 flex items-center justify-between\\\">\\n                <div className=\\\"flex items-center gap-2\\\">\\n                  <Phone className=\\\"w-3.5 h-3.5 text-rose-600\\\" />\\n                  <div>\\n                    <div className=\\\"text-xs font-bold text-rose-900\\\">{t.ambulanceHelpline}</div>\\n                    <div className=\\\"text-[9px] text-rose-700\\\">Toll-free emergency dialer</div>\\n                  </div>\\n                </div>\\n                <a\\n                  href=\\\"tel:108\\\"\\n                  className=\\\"px-2.5 py-1 bg-rose-600 hover:bg-rose-700 text-white font-bold text-[11px] rounded-xl transition shadow-xs\\\"\\n                >\\n                  {t.dial108}\\n                </a>\\n              </div>\\n            </>\\n          )}\\n\\n          {/* DEDICATED IN-APP CHAT TAB WITH HISTORY */}\\n          {activeTab === \'chat\' && (\\n            <div className=\\\"h-full flex flex-col -mx-4 -my-3 bg-slate-50\\\">\\n              {/* Chat Sub-header with History Drawer Trigger & Model Picker */}\\n              <div className=\\\"bg-slate-900 text-white px-3.5 py-2.5 flex items-center justify-between shrink-0 shadow-xs\\\">\\n                <div className=\\\"flex items-center gap-2\\\">\\n                  <button\\n                    onClick={() => setShowHistoryDropdown((prev) => !prev)}\\n                    className=\\\"p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-teal-300 text-xs flex items-center gap-1 font-semibold\\\"\\n                    title={t.chatHistoryTitle}\\n                  >\\n                    <History className=\\\"w-3.5 h-3.5\\\" />\\n                    <span className=\\\"text-[10px] bg-slate-700 px-1 rounded-full\\\">{chatSessions.length}</span>\\n                  </button>\\n                  <div className=\\\"leading-tight\\\">\\n                    <div className=\\\"text-xs font-bold text-white flex items-center gap-1\\\">\\n                      {t.chatModalTitle}\\n                    </div>\\n                    <div className=\\\"text-[9px] text-slate-400 truncate max-w-[150px]\\\">\\n                      {chatSessions.find((s) => s.id === currentSessionId)?.title || t.newChatBtn}\\n                    </div>\\n                  </div>\\n                </div>\\n\\n                <div className=\\\"flex items-center gap-1.5\\\">\\n                  {/* Model Toggle */}\\n                  <select\\n                    value={chatModel}\\n                    onChange={(e) => setChatModel(e.target.value as any)}\\n                    className=\\\"bg-slate-800 border border-slate-700 text-[10px] font-semibold text-teal-300 rounded-lg px-1.5 py-1 focus:outline-none\\\"\\n                  >\\n                    <option value=\\\"gemini-3.1-flash-lite\\\">Fast Lite</option>\\n                    <option value=\\\"gemini-3.8-flash\\\">General 3.8</option>\\n                    <option value=\\\"gemini-4-argon\\\">Argon 4</option>\\n                  </select>\\n\\n                  <button\\n                    onClick={initNewChatSession}\\n                    className=\\\"p-1.5 bg-teal-600 hover:bg-teal-700 text-white rounded-lg transition\\\"\\n                    title={t.newChatBtn}\\n                  >\\n                    <Plus className=\\\"w-3.5 h-3.5\\\" />\\n                  </button>\\n                </div>\\n              </div>\\n\\n              {/* Slide-down History Session Selector */}\\n              {showHistoryDropdown && (\\n                <div className=\\\"bg-slate-800 text-white p-3 border-b border-slate-700 text-xs shadow-lg space-y-2 max-h-56 overflow-y-auto\\\">\\n                  <div className=\\\"flex items-center justify-between pb-1 border-b border-slate-700\\\">\\n                    <span className=\\\"text-[10px] uppercase font-bold text-teal-400 flex items-center gap-1\\\">\\n                      <History className=\\\"w-3 h-3\\\" /> {t.chatHistoryTitle}\\n                    </span>\\n                    <button\\n                      onClick={() => setShowHistoryDropdown(false)}\\n                      className=\\\"text-slate-400 hover:text-white text-[10px]\\\"\\n                    >\\n                      Close\\n                    </button>\\n                  </div>\\n\\n                  {chatSessions.length === 0 ? (\\n                    <div className=\\\"text-slate-400 text-[11px] py-2 text-center\\\">{t.noPastConversations}</div>\\n                  ) : (\\n                    chatSessions.map((s) => (\\n                      <div\\n                        key={s.id}\\n                        onClick={() => handleSelectSession(s)}\\n                        className={`p-2 rounded-xl text-left cursor-pointer transition flex items-center justify-between ${\\n                          s.id === currentSessionId\\n                            ? \'bg-teal-900/60 border border-teal-500 text-white\'\\n                            : \'hover:bg-slate-700 text-slate-300\'\\n                        }`}\\n                      >\\n                        <div className=\\\"flex-1 min-w-0 pr-2\\\">\\n                          <div className=\\\"text-[11px] font-semibold truncate\\\">{s.title}</div>\\n                          <div className=\\\"text-[9px] text-slate-400\\\">\\n                            {new Date(s.updatedAt).toLocaleDateString([], { month: \'short\', day: \'numeric\' })} \342\200\242 {s.messages.length} msgs\\n                          </div>\\n                        </div>\\n                        <button\\n                          onClick={(e) => handleDeleteSession(s.id, e)}\\n                          className=\\\"p-1 text-slate-400 hover:text-rose-400 transition\\\"\\n                          title={t.deleteSession}\\n                        >\\n                          <Trash2 className=\\\"w-3 h-3\\\" />\\n                        </button>\\n                      </div>\\n                    ))\\n                  )}\\n                </div>\\n              )}\\n\\n              {/* Chat Feed Messages */}\\n              <div className=\\\"flex-1 overflow-y-auto p-3 space-y-3\\\">\\n                {chatMessages.map((m) => (\\n                  <div\\n                    key={m.id}\\n                    className={`flex flex-col ${m.sender === \'user\' ? \'items-end\' : \'items-start\'}`}\\n                  >\\n                    <div\\n                      className={`max-w-[88%] rounded-2xl p-3 text-xs leading-relaxed shadow-2xs ${\\n                        m.sender === \'user\'\\n                          ? \'bg-teal-600 text-white rounded-br-xs\'\\n                          : \'bg-white text-slate-800 border border-slate-200 rounded-bl-xs\'\\n                      }`}\\n                    >\\n                      <div className=\\\"whitespace-pre-wrap\\\">{m.content}</div>\\n                      <div\\n                        className={`flex items-center justify-between gap-2 mt-1.5 pt-1 border-t text-[9px] font-mono ${\\n                          m.sender === \'user\' ? \'border-teal-500 text-teal-200\' : \'border-slate-100 text-slate-400\'\\n                        }`}\\n                      >\\n                        <span>{m.timestamp}</span>\\n                        {m.modelUsed && <span>{m.modelUsed}</span>}\\n                      </div>\\n                    </div>\\n\\n                    {/* Quick Action to trigger Voice Triage / OPD Token if bot recommends */}\\n                    {m.sender === \'assistant\' && (\\n                      <button\\n                        onClick={() => setVoiceSheetOpen(true)}\\n                        className=\\\"mt-1 text-[10px] text-teal-700 hover:underline font-semibold flex items-center gap-1 self-start ml-1\\\"\\n                      >\\n                        <Ticket className=\\\"w-3 h-3\\\" />\\n                        <span>{language === \'te\' ? \'\340\260\246\340\261\200\340\260\250\340\260\277 \340\260\225\340\261\213\340\260\270\340\260\202 \340\260\223\340\260\252\340\261\200\340\260\241\340\261\200 \340\260\237\340\261\213\340\260\225\340\261\206\340\260\250\340\261\215 \340\260\252\340\261\212\340\260\202\340\260\246\340\260\202\340\260\241\340\260\277\' : language === \'hi\' ? \'\340\244\207\340\244\270\340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 OPD \340\244\237\340\245\213\340\244\225\340\244\250 \340\244\262\340\245\207\340\244\202\' : \'Get OPD Token for this\'}</span>\\n                      </button>\\n                    )}\\n                  </div>\\n                ))}\\n\\n                {isChatLoading && (\\n                  <div className=\\\"flex items-start gap-2\\\">\\n                    <div className=\\\"bg-white border border-slate-200 rounded-2xl p-2.5 text-xs text-slate-500 flex items-center gap-2 shadow-2xs\\\">\\n                      <span className=\\\"w-2 h-2 rounded-full bg-teal-500 animate-pulse\\\" />\\n                      <span>{t.thinkingNotice} ({chatModel})</span>\\n                    </div>\\n                  </div>\\n                )}\\n              </div>\\n\\n              {/* Quick Prompts */}\\n              <div className=\\\"px-3 py-1.5 bg-white border-t border-slate-200 flex items-center gap-1.5 overflow-x-auto text-[10px] shrink-0\\\">\\n                <button\\n                  onClick={() => setChatInput(\\n                    language === \'te\'\\n                      ? \'\340\260\250\340\260\276\340\260\225\340\261\201 \340\260\227\340\260\244 \340\260\260\340\261\206\340\260\202\340\260\241\340\261\201 \340\260\260\340\261\213\340\260\234\340\261\201\340\260\262 \340\260\250\340\261\201\340\260\202\340\260\241\340\260\277 \340\260\234\340\261\215\340\260\265\340\260\260\340\260\202 \340\260\256\340\260\260\340\260\277\340\260\257\340\261\201 \340\260\246\340\260\227\340\261\215\340\260\227\340\261\201 \340\260\211\340\260\202\340\260\246\340\260\277\'\\n                      : language === \'hi\'\\n                      ? \'\340\244\256\340\245\201\340\244\235\340\245\207 \340\244\246\340\245\213 \340\244\246\340\244\277\340\244\250\340\245\213\340\244\202 \340\244\270\340\245\207 \340\244\254\340\245\201\340\244\226\340\244\276\340\244\260 \340\244\224\340\244\260 \340\244\226\340\244\276\340\244\202\340\244\270\340\245\200 \340\244\271\340\245\210\'\\n                      : \'I have had fever and persistent cough for 2 days\'\\n                  )}\\n                  className=\\\"px-2 py-0.5 bg-slate-100 hover:bg-teal-50 border border-slate-200 rounded-md text-slate-700 shrink-0 text-left\\\"\\n                >\\n                  {language === \'te\' ? \'\340\260\234\340\261\215\340\260\265\340\260\260\340\260\202 & \340\260\246\340\260\227\340\261\215\340\260\227\340\261\201\' : language === \'hi\' ? \'\340\244\254\340\245\201\340\244\226\340\244\276\340\244\260 \340\244\224\340\244\260 \340\244\226\340\244\276\340\244\202\340\244\270\340\245\200\' : \'Fever & cough\'}\\n                </button>\\n                <button\\n                  onClick={() => setChatInput(\\n                    language === \'te\'\\n                      ? \'\340\260\252\340\260\276\340\260\260\340\260\276\340\260\270\340\261\206\340\260\237\340\260\256\340\260\276\340\260\262\340\261\215 650 \340\260\260\340\261\213\340\260\234\340\261\201\340\260\225\340\261\201 \340\260\216\340\260\250\340\261\215\340\260\250\340\260\277 \340\260\270\340\260\276\340\260\260\340\261\215\340\260\262\340\261\201 \340\260\265\340\261\207\340\260\270\340\261\201\340\260\225\340\261\213\340\260\265\340\260\232\340\261\215\340\260\232\340\261\201?\'\\n                      : language === \'hi\'\\n                      ? \'\340\244\252\340\245\210\340\244\260\340\244\276\340\244\270\340\244\277\340\244\237\340\244\276\340\244\256\340\245\213\340\244\262 650 \340\244\246\340\244\277\340\244\250 \340\244\256\340\245\207\340\244\202 \340\244\225\340\244\277\340\244\244\340\244\250\340\245\200 \340\244\254\340\244\276\340\244\260 \340\244\262\340\245\207 \340\244\270\340\244\225\340\244\244\340\245\207 \340\244\271\340\245\210\340\244\202?\'\\n                      : \'How many times a day can Paracetamol 650 be taken?\'\\n                  )}\\n                  className=\\\"px-2 py-0.5 bg-slate-100 hover:bg-teal-50 border border-slate-200 rounded-md text-slate-700 shrink-0 text-left\\\"\\n                >\\n                  {language === \'te\' ? \'\340\260\252\340\260\276\340\260\260\340\260\276\340\260\270\340\261\206\340\260\237\340\260\256\340\260\276\340\260\262\340\261\215 \340\260\256\340\261\213\340\260\244\340\260\276\340\260\246\340\261\201\' : language === \'hi\' ? \'\340\244\246\340\244\265\340\244\276 \340\244\226\340\245\201\340\244\260\340\244\276\340\244\225\' : \'Paracetamol dosage\'}\\n                </button>\\n              </div>\\n\\n              {/* Chat Input Field */}\\n              <form onSubmit={handleSendChatMessage} className=\\\"p-2.5 bg-white border-t border-slate-200 flex items-center gap-1.5 shrink-0\\\">\\n                <input\\n                  type=\\\"text\\\"\\n                  value={chatInput}\\n                  onChange={(e) => setChatInput(e.target.value)}\\n                  placeholder={t.chatInputPlaceholder}\\n                  className=\\\"flex-1 bg-slate-100 border border-slate-200 focus:border-teal-600 focus:bg-white rounded-xl px-3 py-2 text-xs text-slate-900 focus:outline-none transition\\\"\\n                />\\n                <button\\n                  type=\\\"submit\\\"\\n                  disabled={!chatInput.trim() || isChatLoading}\\n                  className={`w-8 h-8 rounded-xl flex items-center justify-center transition shadow-2xs ${\\n                    !chatInput.trim() || isChatLoading\\n                      ? \'bg-slate-200 text-slate-400 cursor-not-allowed\'\\n                      : \'bg-teal-600 text-white hover:bg-teal-700\'\\n                  }`}\\n                >\\n                  <Send className=\\\"w-3.5 h-3.5\\\" />\\n                </button>\\n              </form>\\n            </div>\\n          )}\\n\\n          {/* RECORDS TAB */}\\n          {activeTab === \'records\' && (\\n            <div>\\n              <h2 className=\\\"text-sm font-extrabold text-slate-900 mb-2.5\\\">{t.healthRecordsTitle}</h2>\\n              <HealthRecordsView />\\n            </div>\\n          )}\\n\\n          {/* TOKENS TAB */}\\n          {activeTab === \'tokens\' && (\\n            <div>\\n              <h2 className=\\\"text-sm font-extrabold text-slate-900 mb-2.5\\\">{t.digitalOpdToken}</h2>\\n              <OPDTokensList tokens={tokens} />\\n            </div>\\n          )}\\n\\n          {/* PROFILE TAB */}\\n          {activeTab === \'profile\' && profile && (\\n            <div className=\\\"space-y-3 text-left\\\">\\n              <h2 className=\\\"text-sm font-extrabold text-slate-900\\\">{t.profileTitle}</h2>\\n\\n              <div className=\\\"bg-slate-50 border border-slate-200 rounded-2xl p-3.5 space-y-1.5\\\">\\n                <div className=\\\"text-xs font-bold text-slate-900\\\">{profile.name}</div>\\n                <div className=\\\"text-[11px] text-slate-600\\\">Phone: {profile.phone}</div>\\n                <div className=\\\"text-[11px] text-slate-600\\\">Age: {profile.age} \342\200\242 Gender: {profile.gender}</div>\\n                <div className=\\\"text-[11px] text-slate-600\\\">Language: {language.toUpperCase()}</div>\\n              </div>\\n\\n              <div className=\\\"bg-rose-50 border border-rose-200 rounded-2xl p-3.5 space-y-1\\\">\\n                <div className=\\\"text-[11px] font-bold text-rose-900 uppercase\\\">{t.emergencyContact}</div>\\n                <div className=\\\"text-xs font-semibold text-slate-800\\\">\\n                  {profile.emergency_contact.name} ({profile.emergency_contact.relationship})\\n                </div>\\n                <div className=\\\"text-[11px] text-slate-600\\\">{profile.emergency_contact.phone}</div>\\n              </div>\\n\\n              <div className=\\\"bg-slate-50 border border-slate-200 rounded-2xl p-3.5 space-y-1\\\">\\n                <div className=\\\"text-[11px] font-bold text-slate-700 uppercase\\\">{t.medicalFlags}</div>\\n                <div className=\\\"text-[11px] text-slate-600\\\">\\n                  {t.knownConditions}: {profile.known_conditions?.join(\', \') || t.noneRecorded}\\n                </div>\\n                <div className=\\\"text-[11px] text-slate-600\\\">\\n                  {t.allergies}: {profile.allergies?.join(\', \') || t.noneRecorded}\\n                </div>\\n              </div>\\n            </div>\\n          )}\\n        </div>\\n\\n        {/* Device Bottom Native Navigation Bar */}\\n        <div className=\\\"bg-white border-t border-slate-200 px-3 py-1.5 flex items-center justify-between shrink-0 z-20\\\">\\n          {/* Home Tab */}\\n          <button\\n            onClick={() => setActiveTab(\'home\')}\\n            className={`flex flex-col items-center gap-0.5 flex-1 transition ${\\n              activeTab === \'home\' ? \'text-teal-600 font-bold\' : \'text-slate-400 hover:text-slate-700\'\\n            }`}\\n          >\\n            <Home className=\\\"w-4 h-4\\\" />\\n            <span className=\\\"text-[9px]\\\">{t.navHome}</span>\\n          </button>\\n\\n          {/* Chat Tab - DEDICATED FIRST-CLASS CHAT TAB */}\\n          <button\\n            onClick={() => setActiveTab(\'chat\')}\\n            className={`flex flex-col items-center gap-0.5 flex-1 transition ${\\n              activeTab === \'chat\' ? \'text-teal-600 font-bold\' : \'text-slate-400 hover:text-slate-700\'\\n            }`}\\n          >\\n            <Bot className=\\\"w-4 h-4\\\" />\\n            <span className=\\\"text-[9px]\\\">{t.navChat}</span>\\n          </button>\\n\\n          {/* CENTRAL 2.5-SECOND SOS BUTTON */}\\n          <div className=\\\"flex-1 flex justify-center -mt-5\\\">\\n            <SOSEmergencyButton onSOSCreated={handleSOSDispatched} />\\n          </div>\\n\\n          {/* Records Tab */}\\n          <button\\n            onClick={() => setActiveTab(\'records\')}\\n            className={`flex flex-col items-center gap-0.5 flex-1 transition ${\\n              activeTab === \'records\' ? \'text-teal-600 font-bold\' : \'text-slate-400 hover:text-slate-700\'\\n            }`}\\n          >\\n            <FileText className=\\\"w-4 h-4\\\" />\\n            <span className=\\\"text-[9px]\\\">{t.navRecords}</span>\\n          </button>\\n\\n          {/* Tokens Tab */}\\n          <button\\n            onClick={() => setActiveTab(\'tokens\')}\\n            className={`flex flex-col items-center gap-0.5 flex-1 transition ${\\n              activeTab === \'tokens\' ? \'text-teal-600 font-bold\' : \'text-slate-400 hover:text-slate-700\'\\n            }`}\\n          >\\n            <Ticket className=\\\"w-4 h-4\\\" />\\n            <span className=\\\"text-[9px]\\\">{t.navTokens}</span>\\n          </button>\\n        </div>\\n\\n        {/* Modal Sheets */}\\n        <VoiceTriageSheet\\n          isOpen={voiceSheetOpen}\\n          onClose={() => setVoiceSheetOpen(false)}\\n          preferredLanguage={language}\\n          onTokenGenerated={handleTokenGenerated}\\n        />\\n\\n        <PrescriptionScannerSheet\\n          isOpen={rxSheetOpen}\\n          onClose={() => setRxSheetOpen(false)}\\n          preferredLanguage={language}\\n        />\\n\\n        <GeminiLiveVoiceModal\\n          isOpen={liveVoiceOpen}\\n          onClose={() => setLiveVoiceOpen(false)}\\n          preferredLanguage={language}\\n        />\\n\\n        <GeminiChatbotModal\\n          isOpen={chatModalOpen}\\n          onClose={() => setChatModalOpen(false)}\\n        />\\n      </div>\\n    </div>\\n  );\\n};\\n\",\"StartLine\":1,\"TargetContent\":\"import React, { useState, useEffect } from \'react\';\\nimport {\\n  Home,\\n  FileText,\\n  Ticket,\\n  User,\\n  Mic,\\n  Camera,\\n  MapPin,\\n  ChevronRight,\\n  Globe,\\n  Phone,\\n  Sparkles,\\n  HeartPulse,\\n  ArrowRight,\\n  Radio,\\n  MessageSquare,\\n  Bot\\n} from \'lucide-react\';\\nimport { DailyHealthInsightCard } from \'./DailyHealthInsightCard\';\\nimport { VoiceTriageSheet } from \'./VoiceTriageSheet\';\\nimport { PrescriptionScannerSheet } from \'./PrescriptionScannerSheet\';\\nimport { GeminiLiveVoiceModal } from \'../live/GeminiLiveVoiceModal\';\\nimport { GeminiChatbotModal } from \'../chat/GeminiChatbotModal\';\\nimport { SOSEmergencyButton } from \'./SOSEmergencyButton\';\\nimport { OPDTokensList } from \'./OPDTokensList\';\\nimport { HealthRecordsView } from \'./HealthRecordsView\';\\nimport { api } from \'../../services/api\';\\nimport { UserProfile, OPDToken, DailyHealthInsight, Language } from \'../../types\';\\n\\ninterface Props {\\n  onSOSCreated?: () => void;\\n  onTriageCreated?: () => void;\\n}\\n\\nexport const MobileAppView: React.FC<Props> = ({ onSOSCreated, onTriageCreated }) => {\\n  const [activeTab, setActiveTab] = useState<\'home\' | \'records\' | \'tokens\' | \'profile\'>(\'home\');\\n  const [profile, setProfile] = useState<UserProfile | null>(null);\\n  const [healthInsight, setHealthInsight] = useState<DailyHealthInsight | null>(null);\\n  const [tokens, setTokens] = useState<OPDToken[]>([]);\\n  const [voiceSheetOpen, setVoiceSheetOpen] = useState(false);\\n  const [rxSheetOpen, setRxSheetOpen] = useState(false);\\n  const [liveVoiceOpen, setLiveVoiceOpen] = useState(false);\\n  const [chatModalOpen, setChatModalOpen] = useState(false);\\n\\n  useEffect(() => {\\n    loadInitialData();\\n  }, []);\\n\\n  const loadInitialData = async () => {\\n    try {\\n      const [u, h, t] = await Promise.all([\\n        api.getProfile(),\\n        api.getHealthInsights(),\\n        api.getTokens(),\\n      ]);\\n      setProfile(u);\\n      setHealthInsight(h);\\n      setTokens(t);\\n    } catch (e) {\\n      console.error(\'Error loading mobile data:\', e);\\n    }\\n  };\\n\\n  const handleLanguageChange = async (lang: Language) => {\\n    if (!profile) return;\\n    try {\\n      const updated = await api.updateProfile({ preferred_language: lang });\\n      setProfile(updated);\\n    } catch (e) {\\n      console.error(\'Failed to change language:\', e);\\n    }\\n  };\\n\\n  const handleTokenGenerated = (newToken: OPDToken) => {\\n    setTokens((prev) => [newToken, ...prev]);\\n    if (onTriageCreated) onTriageCreated();\\n  };\\n\\n  const handleSOSDispatched = () => {\\n    if (onSOSCreated) onSOSCreated();\\n  };\\n\\n  const currentLang = profile?.preferred_language || \'te\';\\n\\n  return (\\n    <div className=\\\"w-full flex justify-center py-2 sm:py-6\\\">\\n      {/* Mobile Frame Container */}\\n      <div className=\\\"w-full max-w-[390px] h-[810px] bg-white rounded-[40px] shadow-2xl border-8 border-slate-900 flex flex-col overflow-hidden relative select-none\\\">\\n        {/* Device Top Status Bar */}\\n        <div className=\\\"bg-white pt-2.5 px-6 pb-2 flex items-center justify-between text-[11px] font-semibold text-slate-800 shrink-0 z-20 border-b border-slate-100\\\">\\n          <span>9:41</span>\\n          {/* Dynamic Island / Speaker notch */}\\n          <div className=\\\"w-20 h-4 bg-slate-900 rounded-full\\\" />\\n          <div className=\\\"flex items-center gap-1.5 text-slate-700\\\">\\n            <span className=\\\"text-[10px]\\\">5G</span>\\n            <div className=\\\"w-5 h-2.5 border border-slate-700 rounded-xs p-0.5 flex items-center\\\">\\n              <div className=\\\"w-full h-full bg-slate-800 rounded-xs\\\" />\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* App Top Bar */}\\n        <div className=\\\"bg-white px-5 py-3 flex items-center justify-between border-b border-slate-100 shrink-0 z-10\\\">\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <div className=\\\"w-8 h-8 rounded-xl bg-teal-600 text-white flex items-center justify-center font-black text-sm shadow-xs\\\">\\n              \340\244\270\340\244\202\\n            </div>\\n            <div>\\n              <div className=\\\"text-xs font-extrabold text-slate-900 tracking-tight flex items-center gap-1\\\">\\n                Sanjeevani Triage <span className=\\\"text-[9px] bg-teal-100 text-teal-800 font-bold px-1.5 py-0.2 rounded\\\">OPD</span>\\n              </div>\\n              <div className=\\\"text-[10px] text-slate-400 flex items-center gap-1\\\">\\n                <MapPin className=\\\"w-2.5 h-2.5 text-teal-600\\\" /> Visakhapatnam, AP\\n              </div>\\n            </div>\\n          </div>\\n\\n          {/* Language Switcher */}\\n          <div className=\\\"flex bg-slate-100 p-0.5 rounded-lg border border-slate-200\\\">\\n            {([\'te\', \'hi\', \'en\'] as Language[]).map((lang) => (\\n              <button\\n                key={lang}\\n                onClick={() => handleLanguageChange(lang)}\\n                className={`px-2 py-0.5 text-[10px] font-bold rounded-md uppercase transition ${\\n                  currentLang === lang\\n                    ? \'bg-teal-600 text-white shadow-xs\'\\n                    : \'text-slate-600 hover:text-slate-900\'\\n                }`}\\n              >\\n                {lang === \'te\' ? \'\340\260\244\340\261\206\340\260\262\340\261\201\340\260\227\340\261\201\' : lang === \'hi\' ? \'\340\244\271\340\244\277\340\244\202\340\244\246\340\245\200\' : \'EN\'}\\n              </button>\\n            ))}\\n          </div>\\n        </div>\\n\\n        {/* Scrollable Main Screen Content */}\\n        <div className=\\\"flex-1 overflow-y-auto px-4 py-4 space-y-4\\\">\\n          {activeTab === \'home\' && (\\n            <>\\n              {/* Patient Greeting */}\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <div>\\n                  <h1 className=\\\"text-lg font-extrabold text-slate-900\\\">\\n                    {currentLang === \'te\'\\n                      ? `\340\260\250\340\260\256\340\260\270\340\261\215\340\260\244\340\261\207, ${profile?.name || \'\340\260\260\340\260\256\340\261\207\340\260\267\340\261\215\'}`\\n                      : currentLang === \'hi\'\\n                      ? `\340\244\250\340\244\256\340\244\270\340\245\215\340\244\244\340\245\207, ${profile?.name || \'\340\244\260\340\244\256\340\245\207\340\244\266\'}`\\n                      : `Hello, ${profile?.name || \'Ramesh\'}`}\\n                  </h1>\\n                  <p className=\\\"text-xs text-slate-500\\\">How can we assist your health today?</p>\\n                </div>\\n                <div className=\\\"w-10 h-10 rounded-full bg-teal-100 border border-teal-300 text-teal-800 flex items-center justify-center font-bold text-sm shadow-xs\\\">\\n                  {profile?.name ? profile.name.charAt(0) : \'R\'}\\n                </div>\\n              </div>\\n\\n              {/* Daily Health Insight Card */}\\n              <DailyHealthInsightCard insight={healthInsight} />\\n\\n              {/* PRIMARY ZERO-UI HERO CTA: Speak Symptoms */}\\n              <div\\n                onClick={() => setVoiceSheetOpen(true)}\\n                className=\\\"relative bg-gradient-to-br from-teal-600 to-teal-800 text-white rounded-3xl p-5 shadow-lg shadow-teal-700/20 cursor-pointer hover:shadow-teal-700/30 transition group overflow-hidden\\\"\\n              >\\n                <div className=\\\"absolute -right-6 -bottom-6 w-32 h-32 bg-white/10 rounded-full blur-xl group-hover:scale-110 transition duration-500\\\" />\\n\\n                <div className=\\\"flex items-center justify-between mb-3\\\">\\n                  <div className=\\\"w-12 h-12 rounded-2xl bg-white/20 backdrop-blur-md flex items-center justify-center text-white shadow-inner\\\">\\n                    <Mic className=\\\"w-6 h-6 animate-pulse\\\" />\\n                  </div>\\n                  <span className=\\\"text-[10px] font-bold uppercase tracking-wider bg-white/20 text-teal-50 px-2.5 py-1 rounded-full backdrop-blur-xs\\\">\\n                    Multimodal AI\\n                  </span>\\n                </div>\\n\\n                <div className=\\\"text-base font-black tracking-tight\\\">\\n                  {currentLang === \'te\'\\n                    ? \'\340\260\256\340\261\200 \340\260\262\340\260\225\340\261\215\340\260\267\340\260\243\340\260\276\340\260\262\340\260\250\340\261\201 \340\260\256\340\260\276\340\260\237\340\261\215\340\260\262\340\260\276\340\260\241\340\260\202\340\260\241\340\260\277\'\\n                    : currentLang === \'hi\'\\n                    ? \'\340\244\205\340\244\252\340\244\250\340\245\207 \340\244\262\340\244\225\340\245\215\340\244\267\340\244\243 \340\244\254\340\245\213\340\244\262\340\244\225\340\244\260 \340\244\254\340\244\244\340\244\276\340\244\217\340\244\202\'\\n                    : \'Speak Your Symptoms\'}\\n                </div>\\n                <p className=\\\"text-xs text-teal-100 mt-1 leading-relaxed\\\">\\n                  Natural voice symptom triage in Telugu, Hindi or English. Instant digital OPD token.\\n                </p>\\n\\n                <div className=\\\"mt-4 pt-3 border-t border-teal-500/40 flex items-center justify-between text-xs font-semibold text-teal-100 group-hover:text-white\\\">\\n                  <span>Hold to Speak</span>\\n                  <ArrowRight className=\\\"w-4 h-4 group-hover:translate-x-1 transition\\\" />\\n                </div>\\n              </div>\\n\\n              {/* SECONDARY ACTION: Smart Rx Decoder */}\\n              <div\\n                onClick={() => setRxSheetOpen(true)}\\n                className=\\\"bg-slate-50 border border-slate-200 hover:border-teal-400 rounded-3xl p-4 cursor-pointer transition shadow-xs flex items-center justify-between group\\\"\\n              >\\n                <div className=\\\"flex items-center gap-3\\\">\\n                  <div className=\\\"w-11 h-11 rounded-2xl bg-teal-500/10 text-teal-600 flex items-center justify-center shrink-0\\\">\\n                    <Camera className=\\\"w-5 h-5\\\" />\\n                  </div>\\n                  <div>\\n                    <div className=\\\"text-xs font-bold text-slate-900 group-hover:text-teal-700\\\">\\n                      Smart Rx Decoder\\n                    </div>\\n                    <div className=\\\"text-[11px] text-slate-500 mt-0.5\\\">\\n                      Photograph doctor prescription & get instructions\\n                    </div>\\n                  </div>\\n                </div>\\n                <ChevronRight className=\\\"w-4 h-4 text-slate-400 group-hover:text-teal-600 shrink-0\\\" />\\n              </div>\\n\\n              {/* GEMINI 3.8 LIVE & MULTI-TURN CHAT CARDS */}\\n              <div className=\\\"grid grid-cols-2 gap-2.5\\\">\\n                {/* Live API Voice Call */}\\n                <div\\n                  onClick={() => setLiveVoiceOpen(true)}\\n                  className=\\\"bg-gradient-to-br from-slate-900 to-indigo-950 text-white rounded-3xl p-3.5 cursor-pointer hover:border-teal-400 border border-slate-800 transition shadow-xs flex flex-col justify-between group text-left\\\"\\n                >\\n                  <div>\\n                    <div className=\\\"w-8 h-8 rounded-xl bg-teal-500/20 text-teal-300 flex items-center justify-center mb-2\\\">\\n                      <Radio className=\\\"w-4 h-4 animate-pulse text-teal-400\\\" />\\n                    </div>\\n                    <div className=\\\"text-xs font-bold text-white group-hover:text-teal-300\\\">\\n                      Live Voice Call\\n                    </div>\\n                    <div className=\\\"text-[10px] text-slate-400 mt-0.5 leading-tight\\\">\\n                      gemini-3.8-live (Live API)\\n                    </div>\\n                  </div>\\n                  <div className=\\\"mt-2 text-[10px] text-teal-300 font-semibold flex items-center justify-between\\\">\\n                    <span>Talk Live</span>\\n                    <ChevronRight className=\\\"w-3.5 h-3.5\\\" />\\n                  </div>\\n                </div>\\n\\n                {/* Multi-turn Chatbot */}\\n                <div\\n                  onClick={() => setChatModalOpen(true)}\\n                  className=\\\"bg-gradient-to-br from-slate-900 to-teal-950 text-white rounded-3xl p-3.5 cursor-pointer hover:border-teal-400 border border-slate-800 transition shadow-xs flex flex-col justify-between group text-left\\\"\\n                >\\n                  <div>\\n                    <div className=\\\"w-8 h-8 rounded-xl bg-indigo-500/20 text-indigo-300 flex items-center justify-center mb-2\\\">\\n                      <Bot className=\\\"w-4 h-4 text-indigo-400\\\" />\\n                    </div>\\n                    <div className=\\\"text-xs font-bold text-white group-hover:text-teal-300\\\">\\n                      AI Health Chat\\n                    </div>\\n                    <div className=\\\"text-[10px] text-slate-400 mt-0.5 leading-tight\\\">\\n                      Multi-Turn Gemini Bot\\n                    </div>\\n                  </div>\\n                  <div className=\\\"mt-2 text-[10px] text-teal-300 font-semibold flex items-center justify-between\\\">\\n                    <span>Open Chat</span>\\n                    <ChevronRight className=\\\"w-3.5 h-3.5\\\" />\\n                  </div>\\n                </div>\\n              </div>\\n\\n              {/* Latest OPD Token Preview */}\\n              {tokens.length > 0 && (\\n                <div className=\\\"space-y-2\\\">\\n                  <div className=\\\"flex items-center justify-between\\\">\\n                    <span className=\\\"text-xs font-bold text-slate-700 uppercase tracking-wide\\\">\\n                      Active OPD Token\\n                    </span>\\n                    <button\\n                      onClick={() => setActiveTab(\'tokens\')}\\n                      className=\\\"text-[11px] text-teal-600 font-semibold hover:underline\\\"\\n                    >\\n                      View All\\n                    </button>\\n                  </div>\\n                  <OPDTokensList tokens={[tokens[0]]} />\\n                </div>\\n              )}\\n\\n              {/* Emergency Assistance Direct Helpline Bar */}\\n              <div className=\\\"bg-rose-50 border border-rose-200 rounded-2xl p-3 flex items-center justify-between\\\">\\n                <div className=\\\"flex items-center gap-2\\\">\\n                  <Phone className=\\\"w-4 h-4 text-rose-600\\\" />\\n                  <div>\\n                    <div className=\\\"text-xs font-bold text-rose-900\\\">National Ambulance</div>\\n                    <div className=\\\"text-[10px] text-rose-700\\\">Toll-free emergency dialer</div>\\n                  </div>\\n                </div>\\n                <a\\n                  href=\\\"tel:108\\\"\\n                  className=\\\"px-3 py-1 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs rounded-xl transition shadow-xs\\\"\\n                >\\n                  Dial 108\\n                </a>\\n              </div>\\n            </>\\n          )}\\n\\n          {activeTab === \'records\' && (\\n            <div>\\n              <h2 className=\\\"text-base font-extrabold text-slate-900 mb-3\\\">Health Records</h2>\\n              <HealthRecordsView />\\n            </div>\\n          )}\\n\\n          {activeTab === \'tokens\' && (\\n            <div>\\n              <h2 className=\\\"text-base font-extrabold text-slate-900 mb-3\\\">Digital OPD Tokens</h2>\\n              <OPDTokensList tokens={tokens} />\\n            </div>\\n          )}\\n\\n          {activeTab === \'profile\' && profile && (\\n            <div className=\\\"space-y-4 text-left\\\">\\n              <h2 className=\\\"text-base font-extrabold text-slate-900\\\">Patient Profile</h2>\\n\\n              <div className=\\\"bg-slate-50 border border-slate-200 rounded-2xl p-4 space-y-2\\\">\\n                <div className=\\\"text-sm font-bold text-slate-900\\\">{profile.name}</div>\\n                <div className=\\\"text-xs text-slate-600\\\">Phone: {profile.phone}</div>\\n                <div className=\\\"text-xs text-slate-600\\\">Age: {profile.age} \342\200\242 Gender: {profile.gender}</div>\\n                <div className=\\\"text-xs text-slate-600\\\">Language: {profile.preferred_language.toUpperCase()}</div>\\n              </div>\\n\\n              <div className=\\\"bg-rose-50 border border-rose-200 rounded-2xl p-4 space-y-1.5\\\">\\n                <div className=\\\"text-xs font-bold text-rose-900 uppercase\\\">Emergency Contact</div>\\n                <div className=\\\"text-xs font-semibold text-slate-800\\\">\\n                  {profile.emergency_contact.name} ({profile.emergency_contact.relationship})\\n                </div>\\n                <div className=\\\"text-xs text-slate-600\\\">{profile.emergency_contact.phone}</div>\\n              </div>\\n\\n              <div className=\\\"bg-slate-50 border border-slate-200 rounded-2xl p-4 space-y-1.5\\\">\\n                <div className=\\\"text-xs font-bold text-slate-700 uppercase\\\">Medical Flags</div>\\n                <div className=\\\"text-xs text-slate-600\\\">\\n                  Known conditions: {profile.known_conditions?.join(\', \') || \'None recorded\'}\\n                </div>\\n                <div className=\\\"text-xs text-slate-600\\\">\\n                  Allergies: {profile.allergies?.join(\', \') || \'None recorded\'}\\n                </div>\\n              </div>\\n            </div>\\n          )}\\n        </div>\\n\\n        {/* Device Bottom Native Navigation Bar */}\\n        <div className=\\\"bg-white border-t border-slate-200 px-4 py-2 flex items-center justify-between shrink-0 z-20\\\">\\n          {/* Home Tab */}\\n          <button\\n            onClick={() => setActiveTab(\'home\')}\\n            className={`flex flex-col items-center gap-0.5 flex-1 transition ${\\n              activeTab === \'home\' ? \'text-teal-600 font-bold\' : \'text-slate-400 hover:text-slate-700\'\\n            }`}\\n          >\\n            <Home className=\\\"w-5 h-5\\\" />\\n            <span className=\\\"text-[10px]\\\">Home</span>\\n          </button>\\n\\n          {/* Records Tab */}\\n          <button\\n            onClick={() => setActiveTab(\'records\')}\\n            className={`flex flex-col items-center gap-0.5 flex-1 transition ${\\n              activeTab === \'records\' ? \'text-teal-600 font-bold\' : \'text-slate-400 hover:text-slate-700\'\\n            }`}\\n          >\\n            <FileText className=\\\"w-5 h-5\\\" />\\n            <span className=\\\"text-[10px]\\\">Records</span>\\n          </button>\\n\\n          {/* CENTRAL 2.5-SECOND SOS BUTTON */}\\n          <div className=\\\"flex-1 flex justify-center -mt-5\\\">\\n            <SOSEmergencyButton onSOSCreated={handleSOSDispatched} />\\n          </div>\\n\\n          {/* Tokens Tab */}\\n          <button\\n            onClick={() => setActiveTab(\'tokens\')}\\n            className={`flex flex-col items-center gap-0.5 flex-1 transition ${\\n              activeTab === \'tokens\' ? \'text-teal-600 font-bold\' : \'text-slate-400 hover:text-slate-700\'\\n            }`}\\n          >\\n            <Ticket className=\\\"w-5 h-5\\\" />\\n            <span className=\\\"text-[10px]\\\">Tokens</span>\\n          </button>\\n\\n          {/* Profile Tab */}\\n          <button\\n            onClick={() => setActiveTab(\'profile\')}\\n            className={`flex flex-col items-center gap-0.5 flex-1 transition ${\\n              activeTab === \'profile\' ? \'text-teal-600 font-bold\' : \'text-slate-400 hover:text-slate-700\'\\n            }`}\\n          >\\n            <User className=\\\"w-5 h-5\\\" />\\n            <span className=\\\"text-[10px]\\\">Profile</span>\\n          </button>\\n        </div>\\n\\n        {/* Modal Sheets */}\\n        <VoiceTriageSheet\\n          isOpen={voiceSheetOpen}\\n          onClose={() => setVoiceSheetOpen(false)}\\n          preferredLanguage={currentLang}\\n          onTokenGenerated={handleTokenGenerated}\\n        />\\n\\n        <PrescriptionScannerSheet\\n          isOpen={rxSheetOpen}\\n          onClose={() => setRxSheetOpen(false)}\\n          preferredLanguage={currentLang}\\n        />\\n\\n        <GeminiLiveVoiceModal\\n          isOpen={liveVoiceOpen}\\n          onClose={() => setLiveVoiceOpen(false)}\\n          preferredLanguage={currentLang}\\n        />\\n\\n        <GeminiChatbotModal\\n          isOpen={chatModalOpen}\\n          onClose={() => setChatModalOpen(false)}\\n          preferredLanguage={currentLang}\\n        />\\n      </div>\\n    </div>\\n  );\\n};\\n\",\"TargetFile\":\"/src/components/mobile/MobileAppView.tsx\",\"toolAction\":\"Updating MobileAppView\",\"toolSummary\":\"Update MobileAppView with useLanguage and Chat tab\"}"
