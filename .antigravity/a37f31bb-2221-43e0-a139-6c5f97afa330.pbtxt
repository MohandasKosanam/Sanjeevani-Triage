      thinking_signature: "\022\231\f\n\226\f\001i\024}\023\346\004\3054s\343dj\354\345\364\vR\214IY3&5\025\206\334y\002\001\205N\2102\334\325\321|7\263\231\231\263\t)\227\332\324\314\352\330\245\327\023\270\263\300\260B\353Go1\230\376<\316N;\"\210\203\023\337\003\265J\024\034\267\354\243_M-&Te\226I\366\373\331*\024\303\242\313]\242\367\v!\350\372\377\340C\032\272\346\026\263y\ac\332\326\301\265S\201\355?\227\203\am\212c \303\a\f\036*\311\005G\237e\225A\221)\331\240jq\365E\237\025\350\216\242\254\347\211\241\356\324B\275\275\243\241\273\221\205F\372\277\244\333\214`\334+\000Cq\347\342\244a\362ac\300\017\367\314\257\027Ge\367A<\325\377\265<\334Qd\311\350R\322q\265\024\306ZH:q\337<2L\346\001\273x|\212|\312\233\022\370R$+\314P$$\262\016\315\336\356\211\330%\a\352_0\277R\203\323\255@6\236*\330\363$\302\336\207F4\244(\331_\f\345\350\312Q\244\217D\347\374n\352\254\307\016\n\267&\311*Z\234\357\300\335\262\225<W\317B\031E\330\223\f|\314A\323#+W\356o\330\357uW\327X!\0172\316\020\356.&u\024\311j\261\237\303z\211\353\263\303\357Q\313\277\275kW<\252\031\256\203\364\230f\354\361\300\314\312\320d\223#\302\257^\205Y\330\333Y\214\340\246]Sf2h\351\026\232\377?-\2564\250\254\232\272 g.-(\352\177g\343\242}*\207/\221#\r\352\327\257\306-XQp\031z3\347L\345\025!n\212\003\260\305\340M\222\337\351\343?\245\326%r\313\276\211\313\202\'\b8\350\246\275\276\351\350\221\334M\020\347\026\1775i\317C&\366\374\260\235>\255B;\265QXp>\r\334hV\270\016\203\242u~\374-H\236\211\024\230\f\316\205~!\241\370\217L?\237z\225~\003\021\373\337\252\020\270\000i\336\241\vHC\372g2\346\332\277\320^\353\220\r=\f\316\234\245]\017\027&\304V\230\241\025\aF\373*\177\211\213\317\026\2100\310\321a\"\364\246\313-\226\272(\032x\270\355\235f\311\241\343\351\270\n7\231\353\321],H)m\331)k\301\3263\003\317\0055\342\337(]\240d\354\316D\274\235\020[\n\330hTK5(\372\tmy0\220\344=dw\300a\\*z\360\2436s\356\3257\027\177\235\351Vq\227\f\"\177\3257u\200\223\244\346\336\375cG\315\201gM\363\\7\367w\037\003\343\343Y\377\214\260\'%\251\272\317\266\n\f\226\322\260\0379K\330\213\334\253[3L\006\323C\366\025D\251\230\300\272\263\346\027]\302a\037\222\000\016\205\273\a\n\361w\327i[4\224\202Afr\242\333\214\317b\024\005\206P\330K\032\214~Q\217\360G\346\361:\n\024\005z\201\375.\001\344\246\334$\225Q\352\317\366\357\365\256\035$\317Z\277\25713\315\n\305?\224\360\366bg\233+\207\371p\351J\215\312z\314\236w\320-\204\vx\225x.\031\363\323gf\373M\233\v\0243\371.\030<\275\326\352\300\257w\344Dw\350\222Dvo\233\003\321\316\3077\257\037\025H\311<-\223s\022\2425\241\311\340\311\006\343\335\024;\245\361\a\333\234\317\317\v\2073\377\341\201\r\304\034\226\336\016\232K\"\224\305\213\3342\320e\304\203\266\334\f\205iK\273v\020\343\216\177\025\247&\201\377\264_\365\327\311\224N\264\203%\016P-\360\366\301\016(\307\030\b\352\024\246\222Z\230K\025\021\307\246_p\016\210\303\334\361\316(\356\034\022h\217\356\326*\250\037 \353\227\375\016U~:\322\201E\277o\357NXaJ\355H\201\nPL\233\253\2261\225\3006\3208\370Yk\204;%\202N\326\"\036\245\350\221\245\375I6\206\203\2046(\316\210\302L!U\203\005\302\323\271J\254qw\323/\331\370X\352\253\v\017?t\'\257\225\'<M?\205\233\200\020{8\351\242IkD\210\211|J\376\t\306,8\337\232\355\022\000\374\364\223\373\312\267\264\355Z\355%*\235\356\244\315\357>\003\003iC<\212\005\254\244RG\305\234\260V\251\255\017+Lx*\000Z`\326\234\372\f\233q\214\246\313\034\310\355\237\367\367\236-\331l\205y\325e\366\231WO\306\263\330\343\000\342\017\270\235y\361\233l\371p\026Nh\337D\004\324\034\234J\361\257\221fX\021\206\030\315\227\025\305\'\023%\3120@=Z\251\370\304\376i\324\314\315\236O\352\264\202~\207S_2d\221-<\371@|\305\236\266\302\360{\231\345]@(xf\371dG\006Ci\266\311\026i\225w0V\306\362\030\327\260l\035\300X\343^\344rt[L\305\\\242Og)\2170\243\340\am\325\311\004 \214\275\345\301\a\'!.=)\217\r\2542\343V\354u?\303\275\365@d\340B\003\344\223\273\005\\G\207\t\257\207A(C\035C\261\321\005a\236\003\243\207\340Yk\255\365\221~\277\206\230\374\340\"\206\216e;Im\363!\202\223\236\f\t<\336\372%\034\247EyQ\375\354\016!\275\267\212\356\220\246\247\352\326\236B#T\250\227\005\234\177\346\030!\360y\355@Z\025\a\372\a$%\312\376\336y\b\r#\224\306\266\224\032\205\001\t\246\222:\347\365\274CG=\fp\316\216x\304\316\230`o\3641f\n\345\234\253r\231f\0252\274\205;\373\037\273\325!\331@\2314t\257\001\270\274G1v\373/\325\307 ee8\026%A+\360lR\366\264ie\255OE\203rgJ\031\231\311\327\214\376\332\331b\206\224[\022\336q\201\027\324\322\355\034\360\201\266\355G\275A\263\360\vN\307m`F\337;i\325k\t\277C\317\037\2645\204\243\232\227bb"
