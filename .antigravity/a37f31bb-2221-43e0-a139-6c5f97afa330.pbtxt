            lines {
              text: "    if (lastUserMsg.includes(\'\340\244\226\340\245\201\340\244\260\340\244\276\340\244\225\') || lastUserMsg.includes(\'\340\244\246\340\244\265\340\244\276\') || lastUserMsg.includes(\'\340\244\252\340\245\210\340\244\260\340\244\276\340\244\270\340\244\277\340\244\237\340\244\276\340\244\256\340\245\213\340\244\262\') || lastUserMsg.includes(\'medicine\')) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
