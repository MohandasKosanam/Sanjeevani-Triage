  planner_response {
    thinking: "**Constructing Language Context**\n\nI\'m now building the full internationalization system. The main goal is to ensure the application\'s language changes seamlessly whenever the user selects a new language. I\'m focusing on creating `src/context/LanguageContext.tsx` which will manage the language state, offering `language: \'te\' | \'hi\' | \'en\'` and `setLanguage(lang)` for easy language switching.\n\n\n**Defining Translation Scope**\n\nI\'ve scoped out the translation needs, aiming for comprehensive coverage across the application. I\'m focusing on `src/utils/translations.ts` and will cover common UI elements, mobile tabs, patient greetings, and key features like voice triage and the SOS emergency system. I\'m also including detailed translations for OPD tokens, health records, the patient profile, and the hospital admin dashboard.\n\n\n"
    tool_calls {
      id: "call_17899074140434847138"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { Language } from \'../types\';\\n\\nexport interface TranslationDictionary {\\n  // Global Header & Navigation\\n  appTitle: string;\\n  appSubtitle: string;\\n  dualScreenView: string;\\n  patientAppView: string;\\n  adminQueueView: string;\\n  monorepoView: string;\\n  liveVoiceBtn: string;\\n  aiChatBtn: string;\\n  servicesOperational: string;\\n  medicalHubLocation: string;\\n\\n  // Mobile App Header & Greeting\\n  greeting: (name: string) => string;\\n  greetingSubtitle: string;\\n  dailyHealthInsight: string;\\n  simulatedHealthConnect: string;\\n  steps: string;\\n  stepsGoal: string;\\n  sleep: string;\\n  sleepLow: string;\\n  avgHeartRate: string;\\n  restingNormal: string;\\n  insightTip: string;\\n\\n  // Mobile Primary Actions\\n  speakSymptomsTitle: string;\\n  speakSymptomsDesc: string;\\n  holdToSpeak: string;\\n  smartRxTitle: string;\\n  smartRxDesc: string;\\n  liveVoiceTitle: string;\\n  liveVoiceDesc: string;\\n  talkLive: string;\\n  aiChatTitle: string;\\n  aiChatDesc: string;\\n  openChat: string;\\n\\n  // Voice Triage Modal\\n  voiceTriageModalTitle: string;\\n  voiceTriageModalSubtitle: string;\\n  listeningSymptoms: string;\\n  analyzingGemini: string;\\n  tellUsSymptoms: string;\\n  tapToSpeak: string;\\n  stopRecording: string;\\n  processing: string;\\n  cancelRecording: string;\\n  tier1Title: string;\\n  tier2Title: string;\\n  tier3Title: string;\\n  severity: string;\\n  digitalOpdToken: string;\\n  statusLabel: string;\\n  patientInstructions: string;\\n  clinicalSummaryDoc: string;\\n  estWait: string;\\n  doneAndRecords: string;\\n  quickTestPresets: string;\\n\\n  // Prescription Scanner Modal\\n  rxModalTitle: string;\\n  rxModalSubtitle: string;\\n  snapOrUpload: string;\\n  snapDesc: string;\\n  takePhoto: string;\\n  uploadFile: string;\\n  decodingPrescription: string;\\n  safetyGuardrailTriggered: string;\\n  safetyPolicyDesc: string;\\n  extractedMedicines: string;\\n  dosage: string;\\n  duration: string;\\n  frequency: string;\\n  pharmacistVerifyNotice: string;\\n  scanAnother: string;\\n  doneBtn: string;\\n  testSamples: string;\\n  legibleSample: string;\\n  illegibleSample: string;\\n\\n  // SOS Emergency\\n  holdSosBtn: string;\\n  priority0Activated: string;\\n  emergencyDispatchLive: string;\\n  sosTicketLabel: string;\\n  hospitalAlertStage: string;\\n  localSirenStage: string;\\n  ambientAudioStage: string;\\n  gpsCoordinates: string;\\n  ambulanceHelpline: string;\\n  dial108: string;\\n  acknowledgeBtn: string;\\n\\n  // OPD Tokens\\n  activeOpdTokensTitle: string;\\n  noActiveTokens: string;\\n  noActiveTokensDesc: string;\\n  issuedAt: string;\\n  straightLineDist: string;\\n\\n  // Health Records\\n  healthRecordsTitle: string;\\n  triageRecordsTab: string;\\n  prescriptionsTab: string;\\n  sosLogsTab: string;\\n  noTriageRecords: string;\\n  noPrescriptions: string;\\n  noSosLogs: string;\\n\\n  // Patient Profile\\n  profileTitle: string;\\n  emergencyContact: string;\\n  medicalFlags: string;\\n  knownConditions: string;\\n  allergies: string;\\n  noneRecorded: string;\\n\\n  // Bottom Navigation Bar\\n  navHome: string;\\n  navChat: string;\\n  navRecords: string;\\n  navTokens: string;\\n  navProfile: string;\\n\\n  // Hospital Admin Dashboard\\n  adminCommandCenter: string;\\n  adminSubtitle: string;\\n  liveQueueBadge: string;\\n  totalPatientsToday: string;\\n  activeQueueCount: string;\\n  emergencyCasesCount: string;\\n  waitingOpdCount: string;\\n  inConsultationCount: string;\\n  queueTableHeader: string;\\n  queueTableSubheader: string;\\n  departmentFilterLabel: string;\\n  allDepartments: string;\\n  queueClearTitle: string;\\n  queueClearDesc: string;\\n  p0SosEventBadge: string;\\n  tier3EmergencyBadge: string;\\n  tier2OpdBadge: string;\\n  callbackPatientBtn: string;\\n  markResolvedBtn: string;\\n  openLocationLink: string;\\n  contactPatientBtn: string;\\n  directCallbackTitle: string;\\n  directCallbackSubtitle: string;\\n  closeBtn: string;\\n  dialNowBtn: string;\\n\\n  // Gemini Chatbot & History\\n  chatModalTitle: string;\\n  chatModalSubtitle: string;\\n  chatHistoryTitle: string;\\n  newChatBtn: string;\\n  noPastConversations: string;\\n  deleteSession: string;\\n  modelLabel: string;\\n  roleLabel: string;\\n  roleGeneral: string;\\n  roleSpecialist: string;\\n  roleFastTriage: string;\\n  chatInputPlaceholder: string;\\n  tryPrompt: string;\\n  thinkingNotice: string;\\n  clearChat: string;\\n\\n  // Gemini Live Voice\\n  liveVoiceModalTitle: string;\\n  liveVoiceListening: string;\\n  liveVoiceConnected: string;\\n  liveVoiceSpeaking: string;\\n  liveVoiceDisconnected: string;\\n  endConversationBtn: string;\\n  quickVoiceQueries: string;\\n}\\n\\nexport const translations: Record<Language, TranslationDictionary> = {\\n  // TELUGU (\340\260\244\340\261\206\340\260\262\340\261\201\340\260\227\340\261\201)\\n  te: {\\n    appTitle: \'\340\260\270\340\260\202\340\260\234\340\261\200\340\260\265\340\260\250\340\260\277 \340\260\237\340\261\215\340\260\260\340\260\257\340\260\276\340\260\234\340\261\215\',\\n    appSubtitle: \'\340\260\256\340\260\262\340\261\215\340\260\237\340\261\200\340\260\256\340\261\213\340\260\241\340\260\262\340\261\215 AI \340\260\237\340\261\215\340\260\260\340\260\257\340\260\276\340\260\234\340\261\215 \342\200\242 \340\260\252\340\261\215\340\260\260\340\260\277\340\260\270\340\261\215\340\260\225\340\261\215\340\260\260\340\260\277\340\260\252\340\261\215\340\260\267\340\260\250\340\261\215 \340\260\270\340\261\215\340\260\225\340\260\276\340\260\250\340\260\260\340\261\215 \342\200\242 2.5s SOS \342\200\242 \340\260\206\340\260\270\340\261\201\340\260\252\340\260\244\340\261\215\340\260\260\340\260\277 \340\260\225\340\261\215\340\260\257\340\261\202\',\\n    dualScreenView: \'\340\260\246\340\261\215\340\260\265\340\260\202\340\260\246\340\261\215\340\260\265 \340\260\265\340\261\200\340\260\225\340\261\215\340\26