  planner_response {
    thinking: "**Integrating Language and History**\n\nI\'m now integrating `useLanguage()` into `src/components/chat/GeminiChatbotModal.tsx` to ensure all text elements dynamically reflect the selected language. Simultaneously, I\'m working to implement a full chat history drawer. This will include a list of past sessions that are titled and timestamped.\n\n\n"
    tool_calls {
      id: "call_484722870981195294"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState, useRef, useEffect } from \'react\';\\nimport {\\n  MessageSquare,\\n  Send,\\n  X,\\n  Bot,\\n  User,\\n  Sparkles,\\n  Zap,\\n  Brain,\\n  RotateCcw,\\n  Copy,\\n  Check,\\n  History,\\n  Plus,\\n  Trash2,\\n  ChevronLeft,\\n  ChevronRight,\\n  Ticket,\\n  AlertCircle\\n} from \'lucide-react\';\\nimport { chatStorage, ChatSession, ChatMessage } from \'../../services/chatStorage\';\\nimport { useLanguage } from \'../../context/LanguageContext\';\\n\\ntype ModelType = \'gemini-3.1-flash-lite\' | \'gemini-3.8-flash\' | \'gemini-4-argon\';\\ntype RoleType = \'general\' | \'specialist\' | \'fast_triage\';\\n\\ninterface Props {\\n  isOpen: boolean;\\n  onClose: () => void;\\n  onExtractTriage?: (symptomsText: string) => void;\\n}\\n\\nexport const GeminiChatbotModal: React.FC<Props> = ({\\n  isOpen,\\n  onClose,\\n  onExtractTriage,\\n}) => {\\n  const { language, t } = useLanguage();\\n  const [selectedModel, setSelectedModel] = useState<ModelType>(\'gemini-3.8-flash\');\\n  const [selectedRole, setSelectedRole] = useState<RoleType>(\'general\');\\n  const [inputMessage, setInputMessage] = useState(\'\');\\n  const [isLoading, setIsLoading] = useState(false);\\n  const [copiedId, setCopiedId] = useState<string | null>(null);\\n  const [showHistoryDrawer, setShowHistoryDrawer] = useState(false);\\n\\n  // Chat Sessions & History State\\n  const [sessions, setSessions] = useState<ChatSession[]>([]);\\n  const [currentSessionId, setCurrentSessionId] = useState<string>(\'\');\\n  const [messages, setMessages] = useState<ChatMessage[]>([]);\\n\\n  const messagesEndRef = useRef<HTMLDivElement | null>(null);\\n\\n  useEffect(() => {\\n    if (isOpen) {\\n      loadSessions();\\n    }\\n  }, [isOpen]);\\n\\n  useEffect(() => {\\n    messagesEndRef.current?.scrollIntoView({ behavior: \'smooth\' });\\n  }, [messages, isLoading]);\\n\\n  const loadSessions = async () => {\\n    const list = await chatStorage.getSessions();\\n    setSessions(list);\\n\\n    if (list.length > 0 && !currentSessionId) {\\n      // Load most recent session\\n      loadSession(list[0]);\\n    } else if (list.length === 0) {\\n      startNewChat();\\n    }\\n  };\\n\\n  const startNewChat = () => {\\n    const newId = `session-${Date.now()}`;\\n    const initialWelcome: ChatMessage = {\\n      id: `welcome-${Date.now()}`,\\n      sender: \'assistant\',\\n      content:\\n        language === \'te\'\\n          ? \'\340\260\250\340\260\256\340\260\270\340\261\215\340\260\244\340\261\207! \340\260\250\340\261\207\340\260\250\340\261\201 \340\260\270\340\260\202\340\260\234\340\261\200\340\260\265\340\260\250\340\260\277 \340\260\271\340\261\206\340\260\262\340\261\215\340\260\244\340\261\215\342\200\214\340\260\225\340\261\207\340\260\260\340\261\215 \340\260\205\340\260\270\340\260\277\340\260\270\340\261\215\340\260\237\340\261\206\340\260\202\340\260\237\340\261\215\342\200\214\340\260\250\340\260\277. \340\260\256\340\261\200 \340\260\262\340\260\225\340\261\215\340\260\267\340\260\243\340\260\276\340\260\262\340\261\201, \340\260\256\340\260\202\340\260\246\340\261\201\340\260\262\340\261\201 \340\260\262\340\261\207\340\260\246\340\260\276 \340\260\206\340\260\270\340\261\201\340\260\252\340\260\244\340\261\215\340\260\260\340\260\277 \340\260\256\340\260\276\340\260\260\340\261\215\340\260\227\340\260\246\340\260\260\340\261\215\340\260\266\340\260\225\340\260\276\340\260\262 \340\260\227\340\261\201\340\260\260\340\260\277\340\260\202\340\260\232\340\260\277 \340\260\205\340\260\241\340\260\227\340\260\202\340\260\241\340\260\277.\'\\n          : language === \'hi\'\\n          ? \'\340\244\250\340\244\256\340\244\270\340\245\215\340\244\244\340\245\207! \340\244\256\340\245\210\340\244\202 \340\244\270\340\244\202\340\244\234\340\245\200\340\244\265\340\244\250\340\245\200 \340\244\271\340\245\207\340\244\262\340\245\215\340\244\245\340\244\225\340\245\207\340\244\257\340\244\260 \340\244\205\340\244\270\340\244\277\340\244\270\340\245\215\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\271\340\245\202\340\244\201\340\245\244 \340\244\205\340\244\252\340\244\250\340\245\207 \340\244\262\340\244\225\340\245\215\340\244\267\340\244\243, \340\244\246\340\244\265\340\244\276\340\244\207\340\244\257\340\245\213\340\244\202 \340\244\257\340\244\276 \340\244\205\340\244\270\340\245\215\340\244\252\340\244\244\340\244\276\340\244\262 \340\244\270\340\245\207 \340\244\270\340\244\202\340\244\254\340\244\202\340\244\247\340\244\277\340\244\244 \340\244\252\340\245\215\340\244\260\340\244\266\340\245\215\340\244\250 \340\244\252\340\245\202\340\244\233\340\245\207\340\244\202\340\245\244\'\\n          : \'Namaste! I am Sanjeevani Healthcare Assistant powered by Gemini. Ask me about symptoms, medicines, or hospital triage.\',\\n      modelUsed: selectedModel,\\n      timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\\n    };\\n\\n    const newSession: ChatSession = {\\n      id: newId,\\n      title: language === \'te\' ? \'\340\260\225\340\261\212\340\260\244\340\261\215\340\260\244 \340\260\270\340\260\202\340\260\255\340\260\276\340\260\267\340\260\243\' : language === \'hi\' ? \'\340\244\250\340\244\257\340\244\276 \340\244\270\340\244\202\340\244\265\340\244\276\340\244\246\' : \'New Health Chat\',\\n      model: selectedModel,\\n      role: selectedRole,\\n      messages: [initialWelcome],\\n      createdAt: new Date().toISOString(),\\n      updatedAt: new Date().toISOString(),\\n    };\\n\\n    setCurrentSessionId(newId);\\n    setMessages([initialWelcome]);\\n    setSessions((prev) => [newSession, ...prev]);\\n    setShowHistoryDrawer(false);\\n    chatStorage.saveSession(newSession);\\n  };\\n\\n  const loadSession = (session: ChatSession) => {\\n    setCurrentSessionId(session.id);\\n    setSelectedModel(session.model);\\n    setSelectedRole(session.role);\\n    setMessages(session.messages);\\n    setShowHistoryDrawer(false);\\n  };\\n\\n  const deleteSession = async (sessionId: string, e: React.MouseEvent) => {\\n    e.stopPropagation();\\n    await chatStorage.deleteSession(sessionId);\\n    const updated = sessions.filter((s) => s.id !== sessionId);\\n    setSessions(updated);\\n\\n    if (currentSessionId === sessionId) {\\n      if (updated.length > 0) {\\n        loadSession(updated[0]);\\n      } else {\\n        startNewChat();\\n      }\\n    }\\n  };\\n\\n  const handleSendMessage = async (e?: React.FormEvent) => {\\n    if (e) e.preventDefault();\\n    if (!inputMessage.trim() || isLoading) return;\\n\\n    const userText = inputMessage.trim();\\n    setInputMessage(\'\');\\n\\n    const userMsg: ChatMessage = {\\n      id: `msg-${Date.now()}`,\\n      sender: \'user\',\\n      content: userText,\\n      timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\\n    };\\n\\n    const updatedMessages = [...messages, userMsg];\\n    setMessages(updatedMessages);\\n    setIsLoading(true);\\n\\n    try {\\n      const chatHistory = updatedMessages.map((m) => ({\\n        role: m.sender === \'user\' ? (\'user\' as const) : (\'model\' as const),\\n        content: m.content,\\n      }));\\n\\n      const res = await fetch(\'/api/v1/chat\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({\\n          messages: chatHistory,\\n          model: selectedModel,\\n          role: selectedRole,\\n        }),\\n      });\\n\\n      const data = await res.json();\\n      const botReply = data.success ? data.reply : \'I could not process your query at this moment.\';\\n      const usedModel = data.modelUsed || selectedModel;\\n\\n      const botMsg: ChatMessage = {\\n        id: `msg-${Date.now()}-ai`,\\n        sender: \'assistant\',\\n        content: botReply,\\n        modelUsed: usedModel,\\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\\n      };\\n\\n      const finalMessages = [...updatedMessages, botMsg];\\n      setMessages(finalMessages);\\n\\n      // Save to active session\\n      const activeSession = sessions.find((s) => s.id === currentSessionId);\\n      const sessionTitle =\\n        activeSession?.title && !activeSession.title.includes(\'New\') && !activeSession.title.includes(\'\340\260\225\340\261\212\340\260\244\340\261\215\340\260\244\')\\n          ? activeSession.title\\n          : userText.slice(0, 32);\\n\\n      const savedSession: ChatSession = {\\n        id: currentSessionId,\\n        title: sessionTitle,\\n        model: selectedModel,\\n        role: selectedRole,\\n        messages: finalMessages,\\n        createdAt: activeSession?.createdAt || new Date().toISOString(),\\n        updatedAt: new Date().toISOString(),\\n      };\\n\\n      setSessions((prev) =>\\n        prev.map((s) => (s.id === currentSessionId ? savedSession : s))\\n      );\\n      chatStorage.saveSession(savedSession);\\n    } catch (err: any) {\\n      console.error(\'Chat error:\', err);\\n    } finally {\\n      setIsLoading(false);\\n    }\\n  };\\n\\n  const handleCopy = (text: string, id: string) => {\\n    navigator.clipboard.writeText(text);\\n    setCopiedId(id);\\n    setTimeout(() => setCopiedId(null), 2000);\\n  };\\n\\n  if (!isOpen) return null;\\n\\n  return (\\n    <div className=\\\"fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-end sm:items-center justify-center p-0 sm:p-4\\\">\\n      <div className=\\\"bg-white w-full max-w-2xl rounded-t-3xl sm:rounded-3xl shadow-2xl h-[92vh] sm:h-[780px] flex flex-col overflow-hidden relative\\\">\\n        {/* Top Header */}\\n        <div className=\\\"bg-slate-900 text-white p-4 sm:p-5 flex items-center justify-between shrink-0\\\">\\n          <div className=\\\"flex items-center gap-3\\\">\\n            <button\\n              onClick={() => setShowHistoryDrawer((prev) => !prev)}\\n              className={`p-2 rounded-xl transition flex items-center gap-1.5 text-xs font-semibold ${\\n                showHistoryDrawer\\n                  ? \'bg-teal-600 text-white\'\\n                  : \'bg-slate-800 hover:bg-slate-700 text-slate-300\'\\n              }`}\\n              title=\\\"Toggle Chat History Drawer\\\"\\n            >\\n              <History className=\\\"w-4 h-4\\\" />\\n              <span className=\\\"hidden sm:inline\\\">{t.chatHistoryTitle}</span>\\n              <span className=\\\"text-[10px] bg-slate-700 px-1.5 py-0.2 rounded-full\\\">\\n                {sessions.length}\\n              </span>\\n            </button>\\n\\n            <div>\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <h2 className=\\\"text-sm sm:text-base font-extrabold tracking-tight\\\">\\n                  {t.chatModalTitle}\\n                </h2>\\n                <span className=\\\"text-[9px] font-bold bg-teal-500/20 text-teal-300 border border-teal-500/30 px-1.5 py-0.2 rounded-full\\\">\\n                  Firestore Synced\\n                </span>\\n              </div>\\n              <p className=\\\"text-[10px] text-slate-400 truncate max-w-[200px] sm:max-w-xs\\\">\\n                {t.chatModalSubtitle}\\n              </p>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <button\\n              onClick={startNewChat}\\n              className=\\\"px-2.5 py-1.5 bg-teal-600 hover:bg-teal-700 text-white rounded-xl text-xs font-bold transition flex items-center gap-1 shadow-xs\\\"\\n              title=\\\"Start New Chat Thread\\\"\\n            >\\n              <Plus className=\\\"w-3.5 h-3.5\\\" />\\n              <span className=\\\"hidden sm:inline\\\">{t.newChatBtn}</span>\\n            </button>\\n\\n            <button\\n              onClick={onClose}\\n              className=\\\"w-8 h-8 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center transition\\\"\\n            >\\n              <X className=\\\"w-4 h-4\\\" />\\n            </button>\\n          </div>\\n        </div>\\n\\n        {/* Model & Role Controls Bar */}\\n        <div className=\\\"bg-slate-50 border-b border-slate-200 px-4 py-2.5 flex flex-wrap items-center justify-between gap-2 shrink-0 text-xs\\\">\\n          {/* Model Selector */}\\n          <div className=\\\"flex items-center gap-1.5\\\">\\n            <span className=\\\"text-slate-500 font-bold text-[11px]\\\">{t.modelLabel}</span>\\n            <div className=\\\"flex bg-white border border-slate-200 rounded-xl p-0.5 shadow-2xs\\\">\\n              <button\\n                onClick={() => setSelectedModel(\'gemini-3.1-flash-lite\')}\\n                className={`px-2 py-0.5 rounded-lg text-[10px] font-bold flex items-center gap-1 transition ${\\n                  selectedModel === \'gemini-3.1-flash-lite\'\\n                    ? \'bg-amber-100 text-amber-900 border border-amber-300 shadow-2xs\'\\n                    : \'text-slate-600 hover:text-slate-900\'\\n                }`}\\n              >\\n                <Zap className=\\\"w-2.5 h-2.5 text-amber-600\\\" /> Fast Lite\\n              </button>\\n              <button\\n                onClick={() => setSelectedModel(\'gemini-3.8-flash\')}\\n                className={`px-2 py-0.5 rounded-lg text-[10px] font-bold flex items-center gap-1 transition ${\\n                  selectedModel === \'gemini-3.8-flash\'\\n                    ? \'bg-teal-600 text-white shadow-2xs\'\\n                    : \'text-slate-600 hover:text-slate-900\'\\n                }`}\\n              >\\n                <Sparkles className=\\\"w-2.5 h-2.5\\\" /> General 3.8\\n              </button>\\n              <button\\n                onClick={() => setSelectedModel(\'gemini-4-argon\')}\\n                className={`px-2 py-0.5 rounded-lg text-[10px] font-bold flex items-center gap-1 transition ${\\n                  selectedModel === \'gemini-4-argon\'\\n                    ? \'bg-indigo-600 text-white shadow-2xs\'\\n                    : \'text-slate-600 hover:text-slate-900\'\\n                }`}\\n              >\\n                <Brain className=\\\"w-2.5 h-2.5\\\" /> Complex 4\\n              </button>\\n            </div>\\n          </div>\\n\\n          {/* Role Selector */}\\n          <div className=\\\"flex items-center gap-1.5\\\">\\n            <span className=\\\"text-slate-500 font-bold text-[11px]\\\">{t.roleLabel}</span>\\n            <select\\n              value={selectedRole}\\n              onChange={(e) => setSelectedRole(e.target.value as RoleType)}\\n              className=\\\"bg-white border border-slate-200 rounded-xl px-2.5 py-1 text-[11px] font-semibold text-slate-800 focus:outline-teal-600\\\"\\n            >\\n              <option value=\\\"general\\\">{t.roleGeneral}</option>\\n              <option value=\\\"specialist\\\">{t.roleSpecialist}</option>\\n              <option value=\\\"fast_triage\\\">{t.roleFastTriage}</option>\\n            </select>\\n          </div>\\n        </div>\\n\\n        {/* Main Content Area (Chat Feed + Slide-in History Drawer) */}\\n        <div className=\\\"flex-1 flex overflow-hidden relative\\\">\\n          {/* Slide-out Chat History Drawer */}\\n          {showHistoryDrawer && (\\n            <div className=\\\"absolute inset-y-0 left-0 z-30 w-72 bg-slate-900 text-white border-r border-slate-800 p-4 flex flex-col shadow-2xl transition-all\\\">\\n              <div className=\\\"flex items-center justify-between pb-3 border-b border-slate-800 mb-3\\\">\\n                <span className=\\\"text-xs font-bold uppercase tracking-wider text-teal-400 flex items-center gap-1.5\\\">\\n                  <History className=\\\"w-3.5 h-3.5\\\" /> {t.chatHistoryTitle}\\n                </span>\\n                <button\\n                  onClick={() => setShowHistoryDrawer(false)}\\n                  className=\\\"text-slate-400 hover:text-white\\\"\\n                >\\n                  <ChevronLeft className=\\\"w-4 h-4\\\" />\\n                </button>\\n              </div>\\n\\n              <button\\n                onClick={startNewChat}\\n                className=\\\"w-full py-2 bg-teal-600 hover:bg-teal-700 text-white rounded-xl text-xs font-bold mb-3 flex items-center justify-center gap-1.5 shadow-xs transition\\\"\\n              >\\n                <Plus className=\\\"w-3.5 h-3.5\\\" /> {t.newChatBtn}\\n              </button>\\n\\n              <div className=\\\"flex-1 overflow-y-auto space-y-1.5 pr-1\\\">\\n                {sessions.length === 0 ? (\\n                  <div className=\\\"text-center py-8 text-xs text-slate-500\\\">\\n                    {t.noPastConversations}\\n                  </div>\\n                ) : (\\n                  sessions.map((sess) => (\\n                    <div\\n                      key={sess.id}\\n                      onClick={() => loadSession(sess)}\\n                      className={`p-2.5 rounded-xl text-xs cursor-pointer transition flex items-center justify-between group ${\\n                        sess.id === currentSessionId\\n                          ? \'bg-slate-800 border border-teal-500 text-white\'\\n                          : \'hover:bg-slate-800/60 text-slate-300\'\\n                      }`}\\n                    >\\n                      <div className=\\\"flex-1 min-w-0 pr-2\\\">\\n                        <div className=\\\"font-semibold truncate\\\">{sess.title}</div>\\n                        <div className=\\\"text-[10px] text-slate-500 flex items-center gap-2 mt-0.5\\\">\\n                          <span>{new Date(sess.updatedAt).toLocaleDateString([], { month: \'short\', day: \'numeric\' })}</span>\\n                          <span>\342\200\242</span>\\n                          <span>{sess.messages.length} msgs</span>\\n                        </div>\\n                      </div>\\n\\n                      <button\\n                        onClick={(e) => deleteSession(sess.id, e)}\\n                        className=\\\"opacity-0 group-hover:opacity-100 p-1 text-slate-500 hover:text-rose-400 transition\\\"\\n                        title={t.deleteSession}\\n                      >\\n                        <Trash2 className=\\\"w-3.5 h-3.5\\\" />\\n                      </button>\\n                    </div>\\n                  ))\\n                )}\\n              </div>\\n            </div>\\n          )}\\n\\n          {/* Chat Messages Feed */}\\n          <div className=\\\"flex-1 overflow-y-auto p-4 sm:p-6 space-y-4 text-left\\\">\\n            {messages.map((m) => (\\n              <div\\n                key={m.id}\\n                className={`flex flex-col ${m.sender === \'user\' ? \'items-end\' : \'items-start\'}`}\\n              >\\n                <div\\n                  className={`max-w-[85%] rounded-3xl p-4 text-xs leading-relaxed shadow-xs relative group ${\\n                    m.sender === \'user\'\\n                      ? \'bg-teal-600 text-white rounded-br-xs\'\\n                      : \'bg-slate-100 text-slate-900 border border-slate-200/80 rounded-bl-xs\'\\n                  }`}\\n                >\\n                  <div className=\\\"whitespace-pre-wrap\\\">{m.content}</div>\\n\\n                  <div\\n                    className={`flex items-center justify-between gap-3 mt-2 pt-1 border-t text-[10px] font-mono ${\\n                      m.sender === \'user\'\\n                        ? \'border-teal-500 text-teal-200\'\\n                        : \'border-slate-200 text-slate-400\'\\n                    }`}\\n                  >\\n                    <span>{m.timestamp}</span>\\n                    {m.modelUsed && <span>{m.modelUsed}</span>}\\n                    <button\\n                      onClick={() => handleCopy(m.content, m.id)}\\n                      className=\\\"opacity-0 group-hover:opacity-100 transition p-0.5 hover:text-white\\\"\\n                      title=\\\"Copy\\\"\\n                    >\\n                      {copiedId === m.id ? (\\n                        <Check className=\\\"w-3 h-3 text-emerald-400\\\" />\\n                      ) : (\\n                        <Copy className=\\\"w-3 h-3\\\" />\\n                      )}\\n                    </button>\\n                  </div>\\n                </div>\\n\\n                {/* If assistant gave a medical triage recommendation, provide quick action to get OPD token */}\\n                {m.sender === \'assistant\' && onExtractTriage && (\\n                  <button\\n                    onClick={() => {\\n                      onClose();\\n                      onExtractTriage(m.content);\\n                    }}\\n                    className=\\\"mt-1 text-[11px] text-teal-700 hover:underline font-semibold flex items-center gap-1 self-start ml-2\\\"\\n                  >\\n                    <Ticket className=\\\"w-3.5 h-3.5\\\" /> {language === \'te\' ? \'\340\260\246\340\261\200\340\260\250\340\260\277 \340\260\250\340\261\201\340\260\202\340\260\241\340\260\277 \340\260\223\340\260\252\340\261\200\340\260\241\340\261\200 \340\260\237\340\261\213\340\260\225\340\261\206\340\260\250\340\261\215 \340\260\252\340\261\212\340\260\202\340\260\246\340\260\202\340\260\241\340\260\277\' : language === \'hi\' ? \'\340\244\207\340\244\270\340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 OPD \340\244\237\340\245\213\340\244\225\340\244\250 \340\244\262\340\245\207\340\244\202\' : \'Generate OPD Token for this\'}\\n                  </button>\\n                )}\\n              </div>\\n            ))}\\n\\n            {isLoading && (\\n              <div className=\\\"flex items-start gap-2\\\">\\n                <div className=\\\"bg-slate-100 border border-slate-200 rounded-2xl p-3.5 text-xs text-slate-500 flex items-center gap-2\\\">\\n                  <span className=\\\"w-2 h-2 rounded-full bg-teal-500 animate-pulse\\\" />\\n                  <span>{t.thinkingNotice} ({selectedModel})</span>\\n                </div>\\n              </div>\\n            )}\\n\\n            <div ref={messagesEndRef} />\\n          </div>\\n        </div>\\n\\n        {/* Suggested Quick Prompts */}\\n        <div className=\\\"px-4 py-2 bg-slate-50 border-t border-slate-200 flex items-center gap-2 overflow-x-auto text-[11px] shrink-0\\\">\\n          <span className=\\\"text-slate-400 font-bold shrink-0\\\">{t.tryPrompt}</span>\\n          <button\\n            onClick={() => setInputMessage(\\n              language === \'te\'\\n                ? \'\340\260\250\340\260\276\340\260\225\340\261\201 \340\260\227\340\260\244 \340\260\260\340\261\206\340\260\202\340\260\241\340\261\201 \340\260\260\340\261\213\340\260\234\340\261\201\340\260\262 \340\260\250\340\261\201\340\260\202\340\260\241\340\260\277 \340\260\234\340\261\215\340\260\265\340\260\260\340\260\202 \340\260\256\340\260\260\340\260\277\340\260\257\340\261\201 \340\260\244\340\261\200\340\260\265\340\261\215\340\260\260\340\260\256\340\261\210\340\260\250 \340\260\225\340\260\241\340\261\201\340\260\252\340\261\201 \340\260\250\340\261\212\340\260\252\340\261\215\340\260\252\340\260\277 \340\260\211\340\260\202\340\260\246\340\260\277\'\\n                : language === \'hi\'\\n                ? \'\340\244\256\340\245\201\340\244\235\340\245\207 \340\244\252\340\244\277\340\244\233\340\244\262\340\245\207 \340\244\246\340\245\213 \340\244\246\340\244\277\340\244\250\340\245\213\340\244\202 \340\244\270\340\245\207 \340\244\254\340\245\201\340\244\226\340\244\276\340\244\260 \340\244\224\340\244\260 \340\244\252\340\245\207\340\244\237 \340\244\256\340\245\207\340\244\202 \340\244\244\340\245\207\340\244\234 \340\244\246\340\244\260\340\245\215\340\244\246 \340\244\271\340\245\210\'\\n                : \'I have persistent fever and severe abdominal pain for 2 days\'\\n            )}\\n            className=\\\"px-2.5 py-1 bg-white border border-slate-200 rounded-lg text-slate-700 hover:border-teal-400 shrink-0 text-left\\\"\\n          >\\n            {language === \'te\' ? \'\340\260\234\340\261\215\340\260\265\340\260\260\340\260\202 & \340\260\225\340\260\241\340\261\201\340\260\252\340\261\201 \340\260\250\340\261\212\340\260\252\340\261\215\340\260\252\340\260\277\' : language === \'hi\' ? \'\340\244\254\340\245\201\340\244\226\340\244\276\340\244\260 \340\244\224\340\244\260 \340\244\252\340\245\207\340\244\237 \340\244\246\340\244\260\340\245\215\340\244\246\' : \'Fever & abdominal pain\'}\\n          </button>\\n          <button\\n            onClick={() => setInputMessage(\\n              language === \'te\'\\n                ? \'\340\260\252\340\260\276\340\260\260\340\260\276\340\260\270\340\261\206\340\260\237\340\260\256\340\260\276\340\260\262\340\261\215 650 \340\260\265\340\261\207\340\260\270\340\261\201\340\260\225\340\261\201\340\260\250\340\261\215\340\260\250 \340\260\244\340\260\260\340\261\215\340\260\265\340\260\276\340\260\244 \340\260\216\340\260\250\340\261\215\340\260\250\340\260\277 \340\260\227\340\260\202\340\260\237\340\260\262\340\260\225\340\261\201 \340\260\256\340\260\263\340\261\215\340\260\262\340\261\200 \340\260\265\340\261\207\340\260\270\340\261\201\340\260\225\340\261\213\340\260\265\340\260\276\340\260\262\340\260\277?\'\\n                : language === \'hi\'\\n                ? \'\340\244\252\340\245\210\340\244\260\340\244\276\340\244\270\340\244\277\340\244\237\340\244\276\340\244\256\340\245\213\340\244\262 650 \340\244\225\340\244\277\340\244\244\340\244\250\340\245\207 \340\244\230\340\244\202\340\244\237\340\245\207 \340\244\254\340\244\276\340\244\246 \340\244\246\340\245\213\340\244\254\340\244\276\340\244\260\340\244\276 \340\244\262\340\245\207 \340\244\270\340\244\225\340\244\244\340\245\207 \340\244\271\340\245\210\340\244\202?\'\\n                : \'What is the safe interval between Paracetamol 650 dosages?\'\\n            )}\\n            className=\\\"px-2.5 py-1 bg-white border border-slate-200 rounded-lg text-slate-700 hover:border-teal-400 shrink-0 text-left\\\"\\n          >\\n            {language === \'te\' ? \'\340\260\256\340\260\202\340\260\246\340\261\201\340\260\262 \340\260\256\340\261\213\340\260\244\340\260\276\340\260\246\340\261\201 \340\260\252\340\261\215\340\260\260\340\260\266\340\261\215\340\260\250\' : language === \'hi\' ? \'\340\244\246\340\244\265\340\244\276 \340\244\226\340\245\201\340\244\260\340\244\276\340\244\225 \340\244\250\340\244\277\340\244\257\340\244\256\' : \'Paracetamol dosage check\'}\\n          </button>\\n        </div>\\n\\n        {/* Chat Input Bar */}\\n        <form onSubmit={handleSendMessage} className=\\\"p-3 bg-white border-t border-slate-200 flex items-center gap-2 shrink-0\\\">\\n          <input\\n            type=\\\"text\\\"\\n            value={inputMessage}\\n            onChange={(e) => setInputMessage(e.target.value)}\\n            placeholder={t.chatInputPlaceholder}\\n            className=\\\"flex-1 bg-slate-50 border border-slate-300 focus:border-teal-600 focus:bg-white rounded-2xl px-4 py-2.5 text-xs text-slate-900 focus:outline-none transition\\\"\\n          />\\n          <button\\n            type=\\\"submit\\\"\\n            disabled={!inputMessage.trim() || isLoading}\\n            className={`w-10 h-10 rounded-2xl flex items-center justify-center transition shadow-xs ${\\n              !inputMessage.trim() || isLoading\\n                ? \'bg-slate-200 text-slate-400 cursor-not-allowed\'\\n                : \'bg-teal-600 text-white hover:bg-teal-700\'\\n            }`}\\n          >\\n            <Send className=\\\"w-4 h-4\\\" />\\n          </button>\\n        </form>\\n      </div>\\n    </div>\\n  );\\n};\\n\",\"Description\":\"Rebuild GeminiChatbotModal with multi-turn chat history drawer, session management, Firestore sync, and full language support\",\"Overwrite\":true,\"TargetFile\":\"/src/components/chat/GeminiChatbotModal.tsx\",\"toolAction\":\"Writing upgraded Gemini chatbot component\",\"toolSummary\":\"Upgraded Gemini chatbot with chat history\"}"
      thinking_signature: "\022\213\t\n\210\t\001i\024}\023\245\313<\n-\037\206q\313}\377\324|L\277\220\206\":\300G\001V\307)\251\375&Y\211&\277\216\376\253@4\250\351\354la\244\231\225\352\340\313\217\217u\r\307\345\243\303\3644\t\0277\321hH\305(\376>A\215\375\247c3p5?R\332VS\310\216\313h\222\201\342\261cs\305\304\202\2145B\037\333`\303\264/a\336p5\240\221\034{\362\026\257\224\275\a\376\205\366\352\022v\216<\272\345{6m\323\256\275qb\027\177\352\001G\325\234\033\201\244\016\0372\304\331\335VTIDR\002V\305 \245\222k\t\216\btP\032\304\307\262\216\266\347K0t\343>BS0\301x\177\330a\253\360\267\211\300\213M>z\234\273\276\371\267de)\321\307|\336\235\3457rs\206\177\023P\333\376\360\320\315H\341\2122\266\265\022\344\207\304\363M?\026v\245\376\260\036\332K\003\301\375uZ\232\266-\364\0026Q\366\342\374\b\201n\025\252n\3441\t\256\031Y\202\345\224c\360\365\321\223\3233\263\232\377\206\233\017\231R\027\257\375\304\030<N\256~_\307\a\0324\354,lf\334`\221\312\035\327\257\343\371\022\356qH\271\320\343Ta\356R\222\305\335\002\035\227\344\2433\3213\365\3736l\037\237>\016\244\262\247\317\266\227\215BV\274\030\237\350\336\214\224\005\361P\271\240\333\020\322\332T\213\377[\250\214Z\023\374\373\304\226\023\327p\005Wd\341u\376\324\214]L\030\\,JF _\\\330W):\331)\205~\374\315%\2338\223\357S`\032\303\020\343\252\204\373\341\030\0041y_\264\327o\257\215\346\034&\002\222\306\3238\362\303(\232\210\233\221\330\242\341\365s\250\312U\232\354\367\020jJ\037k\337u\201\245\321\354lA\\\332\304\377rEg<\265\224\251\337\207\242M\371l\bE\207\241f\310\0217?\310\353)\006>0\242\225\304%\360\377\372\017P\3702\004\234\246\357\266\035\212\317\266q\347 9\005\301\232\r{`q(\325=J\"be\330\234\026G\037\350\005t\006\352\315\3071a\205\344\374rw\200\b\024\037[\200%\261\332\333\r\315\360\200\003g\227Wp@Im`\224\213\330H\215jX\326c\200\250\b\206\214\334\f\230*\035\300\220\322\f\'\370Z\024\2532\"}\227\267S\347\245\321\361\236=\322x\006\274s\024\203@\212\352?PE\307\364\272%\374t(\256\266\221IT\372\246\036\006V\343\320\376\300#\275\225\004\247J\260\037\020\336\337\207o\233[\271\t\3033\241g\255.\204\204\205\237\361\244L\\I3\340OQ\235\216\335\v@\016\0233irh\244\274\323\307|)\243|\r\205S3\370\300\222\217Tg\206M\254\340\330\333]\234\220.\373\304\244\210\302\270\232\000\350&\325\201\353~\032\230\354\2352N\327\224Kc\227\204\343\257~\016\340\257\325\356\346=\300\250\213H\331\231\250\211\225?\240\205\213\267q\345j\\\327\205u\223D1\255>Z_\024d\002\247\233\273y\307\017\350\273\030\274\376\311P\313A\032\321\2535z\264\332\344\323\356\252$\275\213\224\\\273U\373l5\224m\267\307\336\345\0051\355\276\260\226\327\216;\350\034\360e\230\027r\004\034\310ch*w$\245\264\271*R\304<\242\t\252\032\347n~\023\324jg\322\207]\374\033\277_&>L\025\"\022\321\322\274\212\316\366g\207)\213p\000\314=pn\343o\341\202\243J\006u\227,w\236X\vV\345\272\221\321E\357\212\335t\331)\006\016\001\306?\017\307\223f\320\2705\027\b\3713\336\353\364\313x\240O\235\335\252\376q\255\341p\3065\"p!K\003\001\fq1-\371=\366\2718\216\353Q\246\236\026gp\336\267n\330\370w\005\021\226k\324\3273\357\270\020G\240\256M\256\000n\324<q\037<\256\247\033\256\327K\246\245IG\017O7\310\277\"*H\320\311HlR\226V\373\316T\316\203\3124\001\355\225\311sq\243\022\030\230?9\\\354U-\327\376P\305{y,k\b\245b6\232\304+6\230c\376\276\212D\214\376_/\357\322\343\313P\370{\003\230\3613\240\373j\215\024\\g\267;\333\223/1\005\277\021_\314\364\335\000!]\257VQC\222-\240\032\225\030\362\237}~)8\276\037"
