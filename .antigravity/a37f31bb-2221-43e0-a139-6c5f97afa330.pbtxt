        replacement_chunks {
          target_content: "import React from \'react\';\nimport { MobileAppView } from \'./mobile/MobileAppView\';\nimport { HospitalAdminView } from \'./admin/HospitalAdminView\';\nimport { Sparkles, ArrowRight } from \'lucide-react\';\n\ninterface Props {\n  onRefreshTrigger?: () => void;\n}\n\nexport const SplitView: React.FC<Props> = ({ onRefreshTrigger }) => {\n  return (\n    <div className=\"w-full max-w-[1700px] mx-auto p-2 sm:p-4\">\n      {/* Informational banner */}\n      <div className=\"bg-gradient-to-r from-teal-900 via-slate-900 to-indigo-950 text-white rounded-3xl p-4 sm:p-5 mb-6 shadow-md border border-teal-500/20 flex flex-col md:flex-row md:items-center justify-between gap-3\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-9 h-9 rounded-2xl bg-teal-500/20 text-teal-400 flex items-center justify-center shrink-0\">\n            <Sparkles className=\"w-5 h-5\" />\n          </div>\n          <div>\n            <h3 className=\"text-sm font-bold text-white\">Interactive End-to-End Simulation Mode</h3>\n            <p className=\"text-xs text-slate-300\">\n              Trigger a Voice Triage or 2.5s Emergency SOS on the Patient Mobile App (Left) and observe instant real-time severity sorting on the Hospital Admin Dashboard (Right).\n            </p>\n          </div>\n        </div>\n        <div className=\"text-xs text-teal-300 font-mono flex items-center gap-2\">\n          <span>Real-time SSE Gateway Active</span>\n          <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\" />\n        </div>\n      </div>\n"
          replacement_content: "import React from \'react\';\nimport { MobileAppView } from \'./mobile/MobileAppView\';\nimport { HospitalAdminView } from \'./admin/HospitalAdminView\';\nimport { Sparkles, ArrowRight } from \'lucide-react\';\nimport { useLanguage } from \'../context/LanguageContext\';\n\ninterface Props {\n  onRefreshTrigger?: () => void;\n}\n\nexport const SplitView: React.FC<Props> = ({ onRefreshTrigger }) => {\n  const { language } = useLanguage();\n\n  const title =\n    language === \'te\'\n      ? \'\340\260\207\340\260\202\340\260\237\340\260\260\340\260\276\340\260\225\340\261\215\340\260\237\340\260\277\340\260\265\340\261\215 \340\260\216\340\260\202\340\260\241\340\261\215-\340\260\237\340\261\201-\340\260\216\340\260\202\340\260\241\340\261\215 \340\260\270\340\260\277\340\260\256\340\261\215\340\260\257\340\261\201\340\260\262\340\261\207\340\260\267\340\260\250\340\261\215 \340\260\256\340\261\213\340\260\241\340\261\215\'\n      : language === \'hi\'\n      ? \'\340\244\207\340\244\202\340\244\237\340\244\260\340\245\210\340\244\225\340\245\215\340\244\237\340\244\277\340\244\265 \340\244\217\340\244\202\340\244\241-\340\244\237\340\245\202-\340\244\217\340\244\202\340\244\241 \340\244\270\340\244\277\340\244\256\340\245\201\340\244\262\340\245\207\340\244\266\340\244\250 \340\244\256\340\245\213\340\244\241\'\n      : \'Interactive End-to-End Simulation Mode\';\n\n  const desc =\n    language === \'te\'\n      ? \'\340\260\260\340\261\213\340\260\227\340\260\277 \340\260\256\340\261\212\340\260\254\340\261\210\340\260\262\340\261\215 \340\260\257\340\260\276\340\260\252\340\261\215\342\200\214\340\260\262\340\261\213 (\340\260\216\340\260\241\340\260\256\340\260\265\340\261\210\340\260\252\340\261\201) \340\260\265\340\260\276\340\260\257\340\260\277\340\260\270\340\261\215 \340\260\237\340\261\215\340\260\260\340\260\257\340\260\276\340\260\234\340\261\215 \340\260\262\340\261\207\340\260\246\340\260\276 2.5s \340\260\216\340\260\256\340\260\260\340\261\215\340\260\234\340\261\206\340\260\250\340\261\215\340\260\270\340\261\200 SOS \340\260\252\340\261\215\340\260\260\340\260\276\340\260\260\340\260\202\340\260\255\340\260\277\340\260\202\340\260\232\340\260\202\340\260\241\340\260\277 \340\260\256\340\260\260\340\260\277\340\260\257\340\261\201 \340\260\206\340\260\270\340\261\201\340\260\252\340\260\244\340\261\215\340\260\260\340\260\277 \340\260\205\340\260\241\340\261\215\340\260\256\340\260\277\340\260\250\340\261\215 \340\260\241\340\261\215\340\260\257\340\260\276\340\260\267\340\261\215\342\200\214\340\260\254\340\261\213\340\260\260\340\261\215\340\260\241\340\261\215\342\200\214\340\260\262\340\261\213 (\340\260\225\340\261\201\340\260\241\340\260\277\340\260\265\340\261\210\340\260\252\340\261\201) \340\260\260\340\260\277\340\260\257\340\260\262\340\261\215-\340\260\237\340\261\210\340\260\256\340\261\215 \340\260\252\340\261\215\340\260\260\340\260\276\340\260\247\340\260\276\340\260\250\340\261\215\340\260\257\340\260\244 \340\260\270\340\260\276\340\260\260\340\261\215\340\260\237\340\260\277\340\260\202\340\260\227\340\261\215\342\200\214\340\260\250\340\261\201 \340\260\227\340\260\256\340\260\250\340\260\277\340\260\202\340\260\232\340\260\202\340\260\241\340\260\277.\'\n      : language === \'hi\'\n      ? \'\340\244\256\340\244\260\340\245\200\340\244\234\340\244\274 \340\244\256\340\245\213\340\244\254\340\244\276\340\244\207\340\244\262 \340\244\220\340\244\252 (\340\244\254\340\244\276\340\244\217\340\244\202) \340\244\252\340\244\260 \340\244\265\340\245\211\340\244\257\340\244\270 \340\244\237\340\245\215\340\244\260\340\244\276\340\244\207\340\244\217\340\244\234 \340\244\257\340\244\276 2.5s \340\244\207\340\244\256\340\244\260\340\244\234\340\245\207\340\244\202\340\244\270\340\245\200 SOS \340\244\266\340\245\201\340\244\260\340\245\202 \340\244\225\340\244\260\340\245\207\340\244\202 \340\244\224\340\244\260 \340\244\205\340\244\270\340\245\215\340\244\252\340\244\244\340\244\276\340\244\262 \340\244\265\340\245\215\340\244\257\340\244\265\340\244\270\340\245\215\340\244\245\340\244\276\340\244\252\340\244\225 \340\244\241\340\245\210\340\244\266\340\244\254\340\245\213\340\244\260\340\245\215\340\244\241 (\340\244\246\340\244\276\340\244\217\340\244\202) \340\244\252\340\244\260 \340\244\260\340\245\200\340\244\257\340\244\262-\340\244\237\340\244\276\340\244\207\340\244\256 \340\244\227\340\244\202\340\244\255\340\245\200\340\244\260\340\244\244\340\244\276 \340\244\252\340\245\215\340\244\260\340\244\276\340\244\245\340\244\256\340\244\277\340\244\225\340\244\244\340\244\276 \340\244\246\340\245\207\340\244\226\340\245\207\340\244\202\340\245\244\'\n      : \'Trigger a Voice Triage or 2.5s Emergency SOS on the Patient Mobile App (Left) and observe instant real-time severity sorting on the Hospital Admin Dashboard (Right).\';\n\n  return (\n    <div className=\"w-full max-w-[1700px] mx-auto p-2 sm:p-4\">\n      {/* Informational banner */}\n      <div className=\"bg-gradient-to-r from-teal-900 via-slate-900 to-indigo-950 text-white rounded-3xl p-4 sm:p-5 mb-6 shadow-md border border-teal-500/20 flex flex-col md:flex-row md:items-center justify-between gap-3\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-9 h-9 rounded-2xl bg-teal-500/20 text-teal-400 flex items-center justify-center shrink-0\">\n            <Sparkles className=\"w-5 h-5\" />\n          </div>\n          <div>\n            <h3 className=\"text-sm font-bold text-white\">{title}</h3>\n            <p className=\"text-xs text-slate-300\">\n              {desc}\n            </p>\n          </div>\n        </div>\n        <div className=\"text-xs text-teal-300 font-mono flex items-center gap-2\">\n          <span>Real-time SSE Gateway Active</span>\n          <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\" />\n        </div>\n      </div>\n"
          start_line: 1
          end_line: 30
        }
      }
