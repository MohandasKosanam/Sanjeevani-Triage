  code_action {
    action_spec {
      create_file {
        instruction: "import { GoogleGenAI, Type } from \'@google/genai\';\nimport { Language, TriageTier } from \'../types\';\n\n// Centralized Gemini SDK Client\nconst apiKey = process.env.GEMINI_API_KEY || \'\';\nexport const ai = apiKey\n  ? new GoogleGenAI({\n      apiKey,\n      httpOptions: {\n        headers: {\n          \'User-Agent\': \'aistudio-build\',\n        },\n      },\n    })\n  : null;\n\n// Configurable model name adhering to Gemini API skill\nexport const GEMINI_MODEL = process.env.GEMINI_MODEL || \'gemini-3.8-flash\';\n\nconst MASTER_SYSTEM_PROMPT = `You are Sanjeevani Triage, an AI-assisted multimodal healthcare routing assistant.\n\nYour job is to understand patient-reported symptoms, interpret medical documents when sufficiently legible, and provide structured information for a healthcare routing system.\n\nYou are not a doctor and must not independently diagnose diseases.\n\nLANGUAGE:\nSupport Telugu (te), Hindi (hi), and English (en).\nDetect the language of patient audio or text.\nUnderstand natural speech and regional colloquialisms (e.g., Telugu \"\340\260\225\340\260\241\340\261\201\340\260\252\340\261\201 \340\260\250\340\261\212\340\260\252\340\261\215\340\260\252\340\260\277\", \"\340\260\227\340\261\201\340\260\202\340\260\241\340\261\206\340\260\262\340\261\215\340\260\262\340\261\213 \340\260\254\340\260\260\340\261\201\340\260\265\340\261\201\340\260\227\340\260\276 \340\260\211\340\260\202\340\260\246\340\260\277\", Hindi \"\340\244\252\340\245\207\340\244\237 \340\244\256\340\245\207\340\244\202 \340\244\246\340\244\260\340\245\215\340\244\246\", \"\340\244\232\340\244\225\340\245\215\340\244\225\340\244\260 \340\244\206\340\244\250\340\244\276\").\nTranslate symptoms into professional English for hospital staff.\nProvide patient-facing communication in the detected native language.\n\nSYMPTOM EXTRACTION:\nExtract only information supported by patient input.\nDo not invent symptoms, medical history, or duration.\nIdentify missing information and uncertainty.\nFlag potential emergency warning signs.\n\nTIER 1 (Self-Care):\nRecommend conservative self-care guidance only for clearly mild symptoms without warning signs (e.g. mild common cold, mild dry cough for 1 day, minor superficial abrasion).\nInclude a medical disclaimer and escalation instructions.\n\nTIER 2 (OPD Consultation):\nIdentify the relevant clinical department (General Medicine, Cardiology, Gastroenterology, Neurology, Orthopaedics, Pulmonology, Pediatrics, Gynecology, Dermatology, etc.) and recommend clinical evaluation.\nDo not independently assign a hospital. Severity score between 4 and 8.\n\nTIER 3 (Emergency):\nIdentify potentially life-threatening symptoms (severe sudden chest pain, severe breathing distress, signs of acute stroke, severe trauma/bleeding, sudden loss of consciousness).\nSet severity score to 10.\nRecommend immediate emergency assistance.\nDo not delay emergency instructions.\n\nPRESCRIPTION SCANNING:\nExtract only clearly legible medicine names, dosage, frequency, and duration.\nNever guess missing information.\nNever invent medication instructions.\nIf handwriting is ambiguous, unclear, smudged, or medicine identity cannot be verified with 100% certainty, abort extraction.\nReturn the exact warning:\n\"Medicine name is unclear. Please consult a physical pharmacist.\"\n\nHOSPITAL ROUTING:\nDo not invent hospital IDs, hospital names, specialties, availability, or distances.\nThe backend will perform geographical calculations and final hospital allocation.\n\nOUTPUT:\nReturn valid JSON matching the schema.\nNever provide unsupported medical claims.\nNever claim that an ambulance or medical professional has been dispatched.`;\n\nexport interface TriageAIResult {\n  status: \'success\' | \'unclear\';\n  tier: TriageTier;\n  translated_symptoms: string;\n  detected_language: Language;\n  clinical_department: string;\n  severity_score: number;\n  patient_instructions_native: string;\n  safety_warning: string;\n  requires_human_assessment: boolean;\n  original_transcript?: string;\n}\n\nexport interface PrescriptionAIResult {\n  status: \'success\' | \'unclear\' | \'failed\';\n  medicines: Array<{\n    name: string;\n    dosage: string;\n    frequency: string;\n    duration: string;\n    instructions_native: string;\n  }>;\n  safety_warning: string;\n}\n\n/**\n * Analyzes patient symptom audio or text input using Gemini.\n */\nexport async function analyzeSymptoms(\n  input: {\n    audioBase64?: string;\n    audioMimeType?: string;\n    textInput?: string;\n    userLanguageHint?: Language;\n  }\n): Promise<TriageAIResult> {\n  if (ai) {\n    try {\n      const parts: any[] = [];\n\n      if (input.audioBase64 && input.audioMimeType) {\n        parts.push({\n          inlineData: {\n            mimeType: input.audioMimeType,\n            data: input.audioBase64,\n          },\n        });\n        parts.push({\n          text: `Please transcribe and analyze this patient audio recording. Extract reported symptoms, detect the language (Telugu \'te\', Hindi \'hi\', or English \'en\'), assess the triage tier (1: Self-care, 2: OPD, 3: Emergency), determine severity score (1-10), identify clinical department, and provide patient instructions in their native language.`\n        });\n      } else if (input.textInput) {\n        parts.push({\n          text: `Patient input: \"${input.textInput}\". User language hint: ${input.userLanguageHint || \'auto\'}.\nAnalyze these symptoms, detect language (\'te\', \'hi\', or \'en\'), determine triage tier (1, 2, or 3), severity score (1-10), clinical department, English translation, and patient instructions in the detected language.`\n        });\n      } else {\n        throw new Error(\'No input provided for symptom analysis\');\n      }\n\n      const response = await ai.models.generateContent({\n        model: GEMINI_MODEL,\n        contents: { parts },\n        config: {\n          systemInstruction: MASTER_SYSTEM_PROMPT,\n          responseMimeType: \'application/json\',\n          responseSchema: {\n            type: Type.OBJECT,\n            properties: {\n              status: { type: Type.STRING },\n              tier: { type: Type.INTEGER, description: \'1 for Self-care, 2 for OPD, 3 for Emergency\' },\n              translated_symptoms: { type: Type.STRING, description: \'Clinical symptoms translated to English\' },\n              detected_language: { type: Type.STRING, description: \'te, hi, or en\' },\n              clinical_department: { type: Type.STRING, description: \'Clinical department like Cardiology, General Medicine, etc.\' },\n              severity_score: { type: Type.INTEGER, description: \'1 to 10 scale\' },\n              patient_instructions_native: { type: Type.STRING, description: \'Instructions in the patient language\' },\n              safety_warning: { type: Type.STRING },\n              requires_human_assessment: { type: Type.BOOLEAN },\n              original_transcript: { type: Type.STRING },\n            },\n            required: [\n              \'status\',\n              \'tier\',\n              \'translated_symptoms\',\n              \'detected_language\',\n              \'clinical_department\',\n              \'severity_score\',\n              \'patient_instructions_native\',\n              \'requires_human_assessment\',\n            ],\n          },\n        },\n      });\n\n      const responseText = response.text;\n      if (responseText) {\n        const parsed = JSON.parse(responseText.trim());\n        let tier = parsed.tier as TriageTier;\n        if (tier !== 1 && tier !== 2 && tier !== 3) tier = 2;\n\n        return {\n          status: \'success\',\n          tier,\n          translated_symptoms: parsed.translated_symptoms || \'Patient reported symptoms requiring evaluation.\',\n          detected_language: (parsed.detected_language as Language) || input.userLanguageHint || \'en\',\n          clinical_department: parsed.clinical_department || \'General Medicine\',\n          severity_score: Math.min(10, Math.max(1, Number(parsed.severity_score) || 5)),\n          patient_instructions_native: parsed.patient_instructions_native || \'Please proceed to the assigned department.\',\n          safety_warning: parsed.safety_warning || \'\',\n          requires_human_assessment: parsed.requires_human_assessment !== false,\n          original_transcript: parsed.original_transcript || input.textInput,\n        };\n      }\n    } catch (error) {\n      console.warn(\'Gemini API call failed, invoking clinical fallback rule engine:\', error);\n    }\n  }\n\n  // Clinical Rule Engine Fallback (guarantees safe, resilient triage even without API key or during network outage)\n  return fallbackClinicalTriage(input.textInput || \'Voice symptom recording received\', input.userLanguageHint || \'en\');\n}\n\n/**\n * Decodes prescriptions from image using Gemini Vision with strict safety protocol.\n */\nexport async function decodePrescription(\n  imageBase64: string,\n  mimeType: string,\n  preferredLanguage: Language = \'en\'\n): Promise<PrescriptionAIResult> {\n  const EXACT_UNCLEAR_WARNING = \'Medicine name is unclear. Please consult a physical pharmacist.\';\n\n  if (ai) {\n    try {\n      const response = await ai.models.generateContent({\n        model: GEMINI_MODEL,\n        contents: {\n          parts: [\n            {\n              inlineData: {\n                mimeType,\n                data: imageBase64,\n              },\n            },\n            {\n              text: `Carefully examine this prescription.\nExtract medicine names, dosage, frequency, and instructions.\nCRITICAL SAFETY PROTOCOL:\n- Never guess or extrapolate medicine names or dosages.\n- If the handwriting is messy, smudged, ambiguous, or illegible, you MUST set status to \"unclear\", return an empty medicines array, and set safety_warning exactly to: \"${EXACT_UNCLEAR_WARNING}\".\n- If readable, translate instructions to the requested language (${preferredLanguage}).`\n            },\n          ],\n        },\n        config: {\n          systemInstruction: MASTER_SYSTEM_PROMPT,\n          responseMimeType: \'application/json\',\n          responseSchema: {\n            type: Type.OBJECT,\n            properties: {\n              status: { type: Type.STRING, description: \'\"success\" or \"unclear\"\' },\n              safety_warning: { type: Type.STRING },\n              medicines: {\n                type: Type.ARRAY,\n                items: {\n                  type: Type.OBJECT,\n                  properties: {\n                    name: { type: Type.STRING },\n                    dosage: { type: Type.STRING },\n                    frequency: { type: Type.STRING },\n                    duration: { type: Type.STRING },\n                    instructions_native: { type: Type.STRING },\n                  },\n                  required: [\'name\', \'dosage\', \'frequency\', \'duration\', \'instructions_native\'],\n                },\n              },\n            },\n            required: [\'status\', \'safety_warning\', \'medicines\'],\n          },\n        },\n      });\n\n      const responseText = response.text;\n      if (responseText) {\n        const parsed = JSON.parse(responseText.trim());\n        if (parsed.status === \'unclear\' || !parsed.medicines || parsed.medicines.length === 0) {\n          return {\n            status: \'unclear\',\n            medicines: [],\n            safety_warning: EXACT_UNCLEAR_WARNING,\n          };\n        }\n        return {\n          status: \'success\',\n          medicines: parsed.medicines,\n          safety_warning: parsed.safety_warning || \'Verification with licensed pharmacist recommended.\',\n        };\n      }\n    } catch (err) {\n      console.warn(\'Prescription decoding failed via Gemini:\', err);\n    }\n  }\n\n  // Fallback for demo when API key is unavailable\n  return {\n    status: \'unclear\',\n    medicines: [],\n    safety_warning: EXACT_UNCLEAR_WARNING,\n  };\n}\n\n/**\n * Deterministic clinical rule engine fallback for resilient offline/outage operation.\n */\nfunction fallbackClinicalTriage(rawText: string, langHint: Language): TriageAIResult {\n  const text = rawText.toLowerCase();\n\n  // Tier 3 Emergency indicators\n  const emergencyKeywords = [\n    \'chest pain\', \'\340\260\227\340\261\201\340\260\202\340\260\241\340\261\206 \340\260\250\340\261\212\340\260\252\340\261\215\340\260\252\340\260\277\', \'\340\244\270\340\245\200\340\244\250\340\245\207 \340\244\256\340\245\207\340\244\202 \340\244\246\340\244\260\340\245\215\340\244\246\',\n    \'heart attack\', \'\340\260\266\340\261\215\340\260\265\340\260\276\340\260\270 \340\260\244\340\261\200\340\260\270\340\261\201\340\260\225\340\261\213\340\260\265\340\260\241\340\260\202\340\260\262\340\261\213 \340\260\207\340\260\254\340\261\215\340\260\254\340\260\202\340\260\246\340\260\277\', \'\340\244\270\340\244\276\340\244\202\340\244\270 \340\244\262\340\245\207\340\244\250\340\245\207 \340\244\256\340\245\207\340\244\202 \340\244\244\340\244\225\340\244\262\340\245\200\340\244\253\',\n    \'difficulty breathing\', \'breathless\', \'stroke\', \'unconscious\',\n    \'bleeding heavily\', \'\340\260\225\340\260\263\340\261\215\340\260\263\340\261\201 \340\260\244\340\260\277\340\260\260\340\260\277\340\260\227\340\260\277 \340\260\252\340\260\241\340\260\277\340\260\252\340\261\213\340\260\265\340\260\241\340\260\202\', \'\340\244\254\340\245\207\340\244\271\340\245\213\340\244\266\'\n  ];\n\n  const isEmergency = emergencyKeywords.some((k) => text.includes(k.toLowerCase()));\n\n  if (isEmergency) {\n    let nativeInstr = \'EMERGENCY: Immediate emergency medical care required. Call emergency services immediately.\';\n    if (langHint === \'te\') {\n      nativeInstr = \'\340\260\205\340\260\244\340\261\215\340\260\257\340\260\265\340\260\270\340\260\260 \340\260\271\340\261\206\340\260\232\340\261\215\340\260\232\340\260\260\340\260\277\340\260\225: \340\260\244\340\260\225\340\261\215\340\260\267\340\260\243 \340\260\205\340\260\244\340\261\215\340\260\257\340\260\265\340\260\270\340\260\260 \340\260\265\340\261\210\340\260\246\340\261\215\340\260\257 \340\260\270\340\260\202\340\260\260\340\260\225\340\261\215\340\260\267\340\260\243 \340\260\205\340\260\265\340\260\270\340\260\260\340\260\202. \340\260\265\340\261\206\340\260\202\340\260\237\340\260\250\340\261\207 \340\260\270\340\260\256\340\261\200\340\260\252\340\260\202\340\260\262\340\261\213\340\260\250\340\260\277 \340\260\216\340\260\256\340\260\260\340\261\215\340\260\234\340\261\206\340\260\250\340\261\215\340\260\270\340\261\200 \340\260\265\340\260\276\340\260\260\340\261\215\340\260\241\340\261\201\340\260\225\340\261\201 \340\260\265\340\261\206\340\260\263\340\261\215\340\260\263\340\260\202\340\260\241\340\260\277 \340\260\262\340\261\207\340\260\246\340\260\276 108 \340\260\225\340\261\201 \340\260\225\340\260\276\340\260\262\340\261\215 \340\260\232\340\261\207\340\260\257\340\260\202\340\260\241\340\260\277.\';\n    } else if (langHint === \'hi\') {\n      nativeInstr = \'\340\244\206\340\244\252\340\244\276\340\244\244\340\244\225\340\244\276\340\244\262\340\245\200\340\244\250 \340\244\232\340\245\207\340\244\244\340\244\276\340\244\265\340\244\250\340\245\200: \340\244\244\340\244\244\340\245\215\340\244\225\340\244\276\340\244\262 \340\244\206\340\244\252\340\244\276\340\244\244\340\244\225\340\244\276\340\244\262\340\245\200\340\244\250 \340\244\232\340\244\277\340\244\225\340\244\277\340\244\244\340\245\215\340\244\270\340\244\276 \340\244\270\340\244\271\340\244\276\340\244\257\340\244\244\340\244\276 \340\244\206\340\244\265\340\244\266\340\245\215\340\244\257\340\244\225 \340\244\271\340\245\210\340\245\244 \340\244\244\340\245\201\340\244\260\340\244\202\340\244\244 108 \340\244\252\340\244\260 \340\244\225\340\245\211\340\244\262 \340\244\225\340\244\260\340\245\207\340\244\202 \340\244\257\340\244\276 \340\244\250\340\244\234\340\244\246\340\245\200\340\244\225\340\245\200 \340\244\206\340\244\252\340\244\276\340\244\244\340\244\225\340\244\276\340\244\262\340\245\200\340\244\250 \340\244\225\340\244\225\340\245\215\340\244\267 \340\244\234\340\244\276\340\244\217\340\244\202\340\245\244\';\n    }\n\n    return {\n      status: \'success\',\n      tier: 3,\n      translated_symptoms: `CRITICAL: Patient reports severe life-threatening symptoms: ${rawText}`,\n      detected_language: langHint,\n      clinical_department: \'Emergency & Critical Care\',\n      severity_score: 10,\n      patient_instructions_native: nativeInstr,\n      safety_warning: \'Life-threatening symptoms detected. Do not delay medical intervention.\',\n      requires_human_assessment: true,\n      original_transcript: rawText,\n    };\n  }\n\n  // Tier 1 Mild Self-care indicators\n  const mildKeywords = [\n    \'mild cold\', \'\340\260\232\340\260\277\340\260\250\340\261\215\340\260\250 \340\260\234\340\260\262\340\261\201\340\260\254\340\261\201\', \'\340\244\271\340\244\262\340\245\215\340\244\225\340\245\200 \340\244\270\340\244\260\340\245\215\340\244\246\340\245\200\',\n    \'runny nose\', \'mild scratch\', \'minor scrape\', \'just tired\',\n    \'sneezing once\', \'mild dry cough\'\n  ];\n\n  const isMild = mildKeywords.some((k) => text.includes(k.toLowerCase())) && !text.includes(\'severe\') && !text.includes(\'blood\');\n\n  if (isMild) {\n    let nativeInstr = \'Self-care guidance: Rest adequately, stay hydrated, and monitor temperature. If symptoms worsen, consult a doctor.\';\n    if (langHint === \'te\') {\n      nativeInstr = \'\340\260\270\340\261\215\340\260\265\340\261\200\340\260\257 \340\260\270\340\260\202\340\260\260\340\260\225\340\261\215\340\260\267\340\260\243 \340\260\270\340\261\202\340\260\232\340\260\250\340\260\262\340\261\201: \340\260\244\340\260\227\340\260\277\340\260\250\340\260\202\340\260\244 \340\260\265\340\260\277\340\260\266\340\261\215\340\260\260\340\260\276\340\260\202\340\260\244\340\260\277 \340\260\244\340\261\200\340\260\270\340\261\201\340\260\225\340\261\213\340\260\202\340\260\241\340\260\277, \340\260\252\340\261\201\340\260\267\340\261\215\340\260\225\340\260\262\340\260\202\340\260\227\340\260\276 \340\260\250\340\261\200\340\260\260\340\261\201 \340\260\244\340\261\215\340\260\260\340\260\276\340\260\227\340\260\202\340\260\241\340\260\277. \340\260\262\340\260\225\340\261\215\340\260\267\340\260\243\340\260\276\340\260\262\340\261\201 \340\260\216\340\260\225\340\261\215\340\260\225\340\261\201\340\260\265\340\261\210\340\260\244\340\261\207 \340\260\270\340\260\256\340\261\200\340\260\252 \340\260\206\340\260\270\340\261\201\340\260\252\340\260\244\340\261\215\340\260\260\340\260\277\340\260\250\340\260\277 \340\260\270\340\260\202\340\260\252\340\261\215\340\260\260\340\260\246\340\260\277\340\260\202\340\260\232\340\260\202\340\260\241\340\260\277.\';\n    } else if (langHint === \'hi\') {\n      nativeInstr = \'\340\244\270\340\245\215\340\244\265\340\244\257\340\244\202-\340\244\246\340\245\207\340\244\226\340\244\255\340\244\276\340\244\262 \340\244\250\340\244\277\340\244\260\340\245\215\340\244\246\340\245\207\340\244\266: \340\244\252\340\244\260\340\245\215\340\244\257\340\244\276\340\244\252\340\245\215\340\244\244 \340\244\206\340\244\260\340\244\276\340\244\256 \340\244\225\340\244\260\340\245\207\340\244\202, \340\244\227\340\245\201\340\244\250\340\244\227\340\245\201\340\244\250\340\244\276 \340\244\252\340\244\276\340\244\250\340\245\200 \340\244\252\340\244\277\340\244\217\340\244\202\340\245\244 \340\244\257\340\244\246\340\244\277 \340\244\262\340\244\225\340\245\215\340\244\267\340\244\243 \340\244\254\340\244\242\340\244\274\340\244\244\340\245\207 \340\244\271\340\245\210\340\244\202 \340\244\244\340\245\213 \340\244\244\340\245\201\340\244\260\340\244\202\340\244\244 \340\244\241\340\245\211\340\244\225\340\245\215\340\244\237\340\244\260 \340\244\270\340\245\207 \340\244\252\340\244\260\340\244\276\340\244\256\340\244\260\340\245\215\340\244\266 \340\244\262\340\245\207\340\244\202\340\245\244\';\n    }\n\n    return {\n      status: \'success\',\n      tier: 1,\n      translated_symptoms: `Mild non-urgent condition: ${rawText}`,\n      detected_language: langHint,\n      clinical_department: \'General Medicine\',\n      severity_score: 2,\n      patient_instructions_native: nativeInstr,\n      safety_warning: \'Non-diagnostic advice. If high fever or warning signs appear, seek medical evaluation.\',\n      requires_human_assessment: false,\n      original_transcript: rawText,\n    };\n  }\n\n  // Default: Tier 2 OPD\n  let dept = \'General Medicine\';\n  let severity = 6;\n\n  if (text.includes(\'stomach\') || text.includes(\'\340\260\225\340\260\241\340\261\201\340\260\252\340\261\201\') || text.includes(\'\340\244\252\340\245\207\340\244\237\') || text.includes(\'vomit\') || text.includes(\'acidity\')) {\n    dept = \'Gastroenterology\';\n    severity = 6;\n  } else if (text.includes(\'bone\') || text.includes(\'fracture\') || text.includes(\'\340\260\225\340\260\202\340\260\241\340\260\260\340\260\276\340\260\262\') || text.includes(\'\340\244\271\340\244\241\340\245\215\340\244\241\340\245\200\') || text.includes(\'knee\')) {\n    dept = \'Orthopaedics\';\n    severity = 7;\n  } else if (text.includes(\'headache\') || text.includes(\'migraine\') || text.includes(\'\340\260\244\340\260\262\340\260\250\340\261\206\340\260\252\340\261\215\340\260\252\340\260\277\') || text.includes(\'\340\244\270\340\244\277\340\244\260\340\244\246\340\244\260\340\245\215\340\244\246\')) {\n    dept = \'Neurology\';\n    severity = 5;\n  } else if (text.includes(\'fever\') || text.includes(\'\340\260\234\340\261\215\340\260\265\340\260\260\340\260\202\') || text.includes(\'\340\244\254\340\245\201\340\244\226\340\244\276\340\244\260\')) {\n    dept = \'Internal Medicine\';\n    severity = 6;\n  }\n\n  let nativeInstr = \'Please proceed to the assigned hospital OPD counter for physical examination.\';\n  if (langHint === \'te\') {\n    nativeInstr = \'\340\260\246\340\260\257\340\260\232\340\261\207\340\260\270\340\260\277 \340\260\241\340\260\276\340\260\225\340\261\215\340\260\237\340\260\260\340\261\215 \340\260\252\340\260\260\340\261\200\340\260\225\340\261\215\340\260\267 \340\260\225\340\261\213\340\260\270\340\260\202 \340\260\225\340\261\207\340\260\237\340\260\276\340\260\257\340\260\277\340\260\202\340\260\232\340\260\277\340\260\250 \340\260\206\340\260\270\340\261\201\340\260\252\340\260\244\340\261\215\340\260\260\340\260\277 \340\260\223\340\260\252\340\261\200\340\260\241\340\261\200 \340\260\225\340\261\214\340\260\202\340\260\237\340\260\260\340\261\215\342\200\214\340\260\225\340\261\201 \340\260\265\340\261\206\340\260\263\340\261\215\340\260\262\340\260\202\340\260\241\340\260\277. \340\260\256\340\261\200 \340\260\241\340\260\277\340\260\234\340\260\277\340\260\237\340\260\262\340\261\215 \340\260\237\340\261\213\340\260\225\340\261\206\340\260\250\340\261\215 \340\260\270\340\260\277\340\260\246\340\261\215\340\260\247\340\260\202\340\260\227\340\260\276 \340\260\211\340\260\202\340\260\246\340\260\277.\';\n  } else if (langHint === \'hi\') {\n    nativeInstr = \'\340\244\225\340\245\203\340\244\252\340\244\257\340\244\276 \340\244\241\340\245\211\340\244\225\340\245\215\340\244\237\340\244\260 \340\244\225\340\245\200 \340\244\234\340\244\276\340\244\202\340\244\232 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\250\340\244\277\340\244\260\340\245\215\340\244\247\340\244\276\340\244\260\340\244\277\340\244\244 \340\244\205\340\244\270\340\245\215\340\244\252\340\244\244\340\244\276\340\244\262 \340\244\223\340\244\252\340\245\200\340\244\241\340\245\200 \340\244\225\340\244\276\340\244\211\340\244\202\340\244\237\340\244\260 \340\244\252\340\244\260 \340\244\234\340\244\276\340\244\217\340\244\202\340\245\244 \340\244\206\340\244\252\340\244\225\340\244\276 \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\237\340\245\213\340\244\225\340\244\250 \340\244\234\340\244\276\340\244\260\340\245\200 \340\244\225\340\244\260 \340\244\246\340\244\277\340\244\257\340\244\276 \340\244\227\340\244\257\340\244\276 \340\244\271\340\245\210\340\245\244\';\n  }\n\n  return {\n    status: \'success\',\n    tier: 2,\n    translated_symptoms: `Patient presents with symptoms: ${rawText}`,\n    detected_language: langHint,\n    clinical_department: dept,\n    severity_score: severity,\n    patient_instructions_native: nativeInstr,\n    safety_warning: \'Clinical evaluation required. Avoid self-medication.\',\n    requires_human_assessment: true,\n    original_transcript: rawText,\n  };\n}\n"
