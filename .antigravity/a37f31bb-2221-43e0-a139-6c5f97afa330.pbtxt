  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useRef, useEffect } from \'react\';\nimport {\n  MessageSquare,\n  Send,\n  X,\n  Bot,\n  User,\n  Sparkles,\n  Zap,\n  Brain,\n  ShieldCheck,\n  RotateCcw,\n  Copy,\n  Check\n} from \'lucide-react\';\nimport { collection, addDoc } from \'firebase/firestore\';\nimport { firestore } from \'../../lib/firebase\';\n\ninterface ChatMessage {\n  id: string;\n  sender: \'user\' | \'assistant\';\n  content: string;\n  modelUsed?: string;\n  timestamp: string;\n}\n\ntype ModelType = \'gemini-3.1-flash-lite\' | \'gemini-3.8-flash\' | \'gemini-4-argon\';\ntype RoleType = \'general\' | \'specialist\' | \'fast_triage\';\n\ninterface Props {\n  isOpen: boolean;\n  onClose: () => void;\n  preferredLanguage?: string;\n}\n\nexport const GeminiChatbotModal: React.FC<Props> = ({\n  isOpen,\n  onClose,\n  preferredLanguage = \'te\',\n}) => {\n  const [selectedModel, setSelectedModel] = useState<ModelType>(\'gemini-3.8-flash\');\n  const [selectedRole, setSelectedRole] = useState<RoleType>(\'general\');\n  const [inputMessage, setInputMessage] = useState(\'\');\n  const [isLoading, setIsLoading] = useState(false);\n  const [copiedId, setCopiedId] = useState<string | null>(null);\n\n  const [messages, setMessages] = useState<ChatMessage[]>([\n    {\n      id: \'welcome\',\n      sender: \'assistant\',\n      content:\n        \'Namaste! I am Sanjeevani Healthcare Assistant powered by Gemini AI. How can I assist you with symptoms, medicine questions, or hospital routing today?\',\n      modelUsed: \'gemini-3.8-flash\',\n      timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n    },\n  ]);\n\n  const messagesEndRef = useRef<HTMLDivElement | null>(null);\n\n  useEffect(() => {\n    messagesEndRef.current?.scrollIntoView({ behavior: \'smooth\' });\n  }, [messages, isLoading]);\n\n  const handleSendMessage = async (e?: React.FormEvent) => {\n    if (e) e.preventDefault();\n    if (!inputMessage.trim() || isLoading) return;\n\n    const userText = inputMessage.trim();\n    setInputMessage(\'\');\n\n    const userMsg: ChatMessage = {\n      id: `msg-${Date.now()}`,\n      sender: \'user\',\n      content: userText,\n      timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n    };\n\n    setMessages((prev) => [...prev, userMsg]);\n    setIsLoading(true);\n\n    // Save to Firestore in background if available\n    try {\n      addDoc(collection(firestore, \'chat_messages\'), {\n        sender: \'user\',\n        content: userText,\n        model_used: selectedModel,\n        timestamp: new Date().toISOString(),\n      }).catch(() => {});\n    } catch (e) {}\n\n    try {\n      // Build conversation history for multi-turn chat\n      const chatHistory = [...messages, userMsg].map((m) => ({\n        role: m.sender === \'user\' ? (\'user\' as const) : (\'model\' as const),\n        content: m.content,\n      }));\n\n      const res = await fetch(\'/api/v1/chat\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          messages: chatHistory,\n          model: selectedModel,\n          role: selectedRole,\n        }),\n      });\n\n      const data = await res.json();\n      if (!data.success) {\n        throw new Error(data.error || \'Failed to get response\');\n      }\n\n      const botMsg: ChatMessage = {\n        id: `msg-${Date.now()}-ai`,\n        sender: \'assistant\',\n        content: data.reply,\n        modelUsed: data.modelUsed || selectedModel,\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n      };\n\n      setMessages((prev) => [...prev, botMsg]);\n\n      // Save bot response to Firestore in background\n      try {\n        addDoc(collection(firestore, \'chat_messages\'), {\n          sender: \'assistant\',\n          content: data.reply,\n          model_used: data.modelUsed || selectedModel,\n          timestamp: new Date().toISOString(),\n        }).catch(() => {});\n      } catch (e) {}\n    } catch (err: any) {\n      const errorMsg: ChatMessage = {\n        id: `msg-err-${Date.now()}`,\n        sender: \'assistant\',\n        content:\n          \'I am currently experiencing a temporary connection issue. If this is an emergency, please use the 2.5s SOS button or dial 108.\',\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n      };\n      setMessages((prev) => [...prev, errorMsg]);\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const handleCopy = (text: string, id: string) => {\n    navigator.clipboard.writeText(text);\n    setCopiedId(id);\n    setTimeout(() => setCopiedId(null), 2000);\n  };\n\n  const resetChat = () => {\n    setMessages([\n      {\n        id: `reset-${Date.now()}`,\n        sender: \'assistant\',\n        content: \'Conversation cleared. How can I assist you?\',\n        modelUsed: selectedModel,\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n      },\n    ]);\n  };\n\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-end sm:items-center justify-center p-0 sm:p-4\">\n      <div className=\"bg-white w-full max-w-xl rounded-t-3xl sm:rounded-3xl shadow-2xl h-[92vh] sm:h-[750px] flex flex-col overflow-hidden\">\n        {/* Header */}\n        <div className=\"bg-slate-900 text-white p-4 sm:p-5 flex items-center justify-between shrink-0\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 rounded-2xl bg-teal-500 text-slate-950 flex items-center justify-center shadow-md\">\n              <Bot className=\"w-6 h-6\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h2 className=\"text-base font-extrabold tracking-tight\">Sanjeevani AI Chat</h2>\n                <span className=\"text-[10px] font-bold bg-teal-500/20 text-teal-300 border border-teal-500/30 px-2 py-0.5 rounded-full\">\n                  Multi-Turn\n                </span>\n              </div>\n              <p className=\"text-[11px] text-slate-400\">\n                Medical Assistant \342\200\242 Role-Based System Prompting\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={resetChat}\n              className=\"p-2 text-slate-400 hover:text-white rounded-xl hover:bg-slate-800 transition\"\n              title=\"Reset Conversation\"\n            >\n              <RotateCcw className=\"w-4 h-4\" />\n            </button>\n            <button\n              onClick={onClose}\n              className=\"w-8 h-8 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center transition\"\n            >\n              <X className=\"w-4 h-4\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Controls: Model Selector & Role Selector */}\n        <div className=\"bg-slate-50 border-b border-slate-200 p-3 flex flex-wrap items-center justify-between gap-2 shrink-0 text-xs\">\n          {/* Model Selector */}\n          <div className=\"flex items-center gap-1.5\">\n            <span className=\"text-slate-500 font-semibold text-[11px]\">Model:</span>\n            <div className=\"flex bg-white border border-slate-200 rounded-xl p-0.5 shadow-2xs\">\n              <button\n                onClick={() => setSelectedModel(\'gemini-3.1-flash-lite\')}\n                className={`px-2 py-1 rounded-lg text-[10px] font-bold flex items-center gap-1 transition ${\n                  selectedModel === \'gemini-3.1-flash-lite\'\n                    ? \'bg-amber-100 text-amber-900 border border-amber-300 shadow-2xs\'\n                    : \'text-slate-600 hover:text-slate-900\'\n                }`}\n              >\n                <Zap className=\"w-3 h-3 text-amber-600\" /> Fast Lite\n              </button>\n              <button\n                onClick={() => setSelectedModel(\'gemini-3.8-flash\')}\n                className={`px-2 py-1 rounded-lg text-[10px] font-bold flex items-center gap-1 transition ${\n                  selectedModel === \'gemini-3.8-flash\'\n                    ? \'bg-teal-600 text-white shadow-2xs\'\n                    : \'text-slate-600 hover:text-slate-900\'\n                }`}\n              >\n                <Sparkles className=\"w-3 h-3\" /> General 3.8\n              </button>\n              <button\n                onClick={() => setSelectedModel(\'gemini-4-argon\')}\n                className={`px-2 py-1 rounded-lg text-[10px] font-bold flex items-center gap-1 transition ${\n                  selectedModel === \'gemini-4-argon\'\n                    ? \'bg-indigo-600 text-white shadow-2xs\'\n                    : \'text-slate-600 hover:text-slate-900\'\n                }`}\n              >\n                <Brain className=\"w-3 h-3\" /> Complex 4\n              </button>\n            </div>\n          </div>\n\n          {/* Role Preset Selector */}\n          <div className=\"flex items-center gap-1.5\">\n            <span className=\"text-slate-500 font-semibold text-[11px]\">Role:</span>\n            <select\n              value={selectedRole}\n              onChange={(e) => setSelectedRole(e.target.value as RoleType)}\n              className=\"bg-white border border-slate-200 rounded-xl px-2 py-1 text-[11px] font-semibold text-slate-800 focus:outline-teal-600\"\n            >\n              <option value=\"general\">\360\237\251\272 General Health Guide</option>\n              <option value=\"specialist\">\360\237\247\240 Clinical Specialist</option>\n              <option value=\"fast_triage\">\342\232\241 Rapid Triage Bot</option>\n            </select>\n          </div>\n        </div>\n\n        {/* Scrollable Chat Thread */}\n        <div className=\"flex-1 overflow-y-auto p-4 sm:p-6 space-y-4 text-left\">\n          {messages.map((m) => (\n            <div\n              key={m.id}\n              className={`flex flex-col ${m.sender === \'user\' ? \'items-end\' : \'items-start\'}`}\n            >\n              <div\n                className={`max-w-[85%] rounded-3xl p-4 text-xs leading-relaxed shadow-xs relative group ${\n                  m.sender === \'user\'\n                    ? \'bg-teal-600 text-white rounded-br-xs\'\n                    : \'bg-slate-100 text-slate-900 border border-slate-200/80 rounded-bl-xs\'\n                }`}\n              >\n                <div className=\"whitespace-pre-wrap\">{m.content}</div>\n\n                <div\n                  className={`flex items-center justify-between gap-2 mt-2 pt-1 border-t text-[10px] font-mono ${\n                    m.sender === \'user\' ? \'border-teal-500 text-teal-200\' : \'border-slate-200 text-slate-400\'\n                  }`}\n                >\n                  <span>{m.timestamp}</span>\n                  {m.modelUsed && <span>{m.modelUsed}</span>}\n                  <button\n                    onClick={() => handleCopy(m.content, m.id)}\n                    className=\"opacity-0 group-hover:opacity-100 transition p-0.5 hover:text-white\"\n                    title=\"Copy message\"\n                  >\n                    {copiedId === m.id ? (\n                      <Check className=\"w-3 h-3 text-emerald-400\" />\n                    ) : (\n                      <Copy className=\"w-3 h-3\" />\n                    )}\n                  </button>\n                </div>\n              </div>\n            </div>\n          ))}\n\n          {isLoading && (\n            <div className=\"flex items-start gap-2\">\n              <div className=\"bg-slate-100 border border-slate-200 rounded-2xl p-3.5 text-xs text-slate-500 flex items-center gap-2\">\n                <span className=\"w-2 h-2 rounded-full bg-teal-500 animate-pulse\" />\n                <span>Gemini ({selectedModel}) is thinking...</span>\n              </div>\n            </div>\n          )}\n\n          <div ref={messagesEndRef} />\n        </div>\n\n        {/* Suggested Quick Prompts */}\n        <div className=\"px-4 py-1.5 bg-slate-50 border-t border-slate-200 flex items-center gap-1.5 overflow-x-auto text-[11px] shrink-0\">\n          <span className=\"text-slate-400 font-bold shrink-0\">Try:</span>\n          <button\n            onClick={() => setInputMessage(\'\340\260\250\340\260\276\340\260\225\340\261\201 \340\260\227\340\260\244 \340\260\260\340\261\206\340\260\202\340\260\241\340\261\201 \340\260\260\340\261\213\340\260\234\340\261\201\340\260\262 \340\260\250\340\261\201\340\260\202\340\260\241\340\260\277 \340\260\234\340\261\215\340\260\265\340\260\260\340\260\202 \340\260\256\340\260\260\340\260\277\340\260\257\340\261\201 \340\260\244\340\260\262\340\260\250\340\261\212\340\260\252\340\261\215\340\260\252\340\260\277 \340\260\211\340\260\202\340\260\246\340\260\277, \340\260\217\340\260\256\340\260\277 \340\260\232\340\261\207\340\260\257\340\260\276\340\260\262\340\260\277?\')}\n            className=\"px-2.5 py-1 bg-white border border-slate-200 rounded-lg text-slate-700 hover:border-teal-400 shrink-0 text-left\"\n          >\n            Telugu: \340\260\234\340\261\215\340\260\265\340\260\260\340\260\202 & \340\260\244\340\260\262\340\260\250\340\261\212\340\260\252\340\261\215\340\260\252\340\260\277\n          </button>\n          <button\n            onClick={() => setInputMessage(\'\340\244\252\340\245\207\340\244\237 \340\244\256\340\245\207\340\244\202 \340\244\244\340\245\207\340\244\234 \340\244\220\340\244\202\340\244\240\340\244\250 \340\244\224\340\244\260 \340\244\211\340\244\262\340\245\215\340\244\237\340\245\200 \340\244\225\340\245\207 \340\244\262\340\244\225\340\245\215\340\244\267\340\244\243\')}\n            className=\"px-2.5 py-1 bg-white border border-slate-200 rounded-lg text-slate-700 hover:border-teal-400 shrink-0 text-left\"\n          >\n            Hindi: \340\244\252\340\245\207\340\244\237 \340\244\246\340\244\260\340\245\215\340\244\246\n          </button>\n          <button\n            onClick={() => setInputMessage(\'Can Paracetamol 650 be taken with Pantoprazole on empty stomach?\')}\n            className=\"px-2.5 py-1 bg-white border border-slate-200 rounded-lg text-slate-700 hover:border-teal-400 shrink-0 text-left\"\n          >\n            Drug interaction check\n          </button>\n        </div>\n\n        {/* Chat Input Bar */}\n        <form onSubmit={handleSendMessage} className=\"p-3 bg-white border-t border-slate-200 flex items-center gap-2 shrink-0\">\n          <input\n            type=\"text\"\n            value={inputMessage}\n            onChange={(e) => setInputMessage(e.target.value)}\n            placeholder=\"Type your health question (Telugu, Hindi, English)...\"\n            className=\"flex-1 bg-slate-50 border border-slate-300 focus:border-teal-600 focus:bg-white rounded-2xl px-4 py-2.5 text-xs text-slate-900 focus:outline-none transition\"\n          />\n          <button\n            type=\"submit\"\n            disabled={!inputMessage.trim() || isLoading}\n            className={`w-10 h-10 rounded-2xl flex items-center justify-center transition shadow-xs ${\n              !inputMessage.trim() || isLoading\n                ? \'bg-slate-200 text-slate-400 cursor-not-allowed\'\n                : \'bg-teal-600 text-white hover:bg-teal-700\'\n            }`}\n          >\n            <Send className=\"w-4 h-4\" />\n          </button>\n        </form>\n      </div>\n    </div>\n  );\n};\n"
