              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  public getTokens(): OPDToken[] {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return Array.from(this.tokens.values()).sort("
