    content: "      air_quality: \'Moderate (AQI 84)\',\n    },\n    observation:\n      \'Sleep duration (5.2 hrs) is lower than the recommended 7-8 hours. Combined with 32\302\260C heat, remember to stay hydrated with electrolytes and avoid peak afternoon sun.\',\n    is_simulated: true,\n  };\n\n  res.json({ success: true, insight });\n// ----------------------------------------------------\n// Multi-turn Gemini Chatbot\n// ----------------------------------------------------\nrouter.post(\'/chat\', async (req: Request, res: Response) => {\n  try {\n    const { messages, model = \'gemini-3.8-flash\', role = \'general\' } = req.body;\n\n    let systemInstruction = `You are Sanjeevani Health AI, an empathetic, multilingual medical assistant. Support Telugu, Hindi, and English.`;\n    if (role === \'specialist\') {\n      systemInstruction = `You are Sanjeevani Clinical Reasoning Specialist. You provide in-depth medical evaluations, discuss differential diagnoses, potential drug interactions, and explain lab/radiology findings with scientific rigor. Always clarify that physical examination by a licensed physician is essential.`;\n    } else if (role === \'fast_triage\') {\n      systemInstruction = `You are Sanjeevani Rapid Triage Bot. Deliver fast, concise health assessments (under 3 sentences), flag emergency red flags immediately, and give direct next steps.`;\n    }\n\n    const result = await chatWithGemini(messages, model, systemInstruction);\n    res.json({\n      success: true,\n      reply: result.reply,\n      modelUsed: result.modelUsed,\n    });\n  } catch (err: any) {\n    console.error(\'Chat endpoint error:\', err);\n    res.status(500).json({ success: false, error: err.message || \'Chat processing error\' });\n  }\n});\n\nexport default router;\n"
