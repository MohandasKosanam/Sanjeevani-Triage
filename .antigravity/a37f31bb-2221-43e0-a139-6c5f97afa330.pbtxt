      }));\\n          const fallbackResp = await ai.models.generateContent({\\n            model: \'gemini-3.8-flash\',\\n            contents,\\n            config: {\\n              systemInstruction: systemInstruction || \'You are Sanjeevani Healthcare Assistant.\',\\n            },\\n          });\\n          if (fallbackResp.text && fallbackResp.text.trim().length > 0) {\\n            return {\\n              reply: fallbackResp.text,\\n              modelUsed: \'gemini-3.8-flash\',\\n            };\\n          }\\n        } catch (e) {}\\n      }\\n    }\\n  }\\n\\n  // Clinical Multilingual Knowledge Fallback Engine\\n  const lastUserMsg = (messages[messages.length - 1]?.content || \'\').toLowerCase();\\n\\n  // Detect language if not explicitly provided\\n  const isTelugu = language === \'te\' || /[\\\\u0C00-\\\\u0C7F]/.test(lastUserMsg);\\n  const isHindi = language === \'hi\' || /[\\\\u0900-\\\\u097F]/.test(lastUserMsg);\\n\\n  if (isTelugu) {\\n    if (lastUserMsg.includes(\'\340\260\234\340\261\215\340\260\265\340\260\260\340\260\202\') || lastUserMsg.includes(\'fever\') || lastUserMsg.includes(\'\340\260\244\340\260\276\340\260\252\340\260\202\')) {\\n      return {\\n        reply: `\340\260\250\340\260\256\340\260\270\340\261\215\340\260\225\340\260\276\340\260\260\340\260\202! \340\260\234\340\261\215\340\260\265\340\260\260\340\260\202 \340\260\227\340\261\201\340\260\260\340\260\277\340\260\202\340\260\232\340\260\277 \340\260\256\340\261\200\340\260\260\340\261\201 \340\260\205\340\260\241\340\260\277\340\260\227\340\260\277\340\260\250 \340\260\270\340\260\256\340\260\276\340\260\232\340\260\276\340\260\260\340\260\202:\\\\n\\\\n1. **\340\260\265\340\260\277\340\260\266\340\261\215\340\260\260\340\260\276\340\260\202\340\260\244\340\260\277 & \340\260\246\340\261\215\340\260\260\340\260\265\340\260\252\340\260\246\340\260\276\340\260\260\340\261\215\340\260\245\340\260\276\340\260\262\340\261\201:** \340\260\244\340\260\227\340\260\277\340\260\2