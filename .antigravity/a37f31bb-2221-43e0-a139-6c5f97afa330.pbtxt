  view_file {
    absolute_path_uri: "file:///firestore.rules"
    end_line: 47
    content: "rules_version = \'2\';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    // Global Safety Net: default deny\n    match /{document=**} {\n      allow read, write: if false;\n    }\n\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isValidId(id) {\n      return id is string && id.size() > 0 && id.size() <= 128 && id.matches(\'^[a-zA-Z0-9_\\\\-]+$\');\n    }\n\n    // Users Collection\n    match /users/{userId} {\n      allow read: if isValidId(userId);\n      allow create, update: if isValidId(userId) && request.resource.data.name is string && request.resource.data.name.size() <= 100;\n    }\n\n    // Triage Records Collection\n    match /triage_records/{triageId} {\n      allow read: if isValidId(triageId);\n      allow create, update: if isValidId(triageId) && request.resource.data.tier is number && request.resource.data.severity_score is number;\n    }\n\n    // OPD Tokens Collection\n    match /opd_tokens/{tokenId} {\n      allow read: if isValidId(tokenId);\n      allow create, update: if isValidId(tokenId) && request.resource.data.token_number is string;\n    }\n\n    // SOS Emergency Events Collection\n    match /sos_events/{sosId} {\n      allow read: if isValidId(sosId);\n      allow create, update: if isValidId(sosId) && request.resource.data.priority == 0;\n    }\n\n    // Chat Messages Collection\n    match /chat_messages/{messageId} {\n      allow read: if isValidId(messageId);\n      allow create, update: if isValidId(messageId) && request.resource.data.content is string && request.resource.data.content.size() <= 10000;\n    }\n  }\n}\n"
    num_lines: 48
    num_bytes: 1585
    line_range_bytes: 1585
  }
}
