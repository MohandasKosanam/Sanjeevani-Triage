              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      severity_score: severityScore,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      status: \'waiting\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      distance_km: distanceKm,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
