  code_action {
    action_spec {
      create_file {
        instruction: "export type Language = \'te\' | \'hi\' | \'en\';\n\nexport type TriageTier = 1 | 2 | 3;\n\nexport interface Coordinates {\n  lat: number;\n  lng: number;\n}\n\nexport interface Hospital {\n  hospital_id: string;\n  hospital_name: string;\n  coordinates: Coordinates;\n  specialties: string[];\n  address: string;\n  phone: string;\n  capacity_status?: \'normal\' | \'busy\' | \'critical\';\n}\n\nexport interface UserProfile {\n  id: string;\n  name: string;\n  phone: string;\n  email?: string;\n  preferred_language: Language;\n  age?: number;\n  gender?: string;\n  emergency_contact: {\n    name: string;\n    phone: string;\n    relationship: string;\n  };\n  known_conditions?: string[];\n  allergies?: string[];\n}\n\nexport interface TriageRecord {\n  id: string;\n  patient_id: string;\n  patient_name: string;\n  patient_phone: string;\n  detected_language: Language;\n  original_transcript?: string;\n  translated_symptoms: string;\n  tier: TriageTier;\n  severity_score: number; // 1 - 10\n  clinical_department: string;\n  patient_instructions_native: string;\n  safety_warning?: string;\n  requires_human_assessment: boolean;\n  assigned_hospital?: {\n    id: string;\n    name: string;\n    distance_km: number;\n    phone: string;\n  };\n  opd_token?: string;\n  status: \'pending\' | \'triaged\' | \'token_issued\' | \'consultation\' | \'completed\';\n  created_at: string;\n}\n\nexport interface OPDToken {\n  id: string;\n  token_number: string;\n  patient_id: string;\n  patient_name: string;\n  patient_phone: string;\n  triage_id: string;\n  hospital_id: string;\n  hospital_name: string;\n  department: string;\n  priority: \'low\' | \'medium\' | \'high\' | \'critical\';\n  severity_score: number;\n  status: \'waiting\' | \'in_consultation\' | \'completed\' | \'cancelled\';\n  distance_km: number;\n  created_at: string;\n  estimated_wait_minutes: number;\n}\n\nexport interface SOSEvent {\n  id: string;\n  patient_id: string;\n  patient_name: string;\n  patient_phone: string;\n  latitude: number;\n  longitude: number;\n  priority: 0; // Priority 0 is highest emergency\n  status: \'received\' | \'dispatched\' | \'contacted\' | \'resolved\';\n  ambient_audio_url?: string;\n  ambient_duration_sec?: number;\n  emergency_notes?: string;\n  created_at: string;\n  resolved_at?: string;\n}\n\nexport interface ExtractedMedicine {\n  name: string;\n  dosage: string;\n  frequency: string;\n  duration: string;\n  instructions_native: string;\n}\n\nexport interface PrescriptionRecord {\n  id: string;\n  patient_id: string;\n  image_url: string;\n  extraction_status: \'success\' | \'unclear\' | \'failed\';\n  medicines: ExtractedMedicine[];\n  safety_warning: string;\n  created_at: string;\n}\n\nexport interface DailyHealthInsight {\n  metrics: {\n    steps: number;\n    sleep_duration_hours: number;\n    avg_hr_bpm: number;\n  };\n  context: {\n    location: string;\n    weather: string;\n    air_quality?: string;\n  };\n  observation: string;\n  is_simulated: boolean;\n}\n\nexport type QueueItemType = \'sos\' | \'emergency\' | \'opd\';\n\nexport interface QueueItem {\n  id: string;\n  type: QueueItemType;\n  priority_rank: number; // 0 for SOS, 1 for Tier 3, 2 for Tier 2 High, 3 for Tier 2 Med, 4 for Tier 2 Low\n  patient_name: string;\n  patient_phone: string;\n  patient_id: string;\n  created_at: string;\n  status: string;\n  // Specific details\n  sos_data?: SOSEvent;\n  triage_data?: TriageRecord;\n  token_data?: OPDToken;\n}\n"
        path {
          absolute_uri: "file:///src/types/index.ts"
        }
        overwrite: true
      }
    }
