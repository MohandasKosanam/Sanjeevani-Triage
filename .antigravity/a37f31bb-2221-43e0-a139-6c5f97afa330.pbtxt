        target_content: "router.post(\'/chat\', async (req: Request, res: Response) => {\n  try {\n    const { messages, model = \'gemini-3.8-flash\', role = \'general\' } = req.body;\n\n    let systemInstruction = `You are Sanjeevani Health AI, an empathetic, multilingual medical assistant. Support Telugu, Hindi, and English.`;\n    if (role === \'specialist\') {\n      systemInstruction = `You are Sanjeevani Clinical Reasoning Specialist. You provide in-depth medical evaluations, discuss differential diagnoses, potential drug interactions, and explain lab/radiology findings with scientific rigor. Always clarify that physical examination by a licensed physician is essential.`;\n    } else if (role === \'fast_triage\') {\n      systemInstruction = `You are Sanjeevani Rapid Triage Bot. Deliver fast, concise health assessments (under 3 sentences), flag emergency red flags immediately, and give direct next steps.`;\n    }\n\n    const result = await chatWithGemini(messages, model, systemInstruction);\n    res.json({\n      success: true,\n      reply: result.reply,\n      modelUsed: result.modelUsed,\n    });\n  } catch (err: any) {\n    console.error(\'Chat endpoint error:\', err);\n    res.status(500).json({ success: false, error: err.message || \'Chat processing error\' });\n  }\n});\n"
        replacement_content: "router.post(\'/chat\', async (req: Request, res: Response) => {\n  try {\n    const { messages, model = \'gemini-3.8-flash\', role = \'general\', language = \'te\' } = req.body;\n\n    const langDirective =\n      language === \'te\'\n        ? \'The user prefers Telugu (\340\260\244\340\261\206\340\260\262\340\261\201\340\260\227\340\261\201). Reply in warm, natural Telugu script with respectful terms (\340\260\250\340\260\256\340\260\270\340\261\215\340\260\244\340\261\207, \340\260\246\340\260\257\340\260\232\340\261\207\340\260\270\340\260\277), though clinical drug names can stay in English or transliterated.\'\n        : language === \'hi\'\n        ? \'The user prefers Hindi (\340\244\271\340\244\277\340\244\202\340\244\246\340\245\200). Reply in warm, natural Hindi in Devanagari script with respectful terms (\340\244\250\340\244\256\340\244\270\340\245\215\340\244\244\340\245\207, \340\244\225\340\245\203\340\244\252\340\244\257\340\244\276), though clinical drug names can stay in English or transliterated.\'\n        : \'The user prefers English. Reply in clear, empathetic English.\';\n\n    let systemInstruction = `You are Sanjeevani Health AI, an empathetic, multilingual medical assistant. Support Telugu, Hindi, and English. ${langDirective}`;\n    if (role === \'specialist\') {\n      systemInstruction = `You are Sanjeevani Clinical Reasoning Specialist. You provide in-depth medical evaluations, discuss differential diagnoses, potential drug interactions, and explain lab/radiology findings with scientific rigor. Always clarify that physical examination by a licensed physician is essential. ${langDirective}`;\n    } else if (role === \'fast_triage\') {\n      systemInstruction = `You are Sanjeevani Rapid Triage Bot. Deliver fast, concise health assessments (under 3 sentences), flag emergency red flags immediately, and give direct next steps. ${langDirective}`;\n    }\n\n    const result = await chatWithGemini(messages, model, systemInstruction);\n    res.json({\n      success: true,\n      reply: result.reply,\n      modelUsed: result.modelUsed,\n    });\n  } catch (err: any) {\n    console.error(\'Chat endpoint error:\', err);\n    res.status(500).json({ success: false, error: err.message || \'Chat processing error\' });\n  }\n});\n"
        start_line: 121
        end_line: 137
      }
      use_global_match: true
    }
    description: "Pass language to chat system instructions for fluent Telugu, Hindi, English responses"
