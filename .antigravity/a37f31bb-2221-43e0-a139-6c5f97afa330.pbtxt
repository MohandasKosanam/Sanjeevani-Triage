              text: "        reply: `\340\260\250\340\260\256\340\260\270\340\261\215\340\260\225\340\260\276\340\260\260\340\260\202! \340\260\234\340\261\215\340\260\265\340\260\260\340\260\202 \340\260\227\340\261\201\340\260\260\340\260\277\340\260\202\340\260\232\340\260\277 \340\260\256\340\261\200\340\260\260\340\261\201 \340\260\205\340\260\241\340\260\277\340\260\227\340\260\277\340\260\250 \340\260\270\340\260\256\340\260\276\340\260\232\340\260\276\340\260\260\340\260\202:\\n\\n1. **\340\260\265\340\260\277\340\260\266\340\261\215\340\260\260\340\260\276\340\260\202\340\260\244\340\260\277 & \340\260\246\340\261\215\340\260\260\340\260\265\340\260\252\340\260\246\340\260\276\340\260\260\340\261\215\340\260\245\340\260\276\340\260\262\340\261\201:** \340\260\244\340\260\227\340\260\277\340\260\250\340\260\202\340\260\244 \340\260\265\340\260\277\340\260\266\340\261\215\340\260\260\340\260\276\340\260\202\340\260\244\340\260\277 \340\260\244\340\261\200\340\260\270\340\261\201\340\260\225\340\261\213\340\260\202\340\260\241\340\260\277, \340\260\252\340\261\201\340\260\267\340\261\215\340\260\225\340\260\262\340\260\202\340\260\227\340\260\276 \340\260\250\340\261\200\340\260\260\340\261\201, \340\260\225\340\261\212\340\260\254\340\261\215\340\260\254\340\260\260\340\260\277 \340\260\250\340\261\200\340\260\260\340\261\201 \340\260\262\340\261\207\340\260\246\340\260\276 ORS \340\260\246\340\261\215\340\260\260\340\260\276\340\260\265\340\260\243\340\260\202 \340\260\244\340\261\215\340\260\260\340\260\276\340\260\227\340\260\202\340\260\241\340\260\277.\\n2. **\340\260\211\340\260\267\340\261\215\340\260\243\340\261\213\340\260\227\340\261\215\340\260\260\340\260\244 \340\260\252\340\260\260\340\261\215\340\260\257\340\260\265\340\261\207\340\260\225\340\261\215\340\260\267\340\260\243:** \340\260\245\340\260\260\340\261\215\340\260\256\340\260\276\340\260\256\340\261\200\340\260\237\340\260\260\340\261\215\342\200\214\340\260\244\340\261\213 \340\260\252