    content: "import { Router, Request, Response } from \'express\';\nimport multer from \'multer\';\nimport { db } from \'./db\';\nimport { analyzeSymptoms, decodePrescription } from \'./gemini\';\nimport { allocateHospital, HOSPITAL_REGISTRY } from \'./hospitalEngine\';\nimport { Language, TriageRecord, DailyHealthInsight, PrescriptionRecord } from \'../types\';\n\nconst router = Router();\nconst upload = multer({\n  storage: multer.memoryStorage(),\n  limits: { fileSize: 20 * 1024 * 1024 }, // 20MB limit\n});\n\n// ----------------------------------------------------\n// Real-Time Server-Sent Events (SSE) Stream\n// ----------------------------------------------------\nrouter.get(\'/events\', (req: Request, res: Response) => {\n  res.writeHead(200, {\n    \'Content-Type\': \'text/event-stream\',\n    \'Cache-Control\': \'no-cache\',\n    Connection: \'keep-alive\',\n  });\n\n  res.write(`data: ${JSON.stringify({ type: \'connected\', timestamp: new Date().toISOString() })}\\n\\n`);\n\n  const unsubscribe = db.subscribe((event) => {\n    res.write(`data: ${JSON.stringify(event)}\\n\\n`);\n  });\n\n  req.on(\'close\', () => {"
