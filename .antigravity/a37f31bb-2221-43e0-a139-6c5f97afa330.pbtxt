256\340\245\207\340\244\202 2.5 \340\244\270\340\245\207\340\244\225\340\244\202\340\244\241 \340\244\225\340\244\276 SOS \340\244\254\340\244\237\340\244\250 \340\244\246\340\244\254\340\244\276 \340\244\270\340\244\225\340\244\244\340\245\207 \340\244\271\340\245\210\340\244\202\340\245\244 \340\244\225\340\245\215\340\244\257\340\244\276 \340\244\206\340\244\252 \340\244\207\340\244\270 \340\244\270\340\244\202\340\244\254\340\244\202\340\244\247 \340\244\256\340\245\207\340\244\202 \340\244\225\340\245\201\340\244\233 \340\244\224\340\244\260 \340\244\252\340\245\202\340\244\233\340\244\250\340\244\276 \340\244\232\340\244\276\340\244\271\340\244\244\340\245\207 \340\244\271\340\245\210\340\244\202?`,\\n      modelUsed: modelChoice,\\n    };\\n  }\\n\\n  // English fallback\\n  return {\\n    reply: `Hello! I have reviewed your health query: \\\"${messages[messages.length - 1]?.content || \'\'}\\\".\\\\n\\\\n1. **Immediate Guidance:** Stay well-hydrated, monitor your resting vital signs, and avoid strenuous activity.\\\\n2. **Clinical Verification:** For any persistent symptoms, generate a Digital OPD Token via our Voice Triage screen to be routed to the appropriate department.\\\\n3. **Emergency Red Flags:** If you experience acute chest discomfort, sudden shortness of breath, or fainting, activate the 2.5s Emergency SOS button immediately.`,\\n    modelUsed: modelChoice,\\n  };\\n}\\n\",\"StartLine\":25,\"TargetContent\":\"/**\\n * Multi-turn chat with Gemini supporting fast, general, and complex models.\\n */\\nexport async function chatWithGemini(\\n  messages: ChatMessageInput[],\\n  modelChoice: \'gemini-4-argon\' | \'gemini-3.8-flash\' | \'gemini-3.1-flash-lite\' = \'gemini-3.8-flash\',\\n  systemInstruction?: string\\n): Promise<{ reply: string; modelUsed: string }> {\\n  if (ai) {\\n    try {\\n      const contents = messages.map((m) => ({\\n        role: m.role,\\n        parts: [{ text: m.content }],\\n      }));\\n\\n      const sysInstruction =\\n        systemInstruction ||\\n        `You are Sanjeevani Healthcare Assistant, a knowledgeable, empathetic, multilingual medical guide.\\nYou communicate in Telugu, Hindi, or English based on user preference.\\nProvide clear, structured, compassionate health advice, explain clinical concepts simply, advise when physical consultation is required, and flag emergency warning signs immediately.`;\\n\\n      const response = await ai.models.generateContent({\\n        model: modelChoice,\\n        contents,\\n        config: {\\n          systemInstruction: sysInstruction,\\n        },\\n      });\\n\\n      return {\\n        reply:\\n          response.text ||\\n          \'I have reviewed your message. Please proceed with your doctor consultation if symptoms persist.\',\\n        modelUsed: modelChoice,\\n      };\\n    } catch (err: any) {\\n      console.warn(`Chat with ${modelChoice} failed, trying fallback:`, err);\\n      if (modelChoice !== \'gemini-3.8-flash\') {\\n        try {\\n          const contents = messages.map((m) => ({\\n            role: m.role,\\n            parts: [{ text: m.content }],\\n          }));\\n          const fallbackResp = await ai.models.generateContent({\\n            model: \'gemini-3.8-flash\',\\n            contents,\\n            config: {\\n              systemInstruction: systemInstruction || \'You are Sanjeevani Healthcare Assistant.\',\\n            },\\n          });\\n          return {\\n            reply: fallbackResp.text || \'How can I assist your health today?\',\\n            modelUsed: \'gemini-3.8-flash\',\\n          };\\n        } catch (e) {}\\n      }\\n    }\\n  }\\n\\n  const lastUserMsg = messages[messages.length - 1]?.content || \'\';\\n  return {\\n    reply: `Sanjeevani Assistant (${modelChoice}): Thank you for reaching out regarding \\\"${lastUserMsg}\\\". Please rest, monitor your vitals, and proceed to the OPD or emergency ward if warning signs appear.`,\\n    modelUsed: modelChoice,\\n  };\\n}\\n\",\"TargetFile\":\"/src/server/gemini.ts\",\"toolAction\":\"Updating chatWithGemini in gemini.ts\",\"toolSummary\":\"Add multilingual clinical responses in chatWithGemini\"}"
