            lines {
              text: "  // Concurrency-Safe OPD Token Generation"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  public generateToken("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    patientId: string,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    triageId: string,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    hospitalId: string,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
