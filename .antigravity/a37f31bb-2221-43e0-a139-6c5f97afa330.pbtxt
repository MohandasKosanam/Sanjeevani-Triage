      thinking_signature: "\022\242\006\n\237\006\001i\024}\023:N\331d\006\346\'\224\327SK\316\3301\324b\240\227\361\212\006\256\vh\256\027\t\232\210\351\2348+\336~\203\017\326\307\033@q\376je\311\340\314\321KM\020\n\023ZVP\257B\322T\244\234\220\315\255\2648\331\252\026\3625\202\364\276\376\251\212\241\246>B\322\372\356\345\016=5\326mi\224$b`6CR\367\030\265\237\332yVk5Z\332\272\375l\251E\325\235a\"\205^dt^\3020_\375\213\270JE\364\303nf\323\0038\230\030Av\343\017\217\211@O57\002\253\301\256\302\326|\215\211.\355\032\222\241&\363L\005\266\277\260\220\370\203 \326OR\275\272\374\034\341\203x\306\367\353\341\224EO2\336\251\362\270\305Ta\201r\217\"\2360\301\320s\360\207i\037\351-\370\301>m|\336B\205T\342\300wwOl\257\300@\320\262\033\224nKT\000\273\b\3076\323\275r\230\373T\334d\3711V5!~\262\024\267\253\220\301\225\355\032yy\3225g\003\020\317\305\253v\305\334\347\037PM\234}\336P\234WFk\230\004\301SxWN\203U\026c#\352\002W\262\r/\265\325\355\320\316_\255\036\221?\234U\330LmAT#\257:z\205w}\231\256h\016#\260\355\315\006;u|\270E\020Z\2246\bf\037\202h\371\211R8*\354\337\357\277\255\\\373\343_w\"]5\003\241\002\230\212\253\251GKJ`\344\267\200=\177`\212\237|\362\330\370^\333\333\332\001\273\320\334\342b\345\024\252\371a\206\231\204\362\316A\250\265\256\n#\224\322\255\030\ni\203\244\224/\\x\001\221NN\333\212{\240\224\031\211\354w{\264\024Upq7\037\210Mc\366\364\350%\020\323EZ\332\212!\246d\037\034$\251\3079\246x\306>\237\211\256\365bO\244\215\324\262\261\346\003}\317\370\334/\254^\257h)\207\356\243\233\025\373\334\370\376\222\375\005\b\320\2669\222\362\321\231\316e\333b\301\205\231\250\025c\340\023|uH\022\204\301\r*\254\036\212\027J;\037g\035\0170vxY\346\335G,A\255E\030\267\377lr\373F`\375z\324BZ\270\263\323\031]\264\362\222\036\333.]\241\200\223g)\023xv\324%d\0207\316\210?\207Z\177\262\275\346\231e*\226\306\324\333\361\256\273\317%G2w\226-\372\006A\3751\255\313\224d\342f\251\305H\031\207\"\245m\005\355\016@[\021E\346\206\272\003\324h\300\n\342\324\006/\306\377\205\224\027\212\f\256_\312\'m<\265\326\203-w0\2704\335oOD\344|\245\343\b~\223N\025\220 \277\322wnh\325\315\275\314\376\352\310\306\021\322\273g\022<\306L[\314\262\334\253\371\002\341\311\rN\246\004\222\255\001sA\364,Z\026\201cU\302U,\260\301T\266Z\370\247h\220\3472\336\034\340\375\017<t\273\253\302\325&V\272\370\255Z\200/\311\345/e\032\214\367"
