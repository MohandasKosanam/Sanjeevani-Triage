    replacement_infos {
      original_chunk {
        target_content: "/**\n * Multi-turn chat with Gemini supporting fast, general, and complex models.\n */\nexport async function chatWithGemini(\n  messages: ChatMessageInput[],\n  modelChoice: \'gemini-4-argon\' | \'gemini-3.8-flash\' | \'gemini-3.1-flash-lite\' = \'gemini-3.8-flash\',\n  systemInstruction?: string\n): Promise<{ reply: string; modelUsed: string }> {\n  if (ai) {\n    try {\n      const contents = messages.map((m) => ({\n        role: m.role,\n        parts: [{ text: m.content }],\n      }));\n\n      const sysInstruction =\n        systemInstruction ||\n        `You are Sanjeevani Healthcare Assistant, a knowledgeable, empathetic, multilingual medical guide.\nYou communicate in Telugu, Hindi, or English based on user preference.\nProvide clear, structured, compassionate health advice, explain clinical concepts simply, advise when physical consultation is required, and flag emergency warning signs immediately.`;\n\n      const response = await ai.models.generateContent({\n        model: modelChoice,\n        contents,\n        config: {\n          systemInstruction: sysInstruction,\n        },\n      });\n\n      return {\n        reply:\n          response.text ||\n          \'I have reviewed your message. Please proceed with your doctor consultation if symptoms persist.\',\n        modelUsed: modelChoice,\n      };\n    } catch (err: any) {\n      console.warn(`Chat with ${modelChoice} failed, trying fallback:`, err);\n      if (modelChoice !== \'gemini-3.8-flash\') {\n        try {\n          const contents = messages.map((m) => ({\n            role: m.role,\n            parts: [{ text: m.content }],\n          }));\n          const fallbackResp = await ai.models.generateContent({\n            model: \'gemini-3.8-flash\',\n            contents,\n            config: {\n              systemInstruction: systemInstruction || \'You are Sanjeevani Healthcare Assistant.\',\n            },\n          });\n          return {\n            reply: fallbackResp.text || \'How can I assist your health today?\',\n            modelUsed: \'gemini-3.8-flash\',\n          };\n        } catch (e) {}\n      }\n    }\n  }\n\n  const lastUserMsg = messages[messages.length - 1]?.content || \'\';\n  return {\n    reply: `Sanjeevani Assistant (${modelChoice}): Thank you for reaching out regarding \"${lastUserMsg}\". Please rest, monitor your vitals, and proceed to the OPD or emergency ward if warning signs appear.`,\n    modelUsed: modelChoice,\n  };\n}\n"
        replacement_content: "/**\n * Multi-turn chat with Gemini supporting fast, general, and complex models.\n */\nexport async function chatWithGemini(\n  messages: ChatMessageInput[],\n  modelChoice: \'gemini-4-argon\' | \'gemini-3.8-flash\' | \'gemini-3.1-flash-lite\' = \'gemini-3.8-flash\',\n  systemInstruction?: string,\n  language: string = \'te\'\n): Promise<{ reply: string; modelUsed: string }> {\n  if (ai) {\n    try {\n      const contents = messages.map((m) => ({\n        role: m.role,\n        parts: [{ text: m.content }],\n      }));\n\n      const sysInstruction =\n        systemInstruction ||\n        `You are Sanjeevani Healthcare Assistant, a knowledgeable, empathetic, multilingual medical guide.\nYou communicate natively in Telugu, Hindi, or English based on user preference (${language}).\nProvide clear, structured, compassionate health advice, explain clinical concepts simply, advise when physical consultation is required, and flag emergency warning signs immediately.`;\n\n      const response = await ai.models.generateContent({\n        model: modelChoice,\n        contents,\n        config: {\n          systemInstruction: sysInstruction,\n        },\n      });\n\n      if (response.text && response.text.trim().length > 0) {\n        return {\n          reply: response.text,\n          modelUsed: modelChoice,\n        };\n      }\n    } catch (err: any) {\n      console.warn(`Chat with ${modelChoice} failed, trying fallback:`, err);\n      if (modelChoice !== \'gemini-3.8-flash\') {\n        try {\n          const contents = messages.map((m) => ({\n            role: m.role,\n            parts: [{ text: m.content }],\n          }));\n          const fallbackResp = await ai.models.generateContent({\n            model: \'gemini-3.8-flash\',\n            contents,\n            config: {\n              systemInstruction: systemInstruction || \'You are Sanjeevani Healthcare Assistant.\',\n            },\n          });\n          if (fallbackResp.text && fallbackResp.text.trim().length > 0) {\n            return {\n              reply: fallbackResp.text,\n              modelUsed: \'gemini-3.8-flash\',\n            };\n          }\n        } catch (e) {}\n      }\n    }\n  }\n\n  // Clinical Multilingual Knowledge Fallback Engine\n  const lastUserMsg = (messages[messages.length - 1]?.content || \'\').toLowerCase();\n\n  // Detect language if not explicitly provided\n  const isTelugu = language === \'te\' || /[\\u0C00-\\u0C7F]/.test(lastUserMsg);\n  const isHindi = language === \'hi\' || /[\\u0900-\\u097F]/.test(lastUserMsg);\n\n  if (isTelugu) {\n    if (lastUserMsg.includes(\'\340\260\234\340\261\215\340\260\265\340\260\260\340\260\202\') || lastUserMsg.includes(\'fever\') || lastUserMsg.includes(\'\340\260\244\340\260\276\340\260\252\340\260\202\')) {\n      return {\n        reply: `\340\260\250\340\260\256\340\260\270\340\261\215\340\260\225\340\260\276\340\260\260\340\260\202! \340\260\234\340\261\215\340\260\265\340\260\260\340\260\202 \340\260\227\340\261\201\340\260\260\340\260\277\340\260\202\340\260\232\340\260\277 \340\260\256\340\261\200\340\260\260\340\261\201 \340\260\205\340\260\241\340\260\277\340\260\227\340\260\277\340\260\250 \340\260\270\340\260\256\340\260\276\340\260\232\340\260\276\340\260\260\340\260\202:\\n\\n1. **\340\260\265\340\260\277\340\260\266\340\261\215\340\260\260\340\260\276\340\260\202\340\260\244\340\260\277 & \340\260\246\340\261\215\340\260\260\340\260\265\340\260\252\340\260\246\340\260\276\340\260\260\340\261\215\340\260\245\340\260\276\340\260\262\340\261\201:** \340\260\244\340\260\227\340\260\277\340\260\250\340\260\202\340\260\244 \340\260\265\340\260\277\340\260\266\340\261\215\340\260\260\340\260\276\340\260\202\340\260\244\340\260\277 \340\260\244\340\261\200\340\260\270\340\261\201\340\260\225\340\261\213\340\260\202\340\260\241\340\260\277, \340\260\252\340\261\201\340\260\267\340\261\215\340\260\225\340\260\262\340\260\202\340\260\227\340\260\276 \340\260\250\340\261\200\340\260\260\340\261\201, \340\260\225\340\261\212\340\260\254\340\261\215\340\260\254\340\260\260\340\260\277 \340\260\250\340\261\200\340\260\260\340\261\201 \340\260\262\340\261\207\340\260\246\340\260\276 ORS \340\260\246\340\261\215\340\260\260\340\260\276\340\260\265\340\260\243\340\260\202 \340\260\244\340\261\215\340\260\260\340\260\276\340\260\227\340\260\202\340\260\241\340\260\277.\\n2. **\340\260\211\340\260\267\340\261\215\340\260\243\340\261\213\340\260\227\340\261\215\340\260\260\340\260\244 \340\260\252\340\260\260\340\261\215\340\260\257\340\260\265\340\261\207\340\260\225\340\261\215\340\260\267\340\260\243:** \340\260\245\340\260\260\340\261\215\340\260\256\340\260\276\340\260\256\340\261\200\340\260\237\340\260\260\340\261\215\342\200\214\340\260\244\340\261\213 \340\260\252\340\261\215\340\260\260\340\260\244\340\260\277 4 \340\260\227\340\260\202\340\260\237\340\260\262\340\260\225\340\261\201 \340\260\222\340\260\225\340\260\270\340\260\276\340\260\260\340\260\277 \340\260\260\340\261\200\340\260\241\340\260\277\340\260\202\340\260\227\340\261\215 \340\260\227\340\260\256\340\260\250\340\260\277\340\260\202\340\260\232\340\260\202\340\260\241\340\260\277.\\n3. **\340\260\256\340\260\202\340\260\246\340\261\201\340\260\262\340\261\201:** \340\260\270\340\260\276\340\260\247\340\260\276\340\260\260\340\260\243\340\260\202\340\260\227\340\260\276 \340\260\252\340\260\276\340\260\260\340\260\276\340\260\270\340\260\277\340\260\237\340\260\256\340\260\276\340\260\262\340\261\215 (Paracetamol 650mg) \340\260\206\340\260\271\340\260\276\340\260\260\340\260\202 \340\260\244\340\261\200\340\260\270\340\261\201\340\260\225\340\261\201\340\260\250\340\261\215\340\260\250 \340\260\244\340\260\260\340\261\215\340\260\265\340\260\276\340\260\244 \340\260\256\340\260\276\340\260\244\340\261\215\340\260\260\340\260\256\340\261\207 \340\260\265\340\261\207\340\260\270\340\261\201\340\260\225\340\261\213\340\260\265\340\260\276\340\260\262\340\260\277