      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport {\\n  Smartphone,\\n  Building2,\\n  Split,\\n  FolderTree,\\n  AlertOctagon,\\n  Activity,\\n  HeartPulse,\\n  Radio,\\n  ExternalLink\\n} from \'lucide-react\';\\nimport { MobileAppView } from \'./components/mobile/MobileAppView\';\\nimport { HospitalAdminView } from \'./components/admin/HospitalAdminView\';\\nimport { SplitView } from \'./components/SplitView\';\\nimport { MonorepoExplorer } from \'./components/MonorepoExplorer\';\\n\\ntype ActiveView = \'mobile\' | \'admin\' | \'split\' | \'monorepo\';\\n\\nexport function App() {\\n  const [activeView, setActiveView] = useState<ActiveView>(\'split\');\\n  const [refreshTrigger, setRefreshTrigger] = useState(0);\\n\\n  const triggerUpdate = () => {\\n    setRefreshTrigger((prev) => prev + 1);\\n  };\\n\\n  return (\\n    <div className=\\\"min-h-screen bg-slate-100 flex flex-col font-sans\\\">\\n      {/* Top Application Header */}\\n      <header className=\\\"sticky top-0 z-40 bg-slate-900 border-b border-slate-800 text-white shadow-md\\\">\\n        <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6 py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\">\\n          {/* Logo & Platform Info */}\\n          <div className=\\\"flex items-center gap-3\\\">\\n            <div className=\\\"w-10 h-10 rounded-2xl bg-teal-500 text-slate-950 flex items-center justify-center font-black text-xl shadow-md\\\">\\n              \340\244\270\340\244\202\\n            </div>\\n            <div>\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <span className=\\\"text-base font-black tracking-tight text-white\\\">Sanjeevani Triage</span>\\n                <span className=\\\"text-[10px] font-bold bg-teal-500/20 text-teal-300 border border-teal-500/30 px-2 py-0.5 rounded-full\\\">\\n                  AI Healthcare\\n                </span>\\n              </div>\\n              <p className=\\\"text-[11px] text-slate-400\\\">\\n                Multimodal AI Triage \342\200\242 Smart Rx Decoder \342\200\242 2.5s SOS \342\200\242 Hospital Allocation\\n              </p>\\n            </div>\\n          </div>\\n\\n          {/* Navigation View Switcher */}\\n          <div className=\\\"flex bg-slate-800 p-1 rounded-2xl border border-slate-700/80 self-start sm:self-center\\\">\\n            <button\\n              onClick={() => setActiveView(\'split\')}\\n              className={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold transition ${\\n                activeView === \'split\'\\n                  ? \'bg-teal-600 text-white shadow-sm\'\\n                  : \'text-slate-300 hover:text-white\'\\n              }`}\\n            >\\n              <Split className=\\\"w-3.5 h-3.5\\\" />\\n              <span>Dual-Screen</span>\\n            </button>\\n\\n            <button\\n              onClick={() => setActiveView(\'mobile\')}\\n              className={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold transition ${\\n                activeView === \'mobile\'\\n                  ? \'bg-teal-600 text-white shadow-sm\'\\n                  : \'text-slate-300 hover:text-white\'\\n              }`}\\n            >\\n              <Smartphone className=\\\"w-3.5 h-3.5\\\" />\\n              <span>Patient App</span>\\n            </button>\\n\\n            <button\\n              onClick={() => setActiveView(\'admin\')}\\n              className={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold transition ${\\n                activeView === \'admin\'\\n                  ? \'bg-teal-600 text-white shadow-sm\'\\n                  : \'text-slate-300 hover:text-white\'\\n              }`}\\n            >\\n              <Building2 className=\\\"w-3.5 h-3.5\\\" />\\n              <span>Admin Queue</span>\\n            </button>\\n\\n            <button\\n              onClick={() => setActiveView(\'monorepo\')}\\n              className={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold transition ${\\n                activeView === \'monorepo\'\\n                  ? \'bg-teal-600 text-white shadow-sm\'\\n                  : \'text-slate-300 hover:text-white\'\\n              }`}\\n            >\\n              <FolderTree className=\\\"w-3.5 h-3.5\\\" />\\n              <span>Monorepo & EAS</span>\\n            </button>\\n          </div>\\n        </div>\\n      </header>\\n\\n      {/* Main Content Area */}\\n      <main className=\\\"flex-1 p-2 sm:p-6 flex flex-col items-center\\\">\\n        {activeView === \'split\' && <SplitView onRefreshTrigger={triggerUpdate} />}\\n        {activeView === \'mobile\' && (\\n          <div className=\\\"w-full flex justify-center py-4\\\">\\n            <MobileAppView onSOSCreated={triggerUpdate} onTriageCreated={triggerUpdate} />\\n          </div>\\n        )}\\n        {activeView === \'admin\' && (\\n          <div className=\\\"w-full\\\">\\n            <HospitalAdminView />\\n          </div>\\n        )}\\n        {activeView === \'monorepo\' && <MonorepoExplorer />}\\n      </main>\\n\\n      {/* Bottom Architectural Verification Footer */}\\n      <footer className=\\\"bg-slate-900 border-t border-slate-800 text-slate-400 text-xs py-4 px-6 text-center\\\">\\n        <div className=\\\"max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2 text-[11px]\\\">\\n          <div>\\n            <span className=\\\"font-bold text-slate-300\\\">Sanjeevani Triage System</span> \342\200\242 Built with Google Gemini 3.8 Flash Multimodal AI, React Native Expo Architecture, Express Gateway & PostgreSQL Schema.\\n          </div>\\n          <div className=\\\"flex items-center gap-4 text-slate-400\\\">\\n            <span>Visakhapatnam Medical Hub</span>\\n            <span className=\\\"flex items-center gap-1 text-emerald-400\\\">\\n              <span className=\\\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\\\" />\\n              All Services Operational\\n            </span>\\n          </div>\\n        </div>\\n      </footer>\\n    </div>\\n  );\\n}\\n\\nexport default App;\\n\",\"Description\":\"Build main App container with top view switcher and dual-screen simulation mode\",\"Overwrite\":true,\"TargetFile\":\"/src/App.tsx\",\"toolAction\":\"Writing App.tsx\",\"toolSummary\":\"Main application entry component\"}"
      thinking_signature: "\022\371\005\n\366\005\001i\024}\023~\020\224\277^\233\256y\210_\335z\247y\001{\232u\037\375\004~ #\n\217j\317\325\021<\315\210Jlj\274t\200\200\326;\311p\242\302\032\261\315r\376[PB\020\bU\305\360\207\r\365q\237\321\213\253\233K\005\002r\316i\252F\223\277T\037h]\342\216\271\323\230\254\a\336\001\227\b\331\214\022\236\334!\345\2573N\370\b\325X\353wA1\312t\335\230\024}\320\366\244\230\265k\357Z\023o\331@w\373\261\225\310gc\210\033\2208\365\033\343\2511o\363R\332\277O\252\212\344>\225:sC\026w\235:*\321\024AV\301t\a\221Ug\312\260L\373\214\027aN\3568[\020}@\207\264\272\354w\366<\350\344\213!2\245\277\024\006w\345@\263\321\020\365\365\310\\\376\220fY\264q}qg\200}\275\217E\251\220\037<\312\246\260^;\342b\237R\356\315\bU\023\324\225n\336\352\224\364z\223B\313u\305m\344P\024\333V\344\305\250e7\f\355\v\016{@.K\361\236\320{\261\036\340\261\372\353\267\231\344\214\302m_\353\236\341\245\347\310\234\306\247\224i\307\364\245\027\252\315\036\256oHJ\3217i\v\266\302\257\324\n\260\aV\230\317\033\317\017\204\323H\036zm\000\246\230\017lx@EVH\254\217L\330\361\257\242\36597\333\363\300*\026\312\360\n\262a)\360\237Z\366\333bA\223w\334\032\002\020|U7\335{\314E\026\006-\310\245\336+\273\246\367\302\331\016X\366\245\245\301\316cz6\350)\002a\300\033M\272(8\202\027@\a\321\022\333$Y\207\320\nQa2\230\360;;\245)\2675\322\247\240~oi9\022m\r\202 p\362&\316\030\230n\bb\217\022U\363\323\326\2076<K\026~\212-=\v\213\v\310\343\215\006\372\006`:5\242\300\264n\341\205\275\220\216\301O\021\246\242\n\017iF\242\"\245\223\236\264\234|\274\267c\261\031\303\253\207\236\320\213\037l\376\\:\224\352\034\370%q\373\264\253\017\261a\avQEQS\246\366\327\242\024\330\361~\372\346{\312\336\262\321\301\n&\356\271\355\v\256f \262\202\312<\363\367\313\356~\253D\356o$OR\032q\177\272Z]\325\315\263\201>\324\257\fc\251}\276Hz\323>\236b=W*7(\365\325<\243gh@\323\200Y\225\022!f\316\273\312\352\243v\265\317]\rv\353:\314%\347\302|16\310\201\2606\226}\246Q\326\225\230M\217\263\261\004\001h;yX\306z \n\222\327&