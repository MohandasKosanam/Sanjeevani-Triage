      thinking_signature: "\022\345\t\n\342\t\001i\024}\023\265-\336\213\375\234\360\257R\323F\275\340\305\027\222)\241\031\332\301\310\262\351\311v\343r\347\210\361\002\333=\274\262uY\006M5\022\tr\262\230\276 \210\325{\254(\314\324\004P\355\207\365\266\306\247x\231\217\356\364oG\\\376\344^\306T\376\001\211\312\t\267N\250\206E*\324b\333\353\273%\356\r.\200w\024\230\311*\331\371xu?;\364\365\230\227*\334\321\312n]/\301\355\235\375\346\255\235\304\271j\221\251,=\245\353z\217W\305\231\270\243\236i\215\223\253\276\022\177;-P\246\b\235\272x\247\337\333P\032\301\twt\235D\225\244\342-\345mgF\362\340[{\335YK\325(i`\306\"\200\021\211\'\177\306\344z\377\242\202\303\030X-\256\232(Gv\320\207>z2@\345>\376\2328u\200\fn#\302D>\300\224\253D\027\217\027K;\357\2416/\023ml\305\360\367\001\252(\216\227\277\363\231\\e\346-\374J\353\302\232\av\343\317\247\030\357\361l]\032\274\360%p\004\371K\203\306\023\177q\240\177\326\310\203\342Fr\252P\256$\342\340nM\225z9\253\303\331\340\300Q\026a\376/\226\255\343O]\223q\020Kp\v\362R\0309Y\346\211\366\237\000\251<\350s\313\232\272xv*6\214\351\311\034r\342\377\312\331\363\037m\334D\360t~\231\375:\271\026\350\244\363\364=\235\354\252\241\211\032\226E\332P\263\253nV>\201o\347\346\202@\363H\020\276!\230W\312\375\372\276\252#t`\304\362q\353D\376\3562\353\t\367b\217\360\264\201\315\bJ\314\223\221\276\211Y\036\023\aYLr$\374F\346_\276]\205V{\020\220\352k\310\250\204\221|\003\b\035\340)\246\324\225e~N|\341a&m\f\267\"}\272\316\263\216\366\f\016r\204|\r\203\001\2517AL\bbX\003F\366v\036\222\"\242\201t\371\324\252\314r\247\227\'\216\311tk\3075\357\342\303`\313\314\341!\211k\275\262(\304\210Z\351n\231C\036\336\342\342\302\266s\276\311\334{zN\313\303\240\312l\237\345*@\307\361\a\327\372\366\020\004\375\320\340\300SHq\244E\f\350\231c\216\224\220Rs\f`\305\f\037\005\024\320\277P\204yr\227\255\313\271\255\240L\315\201\343\f\267%\332\363\t\2148\372\354m/\255ykU\033{\266Ou\343QH\336\362\211J9\222\244~\024\255\370\337ijr\356],\201\335=\320\261\vq\230\243\255\223\321K\242\223^/#\034\216\362\377\223XU\3300n\357\376\320\242\006\302\244\223\255\241n\331\276\314\307\316\177\201\370\3732q)A\270I\257\365\006\204)(\345\2343R\342\204\251\270T&\267\022^\241\332\240{\005\034\332\037\t\020\310\255\222\357\317\231=;\372\032:\224X5\v\217\365\324\275H\354P\313\362*\021a\2621\023/\222\273\2553R\247Od6\206\231b\021-\312\226\207k\201\b\277\301\246,\256\017<p\306?H\336\265\316>\031\375\\d\301kncD\'%0O:W\035\203\023\310\211VC\366\001\020\362\224\\\256\r\205\231*\215\333\030.\0305\257\207\243J\016\332\307\n\313T\372\265Xuh\301\363\233\261\231\004\212+\364H\251\364O\000\361\207\337\231\262\020\214&/\031\271\353\326\202\325\325\024p\241\247Q\r\370b\330\252\346\0334=\301\230\363;v\253,\225F\231!\2238>\300\365V\344W\b\026sif\341\355\216eI\237M\224m\255\'\203H\200\303\200\302\332\230\by\277|\312\0368\317\306,YSq\325\323<\241\256\204\a\201o\202\n=f*\270\326\326{J8\237\223r9\327[H\300\255\205\253\177\272<\335\301E\336\307\a\232:\261\241\210\370\027j\021c\225}F\334P\223\262\214\342\035\214\354\023\345\264\243)N\306\333\263\006\274P3\234P\314?\265\333\246\020\337\243}\226\370\347\301T\202v\334\205\263-\2575 q\036\350\2310pA\324\2105\253\337f\307Wj\231x\024x\350\307\273\210|\356\357X\033\024\035\337\221\367\236v[\356b{\243\017e\031\222\213\375\352\207\006\367CI\0308)\032\351f\177\210ff:\032\253\344\342yjW\216\240gI\020\355\027w\347B\313O\267\\\036\275\341s\267\000\234/\245\202w|1\033\343\235\372\302\t6{\313\216\232\016Q\306\371K\243\214\177x\242Om\250\220\302\207&\342zl\231C\023\224A\345\002\216\\6\002ZYD\256Y\017I\322:\024\264\203(86\322\243O\342\246m\244\324\031\221\247#\230\301\274\252\024\201&\223\311\220J\256\027\271\220\004"
