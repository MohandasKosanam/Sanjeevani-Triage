          target_content: "import React from \'react\';\nimport { Activity, Moon, Heart, CloudSun, Info } from \'lucide-react\';\nimport { DailyHealthInsight } from \'../../types\';\n\ninterface Props {\n  insight: DailyHealthInsight | null;\n}\n\nexport const DailyHealthInsightCard: React.FC<Props> = ({ insight }) => {\n  if (!insight) return null;\n\n  return (\n    <div className=\"bg-gradient-to-br from-teal-900/10 via-slate-900/5 to-teal-800/10 border border-teal-500/20 rounded-2xl p-4 shadow-sm\">\n      <div className=\"flex items-center justify-between mb-3\">\n        <div className=\"flex items-center gap-2\">\n          <div className=\"w-7 h-7 rounded-lg bg-teal-600/20 text-teal-600 flex items-center justify-center\">\n            <Activity className=\"w-4 h-4 text-teal-600\" />\n          </div>\n          <div>\n            <h3 className=\"text-xs font-bold text-slate-800 tracking-wide uppercase\">Daily Health Insight</h3>\n            <p className=\"text-[10px] text-slate-500 flex items-center gap-1\">\n              <CloudSun className=\"w-3 h-3 text-amber-500\" /> {insight.context.weather} \342\200\242 {insight.context.location}\n            </p>\n          </div>\n        </div>\n        <span className=\"text-[9px] font-semibold tracking-wider text-slate-400 border border-slate-200 px-2 py-0.5 rounded-full bg-slate-50\">\n          Simulated Health Connect\n        </span>\n      </div>\n\n      <div className=\"grid grid-cols-3 gap-2 mb-3\">\n        <div className=\"bg-white/80 border border-slate-100 rounded-xl p-2.5 text-center\">\n          <div className=\"text-[10px] text-slate-500 font-medium\">Steps</div>\n          <div className=\"text-base font-bold text-slate-900 mt-0.5\">\n            {insight.metrics.steps.toLocaleString()}\n          </div>\n          <div className=\"text-[9px] text-teal-600 font-semibold\">Goal: 8,000</div>\n        </div>\n\n        <div className=\"bg-white/80 border border-slate-100 rounded-xl p-2.5 text-center\">\n          <div className=\"text-[10px] text-slate-500 font-medium flex items-center justify-center gap-1\">\n            <Moon className=\"w-2.5 h-2.5 text-indigo-500\" /> Sleep\n          </div>\n          <div className=\"text-base font-bold text-slate-900 mt-0.5\">\n            {insight.metrics.sleep_duration_hours} <span className=\"text-xs font-normal\">hrs</span>\n          </div>\n          <div className=\"text-[9px] text-amber-600 font-semibold\">Low (-2.3h)</div>\n        </div>\n\n        <div className=\"bg-white/80 border border-slate-100 rounded-xl p-2.5 text-center\">\n          <div className=\"text-[10px] text-slate-500 font-medium flex items-center justify-center gap-1\">\n            <Heart className=\"w-2.5 h-2.5 text-rose-500\" /> Avg HR\n          </div>\n          <div className=\"text-base font-bold text-slate-900 mt-0.5\">\n            {insight.metrics.avg_hr_bpm} <span className=\"text-xs font-normal\">bpm</span>\n          </div>\n          <div className=\"text-[9px] text-emerald-600 font-semibold\">Resting: Normal</div>\n        </div>\n      </div>\n\n      <div className=\"flex items-start gap-2 bg-teal-50/70 border border-teal-100 rounded-xl p-2.5 text-xs text-slate-700 leading-relaxed\">\n        <Info className=\"w-4 h-4 text-teal-600 shrink-0 mt-0.5\" />\n        <p className=\"text-[11px]\">{insight.observation}</p>\n      </div>\n    </div>\n  );\n};\n"
          replacement_content: "import React from \'react\';\nimport { Activity, Moon, Heart, CloudSun, Info } from \'lucide-react\';\nimport { DailyHealthInsight } from \'../../types\';\nimport { useLanguage } from \'../../context/LanguageContext\';\n\ninterface Props {\n  insight: DailyHealthInsight | null;\n}\n\nexport const DailyHealthInsightCard: React.FC<Props> = ({ insight }) => {\n  const { language, t } = useLanguage();\n  if (!insight) return null;\n\n  return (\n    <div className=\"bg-gradient-to-br from-teal-900/10 via-slate-900/5 to-teal-800/10 border border-teal-500/20 rounded-2xl p-3.5 shadow-xs\">\n      <div className=\"flex items-center justify-between mb-2.5\">\n        <div className=\"flex items-center gap-2\">\n          <div className=\"w-6 h-6 rounded-lg bg-teal-600/20 text-teal-600 flex items-center justify-center\">\n            <Activity className=\"w-3.5 h-3.5 text-teal-600\" />\n          </div>\n          <div>\n            <h3 className=\"text-[11px] font-bold text-slate-800 tracking-wide uppercase\">{t.dailyHealthInsight}</h3>\n            <p className=\"text-[9px] text-slate-500 flex items-center gap-1\">\n              <CloudSun className=\"w-2.5 h-2.5 text-amber-500\" /> {insight.context.weather} \342\200\242 {insight.context.location}\n            </p>\n          </div>\n        </div>\n        <span className=\"text-[8px] font-semibold tracking-wider text-slate-400 border border-slate-200 px-1.5 py-0.5 rounded-full bg-slate-50\">\n          {t.simulatedHealthConnect}\n        </span>\n      </div>\n\n      <div className=\"grid grid-cols-3 gap-2 mb-2.5\">\n        <div className=\"bg-white/80 border border-slate-100 rounded-xl p-2 text-center\">\n          <div className=\"text-[9px] text-slate-500 font-medium\">{t.steps}</div>\n          <div className=\"text-sm font-bold text-slate-900 mt-0.5\">\n            {insight.metrics.steps.toLocaleString()}\n          </div>\n          <div className=\"text-[8px] text-teal-600 font-semibold\">{t.stepsGoal}</div>\n        </div>\n\n        <div className=\"bg-white/80 border border-slate-100 rounded-xl p-2 text-center\">\n          <div className=\"text-[9px] text-slate-500 font-medium flex items-center justify-center gap-0.5\">\n            <Moon className=\"w-2.5 h-2.5 text-indigo-500\" /> {t.sleep}\n          </div>\n          <div className=\"text-sm font-bold text-slate-900 mt-0.5\">\n            {insight.metrics.sleep_duration_hours} <span className=\"text-[10px] font-normal\">hrs</span>\n          </div>\n          <div className=\"text-[8px] text-amber-600 font-semibold\">{t.sleepLow}</div>\n        </div>\n\n        <div className=\"bg-white/80 border border-slate-100 rounded-xl p-2 text-center\">\n          <div className=\"text-[9px] text-slate-500 font-medium flex items-center justify-center gap-0.5\">\n            <Heart className=\"w-2.5 h-2.5 text-rose-500\" /> {t.avgHeartRate}\n          </div>\n          <div className=\"text-sm font-bold text-slate-900 mt-0.5\">\n            {insight.metrics.avg_hr_bpm} <span className=\"text-[10px] font-normal\">bpm</span>\n          </div>\n          <div className=\"text-[8px] text-emerald-600 font-semibold\">{t.restingNormal}</div>\n        </div>\n      </div>\n\n      <div className=\"flex items-start gap-1.5 bg-teal-50/80 border border-teal-100 rounded-xl p-2 text-xs text-slate-700 leading-relaxed\">\n        <Info className=\"w-3.5 h-3.5 text-teal-600 shrink-0 mt-0.5\" />\n        <p className=\"text-[10px]\">\n          {language === \'en\' ? insight.observation : t.insightTip}\n        </p>\n      </div>\n    </div>\n  );\n};\n"
          start_line: 1
          end_line: 68
        }
      }
    }
