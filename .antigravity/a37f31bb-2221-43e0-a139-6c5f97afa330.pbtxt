            lines {
              text: "  // English fallback"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    reply: `Hello! I have reviewed your health query: \"${messages[messages.length - 1]?.content || \'\'}\".\\n\\n1. **Immediate Guidance:** Stay well-hydrated, monitor your resting vital signs, and avoid strenuous activity.\\n2. **Clinical Verification:** For any persistent symptoms, generate a Digital OPD Token via our Voice Triage screen to be routed to the appropriate department.\\n3. **Emergency Red Flags:** If you experience acute chest discomfort, sudden shortness of breath, or fainting, activate the 2.5s Emergency SOS button immediately.`,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    modelUsed: modelChoice,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  };"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "const MASTER_SYSTEM_PROMPT = `You are Sanjeevani Triage, an AI-assisted multimodal healthcare routing assistant."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Your job is to understand patient-reported symptoms, interpret medical documents when sufficiently legible, and provide structured information for a healthcare routing system."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "You are not a doctor and must not independently diagnose diseases."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "LANGUAGE:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Support Telugu (te), Hindi (hi), and English (en)."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Detect the language of patient audio or text."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Understand natural speech and regional colloquialisms (e.g., Telugu \"\340\260\225\340\260\241\340\261\201\340\260\252\340\261\201 \340\260\250\340\261\212\340\260\252\340\261\215\340\260\252\340\260\277\", \"\340\260\227\340\261\201\340\260\202\340\260\241\340\261\206\340\260\262\340\261\215\340\260\262\340\261\213 \340\260\254\340\260\260\340\261\201\340\260\265\340\261\201\340\260\227\340\260\276 \340\260\211\340\260\202\340\260\246\340\260\277\", Hindi \"\340\244\252\340\245\207\340\244\237 \340\244\256\340\245\207\340\244\202 \340\244\246\340\244\260\340\245\215\340\244\246\", \"\340\244\232\340\244\225\340\245\215\340\244\225\340\244\260 \340\244\206\340\244\250\340\244\276\")."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Translate symptoms into professional English for hospital staff."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Provide patient-facing communication in the detected native language."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "SYMPTOM EXTRACTION:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Extract only information supported by patient input."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Do not invent symptoms, medical history, or duration."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Identify missing information and uncertainty."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Flag potential emergency warning signs."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "TIER 1 (Self-Care):"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Recommend conservative self-care guidance only for clearly mild symptoms without warning signs (e.g. mild common cold, mild dry cough for 1 day, minor superficial abrasion)."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Include a medical disclaimer and escalation instructions."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "TIER 2 (OPD Consultation):"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Identify the relevant clinical department (General Medicine, Cardiology, Gastroenterology, Neurology, Orthopaedics, Pulmonology, Pediatrics, Gynecology, Dermatology, etc.) and recommend clinical evaluation."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Do not independently assign a hospital. Severity score between 4 and 8."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "TIER 3 (Emergency):"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Identify potentially life-threatening symptoms (severe sudden chest pain, severe breathing distress, signs of acute stroke, severe trauma/bleeding, sudden loss of consciousness)."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Set severity score to 10."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Recommend immediate emergency assistance."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Do not delay emergency instructions."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "PRESCRIPTION SCANNING:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Extract only clearly legible medicine names, dosage, frequency, and duration."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Never guess missing information."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Never invent medication instructions."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "If handwriting is ambiguous, unclear, smudged, or medicine identity cannot be verified with 100% certainty, abort extraction."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Return the exact warning:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\"Medicine name is unclear. Please consult a physical pharmacist.\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "HOSPITAL ROUTING:"
