      thinking_signature: "\022\266\017\n\263\017\001i\024}\023\362i\006\210\234\323\315\216\250\313\266E?\360|O\031o\bVL\344\375\273!\273\324\355o\207\n\200*a.\370\220}\224\'\200\vq\017>k\224\036a\337\033S\302\251Q\033\307J\230\240|\325\025[\024M\031\035\034\t^\210\363\273a\344\311mt\236\377Y\203P\027\371j\270\203\367+tq\271E<i\347\r\v\ras\202m|\347\336[Qz\236\034\261\006]\224\177\355\326\361r\301\304\341\267\314\\\346\207\314\024N\000\311\210f\314\264\252\235QZ\031\233\\\361g\2000\\\207\207\320\342\"6\314\'\323?\332\214\251\375\215#\274),^\316\a\347`?!\355\247L\266\272\301\353\020\352Ah]\242\334\3312@QC-\026j`ZG7\034\t\271\263\256#\270c{p\r)\004+\347\210\326\177\300u\270\030\325\242L\201x\261\262\315Z\262\313\002\350-~\316*\212 \373\227{[\246cBx\024P\254>Xa?9{\240c\272bq^\356K\345\2755;k\222 &\220.kV\346|\372q\346\037\\\217%D\347d\340c\b\324O\370\324\0018\253^A\235\327\2078/a\323\354\313\031\207\273\256Q\344PI\233u\273\222O\001\232\206H\200%\252\027m\362y\a&a\276F\017\264\310Y6\212Q\264\377`\232w\3364\324\314\253\261\223\350\206(6\237\277\304Fz+>\314\fg\340\340\032u\216ZD2\327r\315\220\0067a\252\303\372\375Vm\301\302?\300w\354\260t\344\324V\177e\243oyt\347f\000\340\016\257\211F\351i$\334Go\333\2235\016<\3175\354\035f\211\222N\332\246\215\020\377B!\373gY\256`\a\340\304\306:\315h\321b\030\001\222\0357\3714\365\233\265\266\271PC\312*\004\326\345$f\242S\2648\331\243\360\220\005\307\210~\035\025\272j\305\252\203=\233\203\315\304\305\345\300\032o\006\237d\213\030\027\253\221D\357\031\307\271x\377\030\"\216\'\300w\355\301\361z\b\002~\246W\232\227|\017U\277Aa\2034\253\353\323v\243\315\372\340\253\265\226\355\214\213\221K\002\2215fBF9\2604\2738\325>#\t\215U\251f\341X\215\376\027\357|=*\020<\276c\217\224\205\361\257\333\a\005W*\2028\313\211(\022\326\250\242\305<*q\3540\342\024\344(\361\221x\204\300c\257\355\222\343\265v7\277\354\367p\316\321?\355\'\f\t\005(Ka\247\312\251\037\334\000\247\371E\314{\202\207X\317\221\312\340\b\374\366\200F\346\256\023\177-\362x`\210M\307x\241\2